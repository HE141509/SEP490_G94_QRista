@page
@model QRB.Pages.KhoSanPham.KhoSanPhamListModel
@{
    ViewData["Title"] = "Danh sách kho sản phẩm";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/userlist.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    @await Html.PartialAsync("~/Pages/Shared/_Header.cshtml", Model)
    <div class="main-container">
        @await Html.PartialAsync("~/Pages/Shared/_Sidebar.cshtml", Model)
        <main class="main-content">
            <div class="dashboard-header userlist-header-flex">
                <h1 class="page-title">Danh sách kho sản phẩm</h1>
                <button class="userlist-add-btn" type="button" id="showAddKhoSanPhamBtn">
                    <i class="fas fa-plus"></i> Thêm mới
                </button>
            </div>
            <div class="userlist-card userlist-modern">
                <div class="userlist-toolbar">
                    <div class="userlist-toolbar-left">
                        <label for="filterKhoSanPhamStatus">Trạng thái:</label>
                        <select id="filterKhoSanPhamStatus" class="userlist-filter" onchange="filterKhoSanPhamByStatus()">
                            <option value="active">Đang hoạt động</option>
                            <option value="inactive">Đã xóa</option>
                        </select>
                    </div>
                    <div class="userlist-toolbar-right">
                        <label for="khoSanPhamPageSize" style="font-size:15px;margin-right:8px;color:#555;">Hiển thị:</label>
                        <select id="khoSanPhamPageSize" class="userlist-filter" style="width:auto;min-width:60px;" onchange="changeKhoSanPhamPageSize()">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <input type="text" class="userlist-search" placeholder="Tìm kiếm..." onkeyup="filterKhoSanPhamList()" style="margin-left:12px;" />
                    </div>
                </div>
                <table class="userlist-table userlist-table-modern" id="khoSanPhamListTable">
                    <thead>
                        <tr>
                            <th>Nguyên liệu</th>
                            <th>Số lượng còn lại</th>
                            <th>Chi nhánh</th>
                            <th>Ngày tạo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.KhoSanPhamList != null && Model.KhoSanPhamList.Any())
                        {
                            foreach (var item in Model.KhoSanPhamList)
                            {
                                <tr>
                                    <td>@item.TenNguyenLieu</td>
                                    <td>@item.SoLuongConLai</td>
                                    <td>@item.TenChiNhanh</td>
                                    <td>@item.CreateTime.ToString("dd/MM/yyyy")</td>
                                    <td>
@if (!item.IsDelete)
{
    <button class="userlist-action-btn" title="Sửa" onclick="showEditKhoSanPhamModal('@item.ID', '@item.IDNguyenLieu', '@item.SoLuongConLai', '@item.IDChiNhanh')" style="color:#4285f4;background:none;border:none;padding:0;">
        <i class="fas fa-edit"></i>
    </button>
    <button class="userlist-action-btn" title="Xóa" onclick="showDeleteKhoSanPhamConfirm('@item.ID')" style="color:#ea4335;background:none;border:none;padding:0;">
        <i class="fas fa-trash"></i>
    </button>
}
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="text-align:center;">Không có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="userlist-pagination" id="khosanpham-pagination"></div>
        <script>
            window.khoSanPhamListData = [
            @foreach (var item in Model.KhoSanPhamList)
            {
                <text>{
                    ID: '@item.ID',
                    TenNguyenLieu: '@item.TenNguyenLieu',
                    SoLuongConLai: '@item.SoLuongConLai',
                    TenChiNhanh: '@item.TenChiNhanh',
                    CreateTime: '@item.CreateTime.ToString("dd/MM/yyyy")',
                    IsDelete: @item.IsDelete.ToString().ToLower(),
                    IDNguyenLieu: '@item.IDNguyenLieu',
                    IDChiNhanh: '@item.IDChiNhanh'
                },</text>
            }
            ];
        </script>
        <script src="/js/khosanpham.js"></script>
        <script>
// Phân trang cho KhoSanPhamList
let khoSanPhamData = [];
let khoSanPhamPageSize = 10;
let khoSanPhamPageIndex = 1;

function renderKhoSanPhamTable() {
    const tbody = document.querySelector('#khoSanPhamListTable tbody');
    tbody.innerHTML = '';
    const start = (khoSanPhamPageIndex - 1) * khoSanPhamPageSize;
    const end = start + khoSanPhamPageSize;
    const pageData = khoSanPhamData.slice(start, end);
    if (pageData.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;">Không có dữ liệu</td></tr>`;
        return;
    }
    for (const item of pageData) {
        tbody.innerHTML += `<tr>
            <td>${item.TenNguyenLieu}</td>
            <td>${item.SoLuongConLai}</td>
            <td>${item.TenChiNhanh}</td>
            <td>${item.CreateTime}</td>
            <td>
                ${!item.IsDelete ? `<button class='userlist-action-btn' title='Sửa' onclick="showEditKhoSanPhamModal('${item.ID}', '${item.IDNguyenLieu}', '${item.SoLuongConLai}', '${item.IDChiNhanh}')" style='color:#4285f4;background:none;border:none;padding:0;'><i class='fas fa-edit'></i></button>
                <button class='userlist-action-btn' title='Xóa' onclick="showDeleteKhoSanPhamConfirm('${item.ID}')" style='color:#ea4335;background:none;border:none;padding:0;'><i class='fas fa-trash'></i></button>` : ''}
            </td>
        </tr>`;
    }
    renderKhoSanPhamPagination();
}

function renderKhoSanPhamPagination() {
    const total = khoSanPhamData.length;
    const pageCount = Math.ceil(total / khoSanPhamPageSize);
    const container = document.getElementById('khosanpham-pagination');
    container.innerHTML = '';
    if (pageCount <= 1) return;
    for (let i = 1; i <= pageCount; i++) {
        const btn = document.createElement('button');
        btn.textContent = i;
        btn.className = 'pagination-btn' + (i === khoSanPhamPageIndex ? ' active' : '');
        btn.onclick = () => {
            khoSanPhamPageIndex = i;
            renderKhoSanPhamTable();
        };
        container.appendChild(btn);
    }
}

function changeKhoSanPhamPageSize() {
    const select = document.getElementById('khoSanPhamPageSize');
    khoSanPhamPageSize = parseInt(select.value);
    khoSanPhamPageIndex = 1;
    renderKhoSanPhamTable();
}

function filterKhoSanPhamList() {
    // Có thể bổ sung tìm kiếm nâng cao ở đây
    renderKhoSanPhamTable();
}

document.addEventListener('DOMContentLoaded', function () {
    // Lấy dữ liệu từ biến ẩn hoặc ajax, ở đây demo lấy từ biến toàn cục
    if (window.khoSanPhamListData) {
        khoSanPhamData = window.khoSanPhamListData;
    }
    renderKhoSanPhamTable();
    document.getElementById('khoSanPhamPageSize').addEventListener('change', changeKhoSanPhamPageSize);
});
        </script>
            </div>
        </main>
    </div>
    <!-- Modal thêm mới và sửa sẽ bổ sung sau -->
</body>
</html>
