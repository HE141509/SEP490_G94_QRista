@page
@model QRB.Pages.NguyenLieu.NguyenLieuListModel
@{
    ViewData["Title"] = "Danh sách nguyên liệu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/userlist.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>

<body>
    @await Html.PartialAsync("~/Pages/Shared/_Header.cshtml", Model)
    <div class="main-container">
        @await Html.PartialAsync("~/Pages/Shared/_Sidebar.cshtml", Model)
        <main class="main-content">
            <div class="dashboard-header userlist-header-flex">
                <h1 class="page-title">Danh sách nguyên liệu</h1>
                <button class="userlist-add-btn" type="button" id="showAddNguyenLieuBtn">
                    <i class="fas fa-plus"></i> Thêm mới
                </button>
            </div>
            <div class="userlist-card userlist-modern">
                <div class="userlist-toolbar">
                    <div class="userlist-toolbar-left">
                        <label for="filterNguyenLieuStatus">Trạng thái:</label>
                        <select id="filterNguyenLieuStatus" class="userlist-filter" onchange="filterNguyenLieuByStatus()">
                            <option value="active">Đang hoạt động</option>
                            <option value="inactive">Đã xóa</option>
                        </select>
                    </div>
                    <div class="userlist-toolbar-right">
                        <label for="nguyenLieuPageSize" style="font-size:15px;margin-right:8px;color:#555;">Hiển thị:</label>
                        <select id="nguyenLieuPageSize" class="userlist-filter" style="width:auto;min-width:60px;" onchange="changeNguyenLieuPageSize()">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <input type="text" class="userlist-search" placeholder="Tìm kiếm..." onkeyup="filterNguyenLieuList()" style="margin-left:12px;" />
                    </div>
                </div>
                <table class="userlist-table userlist-table-modern" id="nguyenLieuListTable">
                    <thead>
                        <tr>
                            <th>Tên nguyên liệu</th>
                            <th>Mã nguyên liệu</th>
                            <th>Đơn vị tính</th>
                            <th>Ngày tạo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.NguyenLieuList != null && Model.NguyenLieuList.Any())
                        {
                            foreach (var item in Model.NguyenLieuList)
                            {
                                <tr>
                                    <td>
                                        <span style="cursor:pointer;color:#4285f4;text-decoration:underline;" onclick="showEditNguyenLieuModal('@item.ID', '@item.TenNguyenLieu', '@item.MaNguyenLieu', '@item.DonViTinh')">
                                            @item.TenNguyenLieu
                                        </span>
                                    </td>
                                    <td>@item.MaNguyenLieu</td>
                                    <td>@item.DonViTinh</td>
                                    <td>@item.CreateTime.ToString("dd/MM/yyyy")</td>
                                    <td>
@if (!item.IsDelete)
{
    <button class="userlist-action-btn" title="Xóa" onclick="showDeleteNguyenLieuConfirm('@item.ID')" style="color:#ea4335;background:none;border:none;padding:0;">
        <i class="fas fa-trash"></i>
    </button>
}
    <div id="deleteNguyenLieuModal" class="modal" style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
        <div class="modal-content" style="background:#fff;padding:32px 28px 24px 28px;border-radius:12px;box-shadow:0 2px 16px rgba(0,0,0,0.12);min-width:320px;max-width:90vw;text-align:center;">
            <form id="deleteNguyenLieuForm" method="post" action="/NguyenLieu/DeleteNguyenLieu">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteNguyenLieuId" name="NguyenLieuId" />
                <div style="font-size:20px;font-weight:600;color:#ea4335;margin-bottom:18px;"><i class="fas fa-exclamation-triangle"></i> Xác nhận xóa nguyên liệu</div>
                <div style="font-size:16px;color:#333;margin-bottom:24px;">Bạn có chắc chắn muốn xóa nguyên liệu này không?</div>
                <div style="display:flex;justify-content:center;gap:18px;">
                    <button type="submit" style="background:#ea4335;color:#fff;border:none;padding:8px 22px;border-radius:6px;font-size:15px;font-weight:500;cursor:pointer;">Xác nhận</button>
                    <button type="button" onclick="closeDeleteNguyenLieuModal()" style="background:#f5f7fa;color:#333;border:none;padding:8px 22px;border-radius:6px;font-size:15px;font-weight:500;cursor:pointer;">Hủy</button>
                </div>
            </form>
        </div>
    </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="text-align:center;">Không có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="userlist-pagination" id="nguyenlieu-pagination">
                    <button onclick="prevPage()" class="pagination-btn">&laquo; Trước</button>
                    <span id="currentPage">1</span>
                    <button onclick="nextPage()" class="pagination-btn">Tiếp &raquo;</button>
                </div>
            </div>
        </main>
    </div>
    <div id="addNguyenLieuModal" class="modal" style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
        <div class="modal-content userlist-add-modal-content">
            <div class="userlist-add-modal-title"><i class="fas fa-leaf"></i> Thêm nguyên liệu mới</div>
            <form id="addNguyenLieuForm" method="post" action="/NguyenLieu/AddNguyenLieu" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="userlist-add-form-group">
                    <label for="addTenNguyenLieu">Tên nguyên liệu</label>
                    <input type="text" id="addTenNguyenLieu" name="TenNguyenLieu" class="userlist-input" required maxlength="100" />
                </div>
                <div class="userlist-add-form-group">
                    <label for="addMaNguyenLieu">Mã nguyên liệu</label>
                    <input type="text" id="addMaNguyenLieu" name="MaNguyenLieu" class="userlist-input" required maxlength="50" />
                </div>
                <div class="userlist-add-form-group">
                    <label for="addDonViTinh">Đơn vị tính</label>
                    <input type="text" id="addDonViTinh" name="DonViTinh" class="userlist-input" required maxlength="50" />
                </div>
                <div class="userlist-add-modal-actions">
                    <button type="button" onclick="closeAddNguyenLieuModal()" class="userlist-add-cancel-btn">Hủy</button>
                    <button type="submit" class="userlist-add-submit-btn">Thêm mới</button>
                </div>
            </form>
        </div>
    </div>
    <div id="editNguyenLieuModal" class="modal" style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
        <div class="modal-content userlist-add-modal-content">
            <div class="userlist-add-modal-title"><i class="fas fa-leaf"></i> Sửa nguyên liệu</div>
            <form id="editNguyenLieuForm" method="post" action="/NguyenLieu/UpdateNguyenLieu" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editNguyenLieuId" name="ID" />
                <div class="userlist-add-form-group">
                    <label for="editTenNguyenLieu">Tên nguyên liệu</label>
                    <input type="text" id="editTenNguyenLieu" name="TenNguyenLieu" class="userlist-input" required maxlength="100" />
                </div>
                <div class="userlist-add-form-group">
                    <label for="editMaNguyenLieu">Mã nguyên liệu</label>
                    <input type="text" id="editMaNguyenLieu" name="MaNguyenLieu" class="userlist-input" required maxlength="50" />
                </div>
                <div class="userlist-add-form-group">
                    <label for="editDonViTinh">Đơn vị tính</label>
                    <input type="text" id="editDonViTinh" name="DonViTinh" class="userlist-input" required maxlength="50" />
                </div>
                <div class="userlist-add-modal-actions">
                    <button type="button" onclick="closeEditNguyenLieuModal()" class="userlist-add-cancel-btn">Hủy</button>
                    <button type="submit" class="userlist-add-submit-btn">Lưu</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let nguyenLieuCurrentPage = 1;
        let nguyenLieuPageSize = 10;
        let nguyenLieuCurrentFilter = 'active';
        let nguyenLieuCurrentSearch = '';

        function getAllNguyenLieuRows() {
            return Array.from(document.querySelectorAll('#nguyenLieuListTable tbody tr')).filter(function(row) {
                return row.querySelectorAll('td').length > 1;
            });
        }
        function getFilteredNguyenLieuRows() {
            let rows = getAllNguyenLieuRows();
            rows = rows.filter(function(row) {
                var statusCell = row.querySelector('.nguyenlieu-status');
                var isActive = true;
                if (statusCell) {
                    isActive = (statusCell.textContent.trim() === 'Hoạt động');
                }
                if (nguyenLieuCurrentFilter === 'active') return isActive;
                if (nguyenLieuCurrentFilter === 'inactive') return !isActive;
            });
            if (nguyenLieuCurrentSearch) {
                rows = rows.filter(function(row) {
                    var name = row.querySelector('td:nth-child(2) span')?.textContent.toLowerCase() || '';
                    return name.includes(nguyenLieuCurrentSearch);
                });
            }
            return rows;
        }
        function renderNguyenLieuPagination() {
            let rows = getFilteredNguyenLieuRows();
            let total = rows.length;
            let totalPages = Math.ceil(total / nguyenLieuPageSize);
            let pag = document.getElementById('nguyenlieu-pagination');
            if (!pag) return;
            if (totalPages <= 1) {
                pag.innerHTML = '';
                return;
            }
            let html = '';
            html += `<button onclick="gotoNguyenLieuPage(1)" ${nguyenLieuCurrentPage==1?'disabled':''}>&laquo;</button>`;
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || Math.abs(i-nguyenLieuCurrentPage)<=2) {
                    html += `<button onclick="gotoNguyenLieuPage(${i})" ${i==nguyenLieuCurrentPage?'class="active"':''}>${i}</button>`;
                } else if (i === nguyenLieuCurrentPage-3 || i === nguyenLieuCurrentPage+3) {
                    html += '<span>...</span>';
                }
            }
            html += `<button onclick="gotoNguyenLieuPage(${totalPages})" ${nguyenLieuCurrentPage==totalPages?'disabled':''}>&raquo;</button>`;
            pag.className = 'userlist-pagination';
            pag.innerHTML = html;
        }
        function updateNguyenLieuPagination() {
            let allRows = getAllNguyenLieuRows();
            let rows = getFilteredNguyenLieuRows();
            let total = rows.length;
            let totalPages = Math.ceil(total / nguyenLieuPageSize);
            if (nguyenLieuCurrentPage > totalPages) nguyenLieuCurrentPage = totalPages || 1;
            allRows.forEach(function(row) { row.style.display = 'none'; });
            rows.forEach(function(row, idx) {
                if (idx >= (nguyenLieuCurrentPage-1)*nguyenLieuPageSize && idx < nguyenLieuCurrentPage*nguyenLieuPageSize) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
            let pag = document.getElementById('nguyenlieu-pagination');
            if (rows.length === 0) {
                if (pag) pag.innerHTML = '';
                return;
            }
            renderNguyenLieuPagination();
        }
        function gotoNguyenLieuPage(page) {
            nguyenLieuCurrentPage = page;
            updateNguyenLieuPagination();
        }
        function changeNguyenLieuPageSize() {
            nguyenLieuPageSize = parseInt(document.getElementById('nguyenLieuPageSize').value);
            nguyenLieuCurrentPage = 1;
            updateNguyenLieuPagination();
        }
        function filterNguyenLieuList() {
            nguyenLieuCurrentSearch = document.querySelector('.userlist-search').value.toLowerCase();
            nguyenLieuCurrentPage = 1;
            updateNguyenLieuPagination();
        }
        function filterNguyenLieuByStatus() {
            var status = document.getElementById('filterNguyenLieuStatus').value;
            var url = new URL(window.location.href);
            url.searchParams.set('status', status);
            window.location.href = url.toString();
        }
        window.addEventListener('DOMContentLoaded', function() {
            // Set trạng thái filter theo query string
            var urlParams = new URLSearchParams(window.location.search);
            var status = urlParams.get('status') || 'active';
            document.getElementById('filterNguyenLieuStatus').value = status;
            nguyenLieuPageSize = parseInt(document.getElementById('nguyenLieuPageSize').value) || 10;
            setTimeout(updateNguyenLieuPagination, 0);
        });
    </script>
    <script>
        document.querySelector('.userlist-add-btn').onclick = function() {
            document.getElementById('addNguyenLieuModal').style.display = 'flex';
        };
        function closeAddNguyenLieuModal() {
            document.getElementById('addNguyenLieuModal').style.display = 'none';
            document.getElementById('addNguyenLieuForm').reset();
        }
        function showEditNguyenLieuModal(id, tenNguyenLieu, maNguyenLieu, donViTinh) {
            document.getElementById('editNguyenLieuId').value = id;
            document.getElementById('editTenNguyenLieu').value = tenNguyenLieu;
            document.getElementById('editMaNguyenLieu').value = maNguyenLieu;
            document.getElementById('editDonViTinh').value = donViTinh || '';
            document.getElementById('editNguyenLieuModal').style.display = 'flex';
        }
        function closeEditNguyenLieuModal() {
            document.getElementById('editNguyenLieuModal').style.display = 'none';
            document.getElementById('editNguyenLieuForm').reset();
        }
        let deleteNguyenLieuId = null;
        function showDeleteNguyenLieuConfirm(id) {
            deleteNguyenLieuId = id;
            document.getElementById('deleteNguyenLieuId').value = id;
            document.getElementById('deleteNguyenLieuModal').style.display = 'flex';
        }
        function closeDeleteNguyenLieuModal() {
            deleteNguyenLieuId = null;
            document.getElementById('deleteNguyenLieuModal').style.display = 'none';
        }
        // Form thêm mới nguyên liệu đã chuyển sang submit chuẩn Razor Page, không dùng fetch nữa
        // Form sửa nguyên liệu đã chuyển sang submit chuẩn Razor Page, không dùng fetch nữa
        // Đã chuyển chức năng xóa sang trang DeleteNguyenLieu.cshtml
    </script>
</body>

</html>
