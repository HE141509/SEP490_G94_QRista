    <!-- Hidden form for anti-forgery token -->
    <form id="hiddenTokenForm" style="display: none;">
        @Html.AntiForgeryToken()
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentDeleteId = null;
        
        // Thông tin chi nhánh của user hiện tại
        const currentUserBranchCode = '@Model.CurrentUserBranchCode';
        const currentUserId = '@Model.CurrentUserId';
        const currentUserBranchId = '@Model.CurrentUserBranchId';
        
        // Hàm chuyển đổi tab
        function switchTab(status, tabElement) {
            // Remove active class from all tabs
            document.querySelectorAll('.status-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Add active class to clicked tab
            tabElement.classList.add('active');
            
            // Filter table rows based on status
            const rows = document.querySelectorAll('#deXuatMuaSamListTable tbody tr');
            let visibleCount = 0;
            
            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status');
                const isDeleted = row.getAttribute('data-deleted') === 'true';
                const nguoiGui = row.getAttribute('data-nguoi-gui');
                const nguoiNhan = row.getAttribute('data-nguoi-nhan');
                let shouldShow = false;
                
                switch(status) {
                    case 'pending':
                        // Tab "Chờ duyệt": status = pending và người gửi = người đăng nhập
                        shouldShow = rowStatus === 'pending' && !isDeleted && nguoiGui === currentUserId;
                        break;
                    case 'received':
                        // Tab "Đã nhận": status = pending và người nhận = người đăng nhập
                        shouldShow = rowStatus === 'pending' && !isDeleted && nguoiNhan === currentUserId;
                        break;
                    case 'accepted':
                        // Tab "Đã duyệt": status = accepted và (người nhận = người đăng nhập HOẶC người gửi = người đăng nhập)
                        shouldShow = rowStatus === 'accepted' && !isDeleted && (nguoiNhan === currentUserId || nguoiGui === currentUserId);
                        break;
                    case 'rejected':
                        // Tab "Từ chối": status = rejected và (người nhận = người đăng nhập HOẶC người gửi = người đăng nhập)
                        shouldShow = rowStatus === 'rejected' && !isDeleted && (nguoiNhan === currentUserId || nguoiGui === currentUserId);
                        break;
                    case 'deleted':
                        shouldShow = isDeleted;
                        break;
                }
                
                if (shouldShow) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });
            
            // Update pagination info
            updatePaginationInfo(visibleCount, status);
        }
        
        // Hàm cập nhật thông tin phân trang
        function updatePaginationInfo(visibleCount, status) {
            const paginationInfo = document.querySelector('.userlist-pagination-info');
            let statusText = '';
            
            switch(status) {
                case 'all': statusText = 'tất cả đề xuất'; break;
                case 'pending': statusText = 'đề xuất chờ duyệt'; break;
                case 'accepted': statusText = 'đề xuất đã duyệt'; break;
                case 'rejected': statusText = 'đề xuất từ chối'; break;
                case 'received': statusText = 'đề xuất đã nhận'; break;
                case 'deleted': statusText = 'đề xuất đã xóa'; break;
            }
            
            if (paginationInfo) {
                paginationInfo.textContent = `Hiển thị ${visibleCount} ${statusText}`;
            }
        }
        
        // Hàm tạo mã đề xuất tự động
        function generateDeXuatCode() {
            const now = new Date();
            const day = String(now.getDate()).padStart(2, '0');
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const year = now.getFullYear();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            
            // Format: DXMS_ddmmyyyyhhMMss_+ mã chi nhánh
            const timeString = `${day}${month}${year}${hours}${minutes}${seconds}`;
            return `DXMS_${timeString}_${currentUserBranchCode}`;
        }
        
        // Hàm lấy tên hiển thị theo ID
        function getDisplayTextById(optionsId, selectedId) {
            const options = document.querySelectorAll(`#${optionsId} .searchable-option`);
            for (let option of options) {
                if (option.getAttribute('data-value') === selectedId) {
                    return option.textContent;
                }
            }
            return '';
        }

        // Set initial page size and default tab
        document.addEventListener('DOMContentLoaded', function() {
            const pageSize = @Model.PageSize;
            const pageSizeSelect = document.getElementById('deXuatPageSize');
            if (pageSizeSelect) {
                pageSizeSelect.value = pageSize;
            }
            
            // Initialize with "Chờ duyệt" tab
            const pendingTab = document.querySelector('.status-tab[onclick*="pending"]');
            if (pendingTab) {
                switchTab('pending', pendingTab);
            }
        });

        // Change page size
        function changeDeXuatPageSize() {
            const pageSize = document.getElementById('deXuatPageSize').value;
            window.location.href = `?pageNumber=1&pageSize=${pageSize}`;
        }

        // Search function (client-side for current page)
        function filterDeXuatList() {
            const searchText = event.target.value.toLowerCase();
            const rows = document.querySelectorAll('#deXuatMuaSamListTable tbody tr');
            const activeTab = document.querySelector('.status-tab.active');
            const currentStatus = activeTab ? activeTab.onclick.toString().match(/switchTab\('([^']+)'/)?.[1] || 'all' : 'all';
            
            let visibleCount = 0;
            
            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                const rowStatus = row.getAttribute('data-status');
                const isDeleted = row.getAttribute('data-deleted') === 'true';
                const nguoiGui = row.getAttribute('data-nguoi-gui');
                const nguoiNhan = row.getAttribute('data-nguoi-nhan');
                
                // Check if row matches current tab filter
                let matchesTab = false;
                switch(currentStatus) {
                    case 'pending':
                        // Tab "Chờ duyệt": status = pending và người gửi = người đăng nhập
                        matchesTab = rowStatus === 'pending' && !isDeleted && nguoiGui === currentUserId;
                        break;
                    case 'received':
                        // Tab "Đã nhận": status = pending và người nhận = người đăng nhập
                        matchesTab = rowStatus === 'pending' && !isDeleted && nguoiNhan === currentUserId;
                        break;
                    case 'accepted':
                        matchesTab = rowStatus === 'accepted' && !isDeleted && (nguoiNhan === currentUserId || nguoiGui === currentUserId);
                        break;
                    case 'rejected':
                        matchesTab = rowStatus === 'rejected' && !isDeleted && (nguoiNhan === currentUserId || nguoiGui === currentUserId);
                        break;
                    case 'deleted':
                        matchesTab = isDeleted;
                        matchesTab = isDeleted;
                        break;
                }
                
                // Check if row matches search text
                let matchesSearch = searchText === '';
                if (searchText !== '') {
                    // Search in MaDeXuat, TieuDe, TenNguoiGui, TenNguoiNhan
                    for (let i = 0; i < 6; i++) {
                        if (cells[i] && cells[i].textContent.toLowerCase().includes(searchText)) {
                            matchesSearch = true;
                            break;
                        }
                    }
                }
                
                // Show row only if it matches both tab and search filters
                if (matchesTab && matchesSearch) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });
            
            // Update pagination info
            updatePaginationInfo(visibleCount, currentStatus);
        }

        // Xử lý form thêm mới đề xuất mua sắm
        document.getElementById('addDeXuatMuaSamForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = {
                MaDeXuat: document.getElementById('addMaDeXuat').value,
                TieuDe: document.getElementById('addTieuDe').value,
                NoiDungDeXuat: document.getElementById('addNoiDungDeXuat').value,
                IDNguoiGui: getSelectedValue('addIDNguoiGui'),
                IDChiNhanhGui: getSelectedValue('addIDChiNhanhGui'),
                IDNguoiNhan: getSelectedValue('addIDNguoiNhan'),
                IDChiNhanhNhan: getSelectedValue('addIDChiNhanhNhan')
            };
            
            // Chỉ kiểm tra chi nhánh nhận vì người nhận sẽ được chọn sau khi chọn chi nhánh
            if (!formData.IDChiNhanhNhan) {
                alert('Vui lòng chọn chi nhánh nhận!');
                return;
            }
            if (!formData.IDNguoiNhan) {
                alert('Vui lòng chọn người nhận!');
                return;
            }
            
            // Kiểm tra không được gửi cho chi nhánh của mình
            if (formData.IDChiNhanhNhan === currentUserBranchId) {
                alert('Không thể gửi đề xuất cho chi nhánh của mình!');
                return;
            }
            
            fetch('/DeXuatMuaSam/AddDeXuatMuaSam?handler=Add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra: ' + error.message);
            });
        });

        // Hiển thị modal thêm đề xuất mua sắm
        function showAddDeXuatMuaSamModal() {
            // Tự động sinh mã đề xuất
            document.getElementById('addMaDeXuat').value = generateDeXuatCode();
            
            // Tự động điền người gửi và chi nhánh gửi
            const nguoiGuiInput = document.getElementById('addIDNguoiGui');
            const chiNhanhGuiInput = document.getElementById('addIDChiNhanhGui');
            
            // Điền tên người gửi
            nguoiGuiInput.value = getDisplayTextById('addIDNguoiGuiOptions', currentUserId);
            nguoiGuiInput.setAttribute('data-selected-id', currentUserId);
            
            // Điền tên chi nhánh gửi
            chiNhanhGuiInput.value = getDisplayTextById('addIDChiNhanhGuiOptions', currentUserBranchId);
            chiNhanhGuiInput.setAttribute('data-selected-id', currentUserBranchId);
            
            // Reset người nhận
            const nguoiNhanInput = document.getElementById('addIDNguoiNhan');
            nguoiNhanInput.disabled = true;
            nguoiNhanInput.placeholder = 'Vui lòng chọn chi nhánh trước...';
            nguoiNhanInput.value = '';
            nguoiNhanInput.setAttribute('data-selected-id', '');
            
            document.getElementById('addDeXuatMuaSamModal').style.display = 'flex';
            // Init dropdown cho chi nhánh nhận
            initSearchableDropdown('addIDChiNhanhNhan');
            // Setup event listener cho chi nhánh nhận
            setupChiNhanhNhanListener();
        }

        // Đóng modal thêm đề xuất mua sắm
        function closeAddDeXuatMuaSamModal() {
            document.getElementById('addDeXuatMuaSamModal').style.display = 'none';
            document.getElementById('addDeXuatMuaSamForm').reset();
            resetSearchableDropdowns();
            // Reset lại mã đề xuất
            document.getElementById('addMaDeXuat').value = '';
        }

        // Hiển thị modal xóa đề xuất mua sắm
        function showDeleteDeXuatMuaSamModal(id) {
            currentDeleteId = id;
            document.getElementById('deleteDeXuatMuaSamModal').style.display = 'flex';
        }

        // Đóng modal xóa đề xuất mua sắm
        function closeDeleteDeXuatMuaSamModal() {
            document.getElementById('deleteDeXuatMuaSamModal').style.display = 'none';
            currentDeleteId = null;
        }

        // Xóa đề xuất mua sắm
        function deleteDeXuatMuaSam() {
            if (!currentDeleteId) return;
            
            fetch('/DeXuatMuaSam/DeleteDeXuatMuaSam?handler=Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ id: currentDeleteId })
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    alert('Xóa thành công!');
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra: ' + error.message);
            });
        }

        // Hiển thị modal xem chi tiết đề xuất mua sắm
        function showViewDeXuatMuaSamModal(id) {
            // Gọi API để lấy thông tin đề xuất mua sắm
            fetch(`/DeXuatMuaSam/DeXuatMuaSamList?handler=GetDeXuatDetail&id=${id}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        const deXuat = data.data;
                        
                        // Điền thông tin vào các trường readonly
                        document.getElementById('viewDeXuatId').value = deXuat.id;
                        document.getElementById('viewMaDeXuat').value = deXuat.maDeXuat;
                        document.getElementById('viewTieuDe').value = deXuat.tieuDe;
                        document.getElementById('viewNoiDungDeXuat').value = deXuat.noiDungDeXuat;
                        document.getElementById('viewNguoiGui').value = deXuat.tenNguoiGui;
                        document.getElementById('viewChiNhanhGui').value = deXuat.tenChiNhanhGui;
                        document.getElementById('viewChiNhanhNhan').value = deXuat.tenChiNhanhNhan;
                        document.getElementById('viewNguoiNhan').value = deXuat.tenNguoiNhan;
                        document.getElementById('viewStatus').value = getStatusText(deXuat.status);
                        
                        // Format ngày tạo
                        const createDate = new Date(deXuat.createTime);
                        document.getElementById('viewCreateTime').value = createDate.toLocaleString('vi-VN');
                        
                        // Hiển thị và enable/disable action buttons dựa trên điều kiện
                        const actionButtons = document.getElementById('viewActionButtons');
                        const approveBtn = document.getElementById('approveBtn');
                        const rejectBtn = document.getElementById('rejectBtn');
                        
                        console.log('Debug info:', {
                            status: deXuat.status,
                            idNguoiNhan: deXuat.idNguoiNhan,
                            currentUserId: currentUserId,
                            shouldEnable: deXuat.status === 'pending' && deXuat.idNguoiNhan.toLowerCase() === currentUserId.toLowerCase()
                        });
                        
                        if (deXuat.status === 'pending' && deXuat.idNguoiNhan.toLowerCase() === currentUserId.toLowerCase()) {
                            // Hiển thị và enable buttons cho người nhận khi status = pending
                            actionButtons.style.display = 'block';
                            approveBtn.disabled = false;
                            rejectBtn.disabled = false;
                            approveBtn.style.opacity = '1';
                            rejectBtn.style.opacity = '1';
                            approveBtn.style.cursor = 'pointer';
                            rejectBtn.style.cursor = 'pointer';
                            console.log('Buttons enabled');
                        } else {
                            // Hiển thị nhưng disable buttons trong các trường hợp khác
                            actionButtons.style.display = 'block';
                            approveBtn.disabled = true;
                            rejectBtn.disabled = true;
                            approveBtn.style.opacity = '0.5';
                            rejectBtn.style.opacity = '0.5';
                            approveBtn.style.cursor = 'not-allowed';
                            rejectBtn.style.cursor = 'not-allowed';
                            console.log('Buttons disabled');
                        }
                        
                        // Hiển thị modal
                        document.getElementById('viewDeXuatMuaSamModal').style.display = 'flex';
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error loading data:', error);
                    alert('Có lỗi khi tải thông tin đề xuất');
                });
        }

        // Đóng modal xem chi tiết
        function closeViewDeXuatMuaSamModal() {
            document.getElementById('viewDeXuatMuaSamModal').style.display = 'none';
        }

        // Phê duyệt đề xuất
        function approveDeXuat() {
            console.log('approveDeXuat called');
            const approveBtn = document.getElementById('approveBtn');
            console.log('approveBtn.disabled:', approveBtn.disabled);
            
            if (approveBtn.disabled) {
                alert('Bạn không có quyền thực hiện thao tác này!');
                return;
            }
            
            const deXuatId = document.getElementById('viewDeXuatId').value;
            if (!deXuatId) return;
            
            updateDeXuatStatus(deXuatId, 'accepted', 'Đề xuất đã được phê duyệt thành công!');
        }

        // Từ chối đề xuất
        function rejectDeXuat() {
            console.log('rejectDeXuat called');
            const rejectBtn = document.getElementById('rejectBtn');
            console.log('rejectBtn.disabled:', rejectBtn.disabled);
            
            if (rejectBtn.disabled) {
                alert('Bạn không có quyền thực hiện thao tác này!');
                return;
            }
            
            const deXuatId = document.getElementById('viewDeXuatId').value;
            if (!deXuatId) return;
            
            updateDeXuatStatus(deXuatId, 'rejected', 'Đề xuất đã được từ chối!');
        }

        // Cập nhật trạng thái đề xuất
        function updateDeXuatStatus(deXuatId, newStatus, successMessage) {
            // Lấy anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            // Tạo FormData
            const formData = new FormData();
            formData.append('id', deXuatId);
            formData.append('status', newStatus);
            formData.append('__RequestVerificationToken', token);
            
            fetch('/DeXuatMuaSam/DeXuatMuaSamList?handler=UpdateStatus', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                console.log('Response status:', response.status);
                console.log('Response headers:', response.headers.get('content-type'));
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                // Kiểm tra content-type trước khi parse JSON
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                    return response.json();
                } else {
                    // Nếu không phải JSON, đọc text để debug
                    return response.text().then(text => {
                        console.log('Response text:', text);
                        throw new Error('Server không trả về JSON. Response: ' + text.substring(0, 200));
                    });
                }
            })
            .then(data => {
                console.log('Response data:', data);
                
                if (data.success) {
                    console.log('Success! Message:', data.message);
                    alert(successMessage);
                    closeViewDeXuatMuaSamModal();
                    window.location.reload();
                } else {
                    console.log('Error from server:', data.message);
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra: ' + error.message);
            });
        }

        // Hiển thị modal cập nhật đề xuất mua sắm
        function showUpdateDeXuatMuaSamModal(id) {
            // Gọi API để lấy thông tin đề xuất mua sắm
            fetch(`/DeXuatMuaSam/DeXuatMuaSamList?handler=GetDeXuatDetail&id=${id}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        const deXuat = data.data;
                        
                        // Điền thông tin vào form
                        document.getElementById('updateDeXuatId').value = deXuat.id;
                        document.getElementById('updateMaDeXuat').value = deXuat.maDeXuat;
                        document.getElementById('updateTieuDe').value = deXuat.tieuDe;
                        document.getElementById('updateNoiDungDeXuat').value = deXuat.noiDungDeXuat;
                        
                        // Hiển thị thông tin readonly
                        document.getElementById('updateNguoiGuiDisplay').value = deXuat.tenNguoiGui;
                        document.getElementById('updateIDNguoiGui').value = deXuat.idNguoiGui;
                        document.getElementById('updateChiNhanhGuiDisplay').value = deXuat.tenChiNhanhGui;
                        document.getElementById('updateIDChiNhanhGui').value = deXuat.idChiNhanhGui;
                        
                        // Hiển thị trạng thái (readonly)
                        const statusText = getStatusText(deXuat.status);
                        document.getElementById('updateStatusDisplay').value = statusText;
                        document.getElementById('updateStatus').value = deXuat.status;
                        
                        // Set giá trị cho chi nhánh nhận và người nhận
                        const updateChiNhanhNhanInput = document.getElementById('updateIDChiNhanhNhan');
                        const updateNguoiNhanInput = document.getElementById('updateIDNguoiNhan');
                        
                        updateChiNhanhNhanInput.value = deXuat.tenChiNhanhNhan;
                        updateChiNhanhNhanInput.setAttribute('data-selected-id', deXuat.idChiNhanhNhan);
                        
                        // Load người nhận theo chi nhánh hiện tại
                        loadUpdateNguoiNhanByChiNhanh(deXuat.idChiNhanhNhan, deXuat.idNguoiNhan, deXuat.tenNguoiNhan);
                        
                        // Hiển thị modal
                        document.getElementById('updateDeXuatMuaSamModal').style.display = 'flex';
                        
                        // Init dropdown cho chi nhánh nhận
                        initSearchableDropdown('updateIDChiNhanhNhan');
                        // Setup event listener cho chi nhánh nhận
                        setupUpdateChiNhanhNhanListener();
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error loading data:', error);
                    alert('Có lỗi khi tải thông tin đề xuất');
                });
        }

        // Hàm chuyển đổi status code thành text
        function getStatusText(status) {
            switch (status) {
                case 'pending': return 'Chờ duyệt';
                case 'accepted': return 'Đã duyệt';
                case 'rejected': return 'Từ chối';
                case 'received': return 'Đã nhận';
                default: return status;
            }
        }

        // Setup listener cho chi nhánh nhận trong modal update
        function setupUpdateChiNhanhNhanListener() {
            const chiNhanhNhanInput = document.getElementById('updateIDChiNhanhNhan');
            const nguoiNhanInput = document.getElementById('updateIDNguoiNhan');
            
            // Lắng nghe khi chọn chi nhánh
            const chiNhanhOptions = document.querySelectorAll('#updateIDChiNhanhNhanOptions .searchable-option');
            chiNhanhOptions.forEach(option => {
                option.addEventListener('click', function() {
                    const selectedBranchId = this.getAttribute('data-value');
                    
                    // Reset người nhận
                    nguoiNhanInput.value = '';
                    nguoiNhanInput.setAttribute('data-selected-id', '');
                    
                    // Load danh sách người nhận theo chi nhánh
                    loadUpdateNguoiNhanByChiNhanh(selectedBranchId);
                });
            });
        }

        // Load danh sách người nhận theo chi nhánh cho modal update
        function loadUpdateNguoiNhanByChiNhanh(branchId, selectedUserId = null, selectedUserName = null) {
            const nguoiNhanInput = document.getElementById('updateIDNguoiNhan');
            const nguoiNhanOptions = document.getElementById('updateIDNguoiNhanOptions');
            
            if (!branchId) {
                nguoiNhanInput.disabled = true;
                nguoiNhanInput.placeholder = 'Vui lòng chọn chi nhánh trước...';
                nguoiNhanOptions.innerHTML = '';
                return;
            }
            
            // Call API để lấy danh sách người dùng theo chi nhánh
            fetch(`/DeXuatMuaSam/DeXuatMuaSamList?handler=GetUsersByBranch&branchId=${branchId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(users => {
                    // Clear existing options
                    nguoiNhanOptions.innerHTML = '';
                    
                    // Add new options
                    users.forEach(user => {
                        // Không hiển thị user hiện tại
                        if (user.id !== currentUserId) {
                            const optionDiv = document.createElement('div');
                            optionDiv.className = 'searchable-option';
                            optionDiv.setAttribute('data-value', user.id);
                            optionDiv.textContent = user.tenHienThi;
                            nguoiNhanOptions.appendChild(optionDiv);
                        }
                    });
                    
                    // Enable input và setup dropdown
                    nguoiNhanInput.disabled = false;
                    nguoiNhanInput.placeholder = 'Tìm kiếm người nhận...';
                    
                    // Set giá trị đã chọn nếu có
                    if (selectedUserId && selectedUserName) {
                        nguoiNhanInput.value = selectedUserName;
                        nguoiNhanInput.setAttribute('data-selected-id', selectedUserId);
                    }
                    
                    // Re-initialize dropdown cho người nhận
                    initSearchableDropdown('updateIDNguoiNhan');
                })
                .catch(error => {
                    console.error('Error loading users:', error);
                    alert('Có lỗi khi tải danh sách người nhận');
                    nguoiNhanInput.disabled = true;
                    nguoiNhanInput.placeholder = 'Lỗi khi tải danh sách';
                    nguoiNhanOptions.innerHTML = '';
                });
        }

        // Đóng modal cập nhật đề xuất mua sắm
        function closeUpdateDeXuatMuaSamModal() {
            document.getElementById('updateDeXuatMuaSamModal').style.display = 'none';
            document.getElementById('updateDeXuatMuaSamForm').reset();
        }

        // Xử lý form cập nhật đề xuất mua sắm
        document.getElementById('updateDeXuatMuaSamForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Lấy giá trị chi nhánh nhận và người nhận
            const chiNhanhNhanInput = document.getElementById('updateIDChiNhanhNhan');
            const nguoiNhanInput = document.getElementById('updateIDNguoiNhan');
            
            const formData = {
                id: document.getElementById('updateDeXuatId').value,
                tieuDe: document.getElementById('updateTieuDe').value,
                noiDungDeXuat: document.getElementById('updateNoiDungDeXuat').value,
                idChiNhanhNhan: chiNhanhNhanInput.getAttribute('data-selected-id') || '',
                idNguoiNhan: nguoiNhanInput.getAttribute('data-selected-id') || ''
            };
            
            if (!formData.tieuDe || !formData.noiDungDeXuat || !formData.idChiNhanhNhan || !formData.idNguoiNhan) {
                alert('Vui lòng nhập đầy đủ thông tin!');
                return;
            }
            
            // Lấy anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            // Tạo FormData
            const form = new FormData();
            form.append('id', formData.id);
            form.append('tieuDe', formData.tieuDe);
            form.append('noiDungDeXuat', formData.noiDungDeXuat);
            form.append('idChiNhanhNhan', formData.idChiNhanhNhan);
            form.append('idNguoiNhan', formData.idNguoiNhan);
            form.append('__RequestVerificationToken', token);
            
            fetch('/DeXuatMuaSam/UpdateDeXuatMuaSam', {
                method: 'POST',
                body: form
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    alert('Cập nhật thành công!');
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra: ' + error.message);
            });
        });

        // Searchable dropdown functions
        function getSelectedValue(inputId) {
            const input = document.getElementById(inputId);
            return input.getAttribute('data-selected-id') || '';
        }

        function initSearchableDropdown(inputId) {
            const input = document.getElementById(inputId);
            const optionsContainer = document.getElementById(inputId + 'Options');
            const options = optionsContainer.querySelectorAll('.searchable-option');

            input.addEventListener('focus', function() {
                optionsContainer.style.display = 'block';
            });

            input.addEventListener('input', function() {
                const searchText = this.value.toLowerCase();
                options.forEach(option => {
                    const text = option.textContent.toLowerCase();
                    option.style.display = text.includes(searchText) ? 'block' : 'none';
                });
            });

            options.forEach(option => {
                option.addEventListener('click', function() {
                    const value = this.getAttribute('data-value');
                    const text = this.textContent;
                    input.value = text;
                    input.setAttribute('data-selected-id', value);
                    optionsContainer.style.display = 'none';
                });
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!input.contains(e.target) && !optionsContainer.contains(e.target)) {
                    optionsContainer.style.display = 'none';
                }
            });
        }

        function resetSearchableDropdowns() {
            // Chi nhánh nhận
            const chiNhanhNhanInput = document.getElementById('addIDChiNhanhNhan');
            if (chiNhanhNhanInput) {
                chiNhanhNhanInput.value = '';
                chiNhanhNhanInput.setAttribute('data-selected-id', '');
                const chiNhanhOptions = document.getElementById('addIDChiNhanhNhanOptions');
                if (chiNhanhOptions) chiNhanhOptions.style.display = 'none';
            }
            
            // Người nhận - reset và disable
            const nguoiNhanInput = document.getElementById('addIDNguoiNhan');
            if (nguoiNhanInput) {
                nguoiNhanInput.value = '';
                nguoiNhanInput.setAttribute('data-selected-id', '');
                nguoiNhanInput.disabled = true;
                nguoiNhanInput.placeholder = 'Vui lòng chọn chi nhánh trước...';
                const nguoiNhanOptions = document.getElementById('addIDNguoiNhanOptions');
                if (nguoiNhanOptions) {
                    nguoiNhanOptions.style.display = 'none';
                    nguoiNhanOptions.innerHTML = ''; // Clear options
                }
            }
        }

        // Setup listener cho chi nhánh nhận để load người nhận
        function setupChiNhanhNhanListener() {
            const chiNhanhNhanInput = document.getElementById('addIDChiNhanhNhan');
            const nguoiNhanInput = document.getElementById('addIDNguoiNhan');
            const nguoiNhanOptions = document.getElementById('addIDNguoiNhanOptions');
            
            // Lắng nghe khi chọn chi nhánh
            const chiNhanhOptions = document.querySelectorAll('#addIDChiNhanhNhanOptions .searchable-option');
            chiNhanhOptions.forEach(option => {
                option.addEventListener('click', function() {
                    const selectedBranchId = this.getAttribute('data-value');
                    
                    // Reset người nhận
                    nguoiNhanInput.value = '';
                    nguoiNhanInput.setAttribute('data-selected-id', '');
                    
                    // Load danh sách người nhận theo chi nhánh
                    loadNguoiNhanByChiNhanh(selectedBranchId);
                });
            });
        }

        // Load danh sách người nhận theo chi nhánh
        function loadNguoiNhanByChiNhanh(branchId) {
            const nguoiNhanInput = document.getElementById('addIDNguoiNhan');
            const nguoiNhanOptions = document.getElementById('addIDNguoiNhanOptions');
            
            if (!branchId) {
                nguoiNhanInput.disabled = true;
                nguoiNhanInput.placeholder = 'Vui lòng chọn chi nhánh trước...';
                nguoiNhanOptions.innerHTML = '';
                return;
            }
            
            // Call API để lấy danh sách người dùng theo chi nhánh
            fetch(`/DeXuatMuaSam/DeXuatMuaSamList?handler=GetUsersByBranch&branchId=${branchId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(users => {
                    // Clear existing options
                    nguoiNhanOptions.innerHTML = '';
                    
                    // Add new options
                    users.forEach(user => {
                        // Không hiển thị user hiện tại
                        if (user.id !== currentUserId) {
                            const optionDiv = document.createElement('div');
                            optionDiv.className = 'searchable-option';
                            optionDiv.setAttribute('data-value', user.id);
                            optionDiv.textContent = user.tenHienThi;
                            nguoiNhanOptions.appendChild(optionDiv);
                        }
                    });
                    
                    // Enable input và setup dropdown
                    nguoiNhanInput.disabled = false;
                    nguoiNhanInput.placeholder = 'Tìm kiếm người nhận...';
                    
                    // Re-initialize dropdown cho người nhận
                    initSearchableDropdown('addIDNguoiNhan');
                })
                .catch(error => {
                    console.error('Error loading users:', error);
                    alert('Có lỗi khi tải danh sách người nhận');
                    nguoiNhanInput.disabled = true;
                    nguoiNhanInput.placeholder = 'Lỗi khi tải danh sách';
                    nguoiNhanOptions.innerHTML = '';
                });
        }

        // Hàm nhận hàng
        function receiveOrder(id) {
            // Lấy anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            // Tạo FormData
            const formData = new FormData();
            formData.append('id', id);
            formData.append('__RequestVerificationToken', token);
            
            fetch('/DeXuatMuaSam/DeXuatMuaSamList?handler=ReceiveOrder', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                    return response.json();
                } else {
                    return response.text().then(text => {
                        console.log('Response text:', text);
                        throw new Error('Server không trả về JSON. Response: ' + text.substring(0, 200));
                    });
                }
            })
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra: ' + error.message);
            });
        }

        // Close modals when clicking outside
        window.addEventListener('click', function(event) {
            const modals = ['addDeXuatMuaSamModal', 'deleteDeXuatMuaSamModal', 'updateDeXuatMuaSamModal', 'viewDeXuatMuaSamModal'];
            modals.forEach(modalId => {
                const modal = document.getElementById(modalId);
                if (event.target === modal) {
                    modal.style.display = 'none';
                }
            });
        });
    </script>
