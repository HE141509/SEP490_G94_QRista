                </div>
                
                <!-- Trạng thái và ngày tạo -->
                <div style="display: flex; gap: 15px; margin-bottom: 20px;">
                    <div class="userlist-add-form-group" style="flex: 1;">
                        <label>Trạng thái</label>
                        <input type="text" id="viewStatus" class="userlist-input" readonly style="background-color: #f5f5f5;" />
                    </div>
                    <div class="userlist-add-form-group" style="flex: 1;">
                        <label>Ngày tạo</label>
                        <input type="text" id="viewCreateTime" class="userlist-input" readonly style="background-color: #f5f5f5;" />
                    </div>
                </div>
                
                <!-- Action buttons for "Đã nhận" status -->
                <div id="viewActionButtons" style="margin: 20px 0;">
                    <div style="padding: 15px; background: #f8f9fa; border-radius: 8px; border-left: 4px solid #17a2b8;">
                        <h6 style="margin: 0 0 10px 0; color: #17a2b8; font-weight: 600;">
                            <i class="fas fa-info-circle"></i> Thao tác xử lý đề xuất
                        </h6>
                        <p style="margin: 0 0 15px 0; color: #6c757d; font-size: 14px;">
                            Vui lòng chọn một trong hai hành động dưới đây để xử lý đề xuất này:
                        </p>
                        <div style="display: flex; gap: 15px; justify-content: center;">
                            <button type="button" id="approveBtn" class="action-btn approve-btn" onclick="approveDeXuat()">
                                <i class="fas fa-check"></i> Phê duyệt
                            </button>
                            <button type="button" id="rejectBtn" class="action-btn reject-btn" onclick="rejectDeXuat()">
                                <i class="fas fa-times"></i> Từ chối
                            </button>
