@page
@model QRB.Pages.Order.OrderListModel
@{
    ViewData["Title"] = "Danh sách hóa đơn";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
@{
    var userId = HttpContext.Session.GetString("UserId");
    var branchId = HttpContext.Session.GetString("ChiNhanhId");
}
<input type="hidden" id="hiddenUserId" value="@userId" />
<input type="hidden" id="hiddenBranchId" value="@branchId" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/userlist.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>

<body>
    @await Html.PartialAsync("~/Pages/Shared/_Header.cshtml", Model)
    <div class="main-container">
        @await Html.PartialAsync("~/Pages/Shared/_Sidebar.cshtml", Model)
        <main class="main-content">
            <div class="dashboard-header userlist-header-flex">
                <h1 class="page-title">Danh sách hóa đơn</h1>
                <button class="userlist-add-btn" type="button" id="showAddOrderBtn">
                    <i class="fas fa-plus"></i> Thêm mới
                </button>
                <div id="addOrderModal" class="modal"
                    style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
                    <div class="modal-content userlist-add-modal-content">
                        <div class="userlist-add-modal-title"><i class="fas fa-file-invoice"></i> Thêm hóa đơn mới</div>
                        <form id="addOrderForm" autocomplete="off">
                            <div class="userlist-add-form-group" style="display:flex; flex-direction:row; gap:16px; align-items:flex-end;">
                                <div style="flex:1; display:flex; flex-direction:column;">
                                    <label for="addMaDonHang">Mã đơn hàng</label>
                                    <input type="text" id="addMaDonHang" name="MaDonHang" class="userlist-input" readonly required />
                                </div>
                                <div style="flex:1; display:flex; flex-direction:column;">
                                    <label for="addIDNhanVien">Nhân viên tạo</label>
                                    <input type="text" id="addIDNhanVien" name="IDNhanVien" class="userlist-input" readonly value="@(Model.DisplayName ?? "")" />
                                </div>
                                <div style="flex:1; display:flex; flex-direction:column;">
                                    <label for="addIDChiNhanh">Chi nhánh</label>
                                    <input type="text" id="addIDChiNhanh" name="IDChiNhanh" class="userlist-input" readonly value="@(Model.CurrentBranchName ?? "")" />
                                </div>
                            </div>
                            <!-- DÒNG NHẬP LIỆU THÊM SẢN PHẨM VÀO HÓA ĐƠN (ĐÃ DI CHUYỂN XUỐNG DƯỚI) -->
                            <!-- DÒNG NHẬP LIỆU THÊM SẢN PHẨM VÀO HÓA ĐƠN (ĐÃ DI CHUYỂN XUỐNG DƯỚI) -->
                            <div class="userlist-add-form-group" style="display:flex; flex-direction:row; gap:10px; align-items:flex-end; margin-bottom:8px;">
                                <div style="flex:2; display:flex; flex-direction:column;">
                                    <label for="productSearchInput">Tìm sản phẩm</label>
                                    <input type="text" id="productSearchInput" class="userlist-input" placeholder="Nhập tên sản phẩm..." autocomplete="off" />
                                    <div id="productSearchDropdown" class="userlist-dropdown" style="display:none;position:absolute;z-index:4000;background:#fff;border:1px solid #ccc;max-height:180px;overflow-y:auto;width:100%;"></div>
                                </div>
                                <div style="flex:1; display:flex; flex-direction:column;">
                                    <label for="productTypeSelect">Loại sản phẩm</label>
                                    <select id="productTypeSelect" class="userlist-input">
                                        <option value="">-- Chọn loại --</option>
                                    </select>
                                </div>
                                <div style="flex:0;">
                                    <button type="button" id="addProductToOrderBtn" class="userlist-add-submit-btn" style="margin-top:22px;">Chọn</button>
                                </div>
                            </div>
                            <!-- GRID HIỂN THỊ SẢN PHẨM ĐÃ CHỌN -->
                            <div class="userlist-add-form-group" style="margin-bottom:12px;">
                                <table id="orderProductGrid" class="userlist-table userlist-table-modern" style="width:100%;margin-bottom:0;">
                                    <thead>
                                        <tr>
                                            <th>ID sản phẩm</th>
                                            <th>ID loại sản phẩm</th>
                                            <th>Tên sản phẩm</th>
                                            <th>Loại sản phẩm</th>
                                            <th>Đơn giá</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Dữ liệu sẽ được thêm động bằng JS -->
                                    </tbody>
                                </table>
                            </div>
                            <!-- Đã chuyển Nhân viên tạo và Chi nhánh lên hàng đầu tiên -->
                            <div class="userlist-add-form-group" style="display:flex; flex-direction:row; gap:16px; align-items:flex-end;">
                                <div style="flex:1; display:flex; flex-direction:column;">
                                    <label for="addCustomerPhone">Khách hàng (tìm theo SĐT)</label>
                                    <input type="text" id="addCustomerPhone" class="userlist-input" placeholder="Nhập số điện thoại..." autocomplete="off" />
                                </div>
                                <div style="flex:1; display:flex; flex-direction:column;">
                                    <label for="addIDKhachHang">ID khách hàng</label>
                                    <input type="text" id="addIDKhachHang" name="IDKhachHang" class="userlist-input" readonly required />
                                </div>
                                <div style="flex:1; display:flex; flex-direction:column;">
                                    <label for="addCustomerName">Tên khách hàng</label>
                                    <input type="text" id="addCustomerName" class="userlist-input" readonly />
                                </div>
                            </div>
                            <div class="userlist-add-form-group" style="display:flex; flex-direction:row; gap:16px; align-items:flex-end;">
                                <div style="flex:1; display:flex; flex-direction:column;">
                                    <label for="addMaUuDai">Mã ưu đãi</label>
                                    <select id="addMaUuDai" name="MaUuDai" class="userlist-input">
                                        <option value="">-- Không áp dụng --</option>
                                    </select>
                                </div>
                                <div style="flex:1; display:flex; flex-direction:column;">
                                    <label for="addTienUuDai">Tiền ưu đãi</label>
                                    <input type="text" id="addTienUuDai" class="userlist-input" readonly />
                                </div>
                            </div>
                            <div class="userlist-add-form-group">
                                <label for="addTongTien">Tổng tiền</label>
                                <input type="text" id="addTongTien" name="TongTien" class="userlist-input" readonly required />
                            </div>
                            <div class="userlist-add-form-group">
                                <label for="addTrangThai">Trạng thái</label>
                                <select id="addTrangThai" name="TrangThaiThanhToan" class="userlist-input">
                                    <option value="false">Chưa thanh toán</option>
                                    <option value="true" selected>Đã thanh toán</option>
                                </select>
                            </div>
                            <div class="userlist-add-modal-actions">
                                <button type="button" onclick="closeAddOrderModal()"
                                    class="userlist-add-cancel-btn">Hủy</button>
                                <button type="submit" class="userlist-add-submit-btn">Thêm mới</button>
                            </div>
                        </form>
                        <script>
                        // Tìm kiếm khách hàng theo SĐT
                        const phoneInput = document.getElementById('addCustomerPhone');
                        const idInput = document.getElementById('addIDKhachHang');
                        const nameInput = document.getElementById('addCustomerName');
                        const tienUuDaiInput = document.getElementById('addTienUuDai');
                        let tienGiamDict = {};
                        phoneInput.addEventListener('keydown', function(e) {
                            if (e.key === 'Enter') {
                                e.preventDefault();
                                const phone = phoneInput.value.trim();
                                if (!phone) return;
                                fetch(`/Order/OrderList?handler=FindByPhone&phone=${encodeURIComponent(phone)}`)
                                    .then(res => res.json())
                                    .then(data => {
                                        if (data && data.id) {
                                            idInput.value = data.id;
                                            nameInput.value = data.name;
                                            tienUuDaiInput.value = data.tienUuDai || 0;
                                            // Nếu có mã ưu đãi, cập nhật combobox
                                            const maUuDaiSelect = document.getElementById('addMaUuDai');
                                            if (maUuDaiSelect) {
                                                // Xóa các option cũ (trừ option đầu)
                                                while (maUuDaiSelect.options.length > 1) maUuDaiSelect.remove(1);
                                            tienGiamDict = data.tienGiamDict || {};
                                            if (data.maUuDaiList && Array.isArray(data.maUuDaiList) && data.maUuDaiList.length > 0) {
                                                    data.maUuDaiList.forEach(function(ma) {
                                                        const opt = document.createElement('option');
                                                        opt.value = ma;
                                                        opt.textContent = ma;
                                                        maUuDaiSelect.appendChild(opt);
                                                    });
                                                    // Nếu có mã ưu đãi mặc định, chọn luôn
                                                    if (data.maUuDaiMacDinh) {
                                                        maUuDaiSelect.value = data.maUuDaiMacDinh;
                                                        // Gọi sự kiện change để cập nhật tổng tiền nếu cần
                                                        maUuDaiSelect.dispatchEvent(new Event('change'));
                                                    } else {
                                                        maUuDaiSelect.value = '';
                                                    }
                                                } else {
                                                    maUuDaiSelect.value = '';
                                                }
                                            }
                                        } else {
                                            idInput.value = '';
                                            nameInput.value = '';
                                            tienUuDaiInput.value = '';
                                            // Reset combobox mã ưu đãi
                                            const maUuDaiSelect = document.getElementById('addMaUuDai');
                                            if (maUuDaiSelect) {
                                                while (maUuDaiSelect.options.length > 1) maUuDaiSelect.remove(1);
                                                maUuDaiSelect.value = '';
                                            }
                                            tienGiamDict = {};
                                            alert('Không tìm thấy khách hàng với số điện thoại này!');
                                        }
                                    })
                                    .catch(() => {
                                        idInput.value = '';
                                        nameInput.value = '';
                                        tienUuDaiInput.value = '';
                                        const maUuDaiSelect = document.getElementById('addMaUuDai');
                                        if (maUuDaiSelect) {
                                            while (maUuDaiSelect.options.length > 1) maUuDaiSelect.remove(1);
                                            maUuDaiSelect.value = '';
                                        }
                                        tienGiamDict = {};
                                        alert('Lỗi khi tìm khách hàng!');
                        // Khi chọn mã ưu đãi, tự động trừ số tiền giảm giá vào tổng tiền
                        document.getElementById('addMaUuDai').addEventListener('change', function() {
                            const ma = this.value;
                            const tongTienInput = document.getElementById('addTongTien');
                            if (!tongTienInput) return;
                            let tongTienGoc = tongTienInput.getAttribute('data-goc');
                            if (!tongTienGoc) tongTienGoc = tongTienInput.value;
                            if (!tongTienGoc) return;
                            let tong = parseFloat(tongTienGoc.replace(/[^\d.]/g, '')) || 0;
                            if (ma && tienGiamDict[ma]) {
                                let giam = parseFloat(tienGiamDict[ma].replace(/[^\d.]/g, '')) || 0;
                                tongTienInput.value = (tong - giam > 0 ? tong - giam : 0);
                            } else {
                                tongTienInput.value = tong;
                            }
                            tongTienInput.setAttribute('data-goc', tongTienGoc);
                        });
                                    });
                            }
                        });
                        // Khi submit form, đảm bảo ID khách hàng đã có
                        document.getElementById('addOrderForm').addEventListener('submit', function(e) {
                            if (!idInput.value) {
                                alert('Vui lòng nhập số điện thoại và tìm khách hàng trước!');
                                e.preventDefault();
                            }
                        });
                        // Cập nhật tiền ưu đãi khi chọn mã ưu đãi
                        const maUuDaiSelect = document.getElementById('addMaUuDai');
                        maUuDaiSelect.addEventListener('change', function() {
                            const selectedMaUuDai = maUuDaiSelect.value;
                            if (selectedMaUuDai && tienGiamDict[selectedMaUuDai] !== undefined) {
                                tienUuDaiInput.value = formatCurrency(tienGiamDict[selectedMaUuDai]);
                            } else {
                                tienUuDaiInput.value = formatCurrency(0);
                            }
                            calculateTongTien(); // Cập nhật tổng tiền khi thay đổi ưu đãi
                        });
                        // Hàm định dạng tiền tệ với dấu phẩy làm phân cách hàng nghìn
                        function formatCurrency(value) {
                            return new Intl.NumberFormat('vi-VN', {
                                style: 'decimal',
                                useGrouping: true,
                                minimumFractionDigits: 0
                            }).format(value).replace(/\./g, ',');
                        }
                        // Hàm tính tổng tiền: tổng giá trị các sản phẩm trong grid - tiền ưu đãi
                        function calculateTongTien() {
                            let total = 0;
                            if (Array.isArray(orderProductList)) {
                                orderProductList.forEach(item => {
                                    let donGia = parseFloat(item.DonGia) || 0;
                                    total += donGia;
                                });
                            }
                            // Trừ tiền ưu đãi nếu có
                            let tienUuDai = 0;
                            const tienUuDaiInput = document.getElementById('addTienUuDai');
                            if (tienUuDaiInput && tienUuDaiInput.value) {
                                // Loại bỏ ký tự không phải số
                                tienUuDai = parseFloat(tienUuDaiInput.value.replace(/[^\d.]/g, '')) || 0;
                            }
                            let tongTien = total - tienUuDai;
                            if (tongTien < 0) tongTien = 0;
                            const tongTienInput = document.getElementById('addTongTien');
                            if (tongTienInput) {
                                tongTienInput.value = formatCurrency(tongTien);
                            }
                        }
                        // Khi tiền ưu đãi thay đổi (ví dụ khi tìm khách hàng), cũng cần cập nhật tổng tiền
                        tienUuDaiInput.addEventListener('input', function() {
                            calculateTongTien();
                        });
                        // ================== SẢN PHẨM VÀ LOẠI SẢN PHẨM ==================
                        let selectedProduct = null;
                        let selectedProductType = null;
                        let orderProductList = [];
                        const productSearchInput = document.getElementById('productSearchInput');
                        const productSearchDropdown = document.getElementById('productSearchDropdown');
                        const productTypeSelect = document.getElementById('productTypeSelect');
                        const addProductToOrderBtn = document.getElementById('addProductToOrderBtn');
                        const orderProductGrid = document.getElementById('orderProductGrid').querySelector('tbody');

                        // Hàm fetch sản phẩm theo tên
                        productSearchInput.addEventListener('input', function() {
                            const keyword = this.value.trim();
                            if (!keyword) {
                                productSearchDropdown.style.display = 'none';
                                return;
                            }
                            fetch(`/Order/OrderList?handler=SearchProduct&keyword=${encodeURIComponent(keyword)}`)
                                .then(res => res.json())
                                .then(list => {
                                    productSearchDropdown.innerHTML = '';
                                    if (Array.isArray(list) && list.length > 0) {
                                        list.forEach(p => {
                                            // Đảm bảo property đúng tên với backend trả về
                                            const item = document.createElement('div');
                                            item.textContent = (p.TenSanPham || p.tenSanPham || p.name || 'Sản phẩm') + (p.TenNhomSanPham ? ' (' + p.TenNhomSanPham + ')' : '');
                                            item.style.padding = '6px 12px';
                                            item.style.cursor = 'pointer';
                                            item.addEventListener('mousedown', function() {
                                                // Lưu ý: backend trả về ID hoặc Id hoặc id, nên kiểm tra các trường
                                                selectedProduct = {
                                                    ID: p.ID ?? p.Id ?? p.id,
                                                    TenSanPham: p.TenSanPham ?? p.tenSanPham ?? p.name ?? '',
                                                    TenNhomSanPham: p.TenNhomSanPham ?? p.tenNhomSanPham ?? '',
                                                };
                                                productSearchInput.value = selectedProduct.TenSanPham;
                                                productSearchDropdown.style.display = 'none';
                                                // Luôn clear dropdown loại sản phẩm trước khi fetch
                                                productTypeSelect.innerHTML = '<option value="">-- Chọn loại --</option>';
                                                if (!selectedProduct.ID) return;
                                                // Sau khi chọn sản phẩm, load loại sản phẩm
                                                fetch(`/Order/OrderList?handler=GetProductTypes&productId=${encodeURIComponent(selectedProduct.ID)}`)
                                                    .then(res => res.json())
                                                    .then(types => {
                                                        productTypeSelect.innerHTML = '<option value="">-- Chọn loại --</option>';
                                                        if (Array.isArray(types) && types.length > 0) {
                                                            types.forEach(t => {
                                                                const opt = document.createElement('option');
                                                                opt.value = t.ID ?? t.Id ?? t.id;
                                                                opt.textContent = t.TenLoai ?? t.tenLoai ?? t.name ?? '';
                                                                productTypeSelect.appendChild(opt);
                                                            });
                                                        } else {
                                                            // Nếu không có loại nào, có thể báo cho user
                                                            // alert('Sản phẩm này chưa có loại sản phẩm!');
                                                        }
                                                    })
                                                    .catch(() => {
                                                        // Có thể báo lỗi nếu cần
                                                        // alert('Không lấy được loại sản phẩm!');
                                                    });
                                            });
                                            productSearchDropdown.appendChild(item);
                                        });
                                        productSearchDropdown.style.display = 'block';
                                    } else {
                                        productSearchDropdown.style.display = 'none';
                                    }
                                })
                                .catch(() => {
                                    productSearchDropdown.style.display = 'none';
                                });
                        });
                        // Ẩn dropdown khi click ngoài
                        document.addEventListener('mousedown', function(e) {
                            if (!productSearchDropdown.contains(e.target) && e.target !== productSearchInput) {
                                productSearchDropdown.style.display = 'none';
                            }
                        });
                        // Khi chọn loại sản phẩm
                        productTypeSelect.addEventListener('change', function() {
                            selectedProductType = this.value;
                        });
                        // Thêm sản phẩm vào grid
                        addProductToOrderBtn.addEventListener('click', function() {
                            if (!selectedProduct || !selectedProductType || selectedProductType === "") {
                                alert('Vui lòng chọn sản phẩm và loại sản phẩm!');
                                return;
                            }
                            // Lấy thông tin loại sản phẩm
                            fetch(`/Order/OrderList?handler=GetProductTypeDetail&typeId=${selectedProductType}`)
                                .then(res => res.json())
                                .then(typeDetail => {
                                    // Kiểm tra trùng
                                    if (orderProductList.some(x => x.IDSanPham === selectedProduct.ID && x.IDLoaiSanPham === selectedProductType)) {
                                        alert('Sản phẩm này đã được thêm!');
                                        return;
                                    }
                                    // Đảm bảo DonGia là số, kể cả khi backend trả về string
                                    let donGia = 0;
                                    if (typeDetail && (typeDetail.DonGia !== undefined || typeDetail.donGia !== undefined)) {
                                        let rawDonGia = typeDetail.DonGia ?? typeDetail.donGia;
                                        if (typeof rawDonGia === 'string') {
                                            // Loại bỏ ký tự không phải số
                                            rawDonGia = rawDonGia.replace(/[^\d.]/g, '');
                                        }
                                        donGia = parseFloat(rawDonGia) || 0;
                                    }
                                    const record = {
                                        IDSanPham: selectedProduct.ID,
                                        IDLoaiSanPham: selectedProductType,
                                        TenSanPham: selectedProduct.TenSanPham,
                                        TenLoaiSanPham: typeDetail.TenLoai ?? typeDetail.tenLoai ?? '',
                                        DonGia: donGia
                                    };
                                    orderProductList.push(record);
                                    renderOrderProductGrid();
                                    // Reset loại sản phẩm sau khi thêm
                                    productTypeSelect.value = '';
                                });
                        });
                        // Render grid sản phẩm đã chọn
                        function renderOrderProductGrid() {
                            orderProductGrid.innerHTML = '';
                            orderProductList.forEach((item, idx) => {
                                const tr = document.createElement('tr');
                                tr.innerHTML = `
                                    <td>${item.IDSanPham}</td>
                                    <td>${item.IDLoaiSanPham}</td>
                                    <td>${item.TenSanPham}</td>
                                    <td>${item.TenLoaiSanPham ?? ''}</td>
                                    <td>${formatCurrency(item.DonGia)}</td>
                                    <td><button type="button" onclick="removeOrderProduct(${idx})" style="color:#ea4335;background:none;border:none;font-size:16px;cursor:pointer;">&times;</button></td>
                                `;
                                orderProductGrid.appendChild(tr);
                            });
                            calculateTongTien(); // Cập nhật tổng tiền khi render lại grid
                        }
                        // Xóa sản phẩm khỏi grid
                        window.removeOrderProduct = function(idx) {
                            orderProductList.splice(idx, 1);
                            renderOrderProductGrid();
                        }
                        // ================== END SẢN PHẨM ==================
                        </script>
                    </div>
                </div>
            </div>
            <script>
                // Hiển thị popup Thêm hóa đơn
                document.getElementById('showAddOrderBtn').onclick = function () {
                    // Sinh mã đơn hàng tự động theo chuẩn ddMMyyyyHHmmss
                    const now = new Date();
                    const pad = n => n.toString().padStart(2, '0');
                    const code = pad(now.getDate()) + pad(now.getMonth() + 1) + now.getFullYear() + pad(now.getHours()) + pad(now.getMinutes()) + pad(now.getSeconds());
                    document.getElementById('addMaDonHang').value = code;
                    document.getElementById('addOrderModal').style.display = 'flex';
                    // Luôn chọn trạng thái là Đã thanh toán khi mở popup
                    document.getElementById('addTrangThai').value = 'true';
                };
                function closeAddOrderModal() {
                    document.getElementById('addOrderModal').style.display = 'none';
                    document.getElementById('addOrderForm').reset();
                }
                // Thêm hóa đơn (AJAX demo, cần backend xử lý)
                document.getElementById('addOrderForm').onsubmit = function (e) {
                    e.preventDefault();
                    var form = e.target;
                    // Kiểm tra sản phẩm đã chọn
                    if (!orderProductList || orderProductList.length === 0) {
                        alert('Vui lòng chọn ít nhất 1 sản phẩm cho hóa đơn!');
                        return;
                    }
                    var data = {
                        MaDonHang: form.MaDonHang.value,
                        IDKhachHang: document.getElementById('addIDKhachHang').value,
                        IDNhanVien: document.getElementById('hiddenUserId').value, // Lấy GUID từ input hidden
                        IDChiNhanh: document.getElementById('hiddenBranchId').value, // Lấy GUID từ input hidden
                        MaUuDai: document.getElementById('addMaUuDai').value,
                        TienUuDai: document.getElementById('addTienUuDai').value,
                        TongTien: form.TongTien.value,
                        TrangThai: form.TrangThaiThanhToan.value === 'true',
                        SanPhamList: orderProductList.map(function(item) {
                            return {
                                IDSanPham: item.IDSanPham,
                                IDLoaiSanPham: item.IDLoaiSanPham,
                                TenSanPham: item.TenSanPham,
                                TenLoaiSanPham: item.TenLoaiSanPham,
                                DonGia: item.DonGia,
                                SoLuong: item.SoLuong || 1
                            };
                        })
                    };
                    console.log('Submitting order data:', data);
                    fetch('/Order/AddOrder', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('#antiForgeryFormOrder input[name=__RequestVerificationToken]').value
                        },
                        body: JSON.stringify(data)
                    })
                        .then(res => res.json())
                        .then(resp => {
                            if (resp.success) {
                                location.reload();
                            } else {
                                alert(resp.message || 'Thêm hóa đơn thất bại!');
                            }
                        });
                };
            </script>
            <div class="userlist-card userlist-modern">
                <div class="userlist-toolbar">
                    <div class="userlist-toolbar-left">
                        <label for="filterOrderStatus">Trạng thái:</label>
                        <select id="filterOrderStatus" class="userlist-filter" onchange="filterOrderByStatus()">
                            <option value="all">Tất cả</option>
                            <option value="paid">Đã thanh toán</option>
                            <option value="unpaid">Chưa thanh toán</option>
                        </select>
                        
                        <label for="filterDeliveryStatus" style="margin-left: 15px;">Giao hàng:</label>
                        <select id="filterDeliveryStatus" class="userlist-filter" onchange="filterOrderByDeliveryStatus()">
                            <option value="all">Tất cả</option>
                            <option value="delivered">Đã trả hàng</option>
                            <option value="not-delivered">Chưa trả hàng</option>
                        </select>
                    </div>
                    <div class="userlist-toolbar-right">
                        <label for="orderPageSize" style="font-size:15px;margin-right:8px;color:#555;">Hiển thị:</label>
                        <select id="orderPageSize" class="userlist-filter" style="width:auto;min-width:60px;"
                            onchange="changeOrderPageSize()">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <input type="text" class="userlist-search" placeholder="Tìm mã đơn, khách hàng, số bàn..." onkeyup="filterOrderList()"
                            style="margin-left:12px;" />
                    </div>
                </div>
                <div class="userlist-table-wrapper">
                    <table class="userlist-table userlist-table-modern" id="orderListTable">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã đơn hàng</th>
                                <th>Khách hàng</th>
                                <th>Số bàn</th>
                                <th>Chi nhánh</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Giao hàng</th>
                                <th>Ngày tạo</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Orders != null && Model.Orders.Count > 0)
                            {
                                int stt = 1;
                                foreach (var order in Model.Orders)
                                {
                                    var status = order.TrangThaiThanhToan ? "Đã thanh toán" : "Chưa thanh toán";
                                    <tr data-index="@stt" 
                                        data-status="@(order.TrangThaiThanhToan ? "paid" : "unpaid")" 
                                        data-delivery="@(order.TrangThaiThanhToan ? (order.DaTraDon == true ? "delivered" : "not-delivered") : "not-applicable")">
                                        <td>@stt</td>
                                        <td>
                                            <a href="javascript:void(0)" onclick="showOrderDetail('@order.ID')"
                                                style="color:#007bff;text-decoration:underline;cursor:pointer;">@order.MaDonHang</a>
                                        </td>
                                        <td>@order.KhachHang?.TenKhachHang</td>
                                        <td>@(order.SoBan?.ToString() ?? "")</td>
                                        <td>@order.ChiNhanh?.TenChiNhanh</td>
                                        <td>@order.TongTien đ</td>
                                        <td class="order-status">@status</td>
                                        <td class="delivery-status">
                                            @if (order.TrangThaiThanhToan)
                                            {
                                                @if (order.DaTraDon == true)
                                                {
                                                    <span style="color: #28a745; font-weight: bold;">Đã trả hàng</span>
                                                }
                                                else
                                                {
                                                    <span style="color: #dc3545; font-weight: bold; cursor: pointer; text-decoration: underline;" 
                                                          onclick="updateDeliveryStatus('@order.ID', true)" 
                                                          title="Click để cập nhật thành đã trả hàng">Chưa trả hàng</span>
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: #6c757d;">-</span>
                                            }
                                        </td>
                                        <td>@order.CreateTime.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @* <form method="get" action="/Order/EditOrder" style="display:inline;">
                                                <input type="hidden" name="id" value="@order.ID" />
                                                <button type="submit" class="userlist-edit-btn" title="Sửa"
                                                    style="margin-left:4px; background-color:#b6f5c6; color:#218838; border:none;">
                                                    <i class="fas fa-pen"></i>
                                                </button>
                                            </form> *@
                                            <button type="button" class="userlist-delete-btn" title="Xóa"
                                                style="margin-left:4px;" onclick="showDeleteOrderConfirm('@order.ID')">
                                                <i class="fas fa-trash"></i>
                                            </button>
            <script>
            // Popup xác nhận xóa hóa đơn (chỉ khai báo 1 lần ngoài foreach)
            let deleteOrderId = null;
            function showDeleteOrderConfirm(id) {
                deleteOrderId = id;
                document.getElementById('deleteOrderModal').style.display = 'flex';
            }
            function closeDeleteOrderModal() {
                deleteOrderId = null;
                document.getElementById('deleteOrderModal').style.display = 'none';
            }
            function confirmDeleteOrder() {
                if (!deleteOrderId) return;
                fetch('/Order/DeleteOrder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('#antiForgeryFormOrder input[name=__RequestVerificationToken]').value
                    },
                    body: JSON.stringify({ id: deleteOrderId })
                })
                .then(res => res.json())
                .then(resp => {
                    if (resp.success) {
                        location.reload();
                    } else {
                        alert(resp.message || 'Xóa hóa đơn thất bại!');
                    }
                });
            }
            </script>
                                            @if (!order.TrangThaiThanhToan)
                                            {
                                                <form method="get" action="/Order/PayOrder" style="display:inline;">
                                                    <input type="hidden" name="id" value="@order.ID" />
                                                    <button type="submit" class="userlist-pay-btn" title="Thanh toán"
                                                        style="margin-left:4px; background-color:#ffe066; color:#856404; border:none;">
                                                        <i class="fas fa-money-bill-wave"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10">Không có dữ liệu hóa đơn.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div id="orderlist-pagination"></div>
                </div>
            </div>
            <!-- Đặt popup xác nhận xóa và antiForgery ngoài bảng để không bị ẩn khi phân trang -->
            <form id="antiForgeryFormOrder" style="display:none;">
                @Html.AntiForgeryToken()
            </form>
            
            <!-- Popup chi tiết và chỉnh sửa hóa đơn -->
            <div id="orderDetailModal" class="modal"
                style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
                <div class="modal-content userlist-add-modal-content" style="max-width:800px;max-height:90vh;overflow-y:auto;">
                    <div class="userlist-add-modal-title"><i class="fas fa-file-invoice"></i> Chi tiết hóa đơn</div>
                    <form id="orderDetailForm" autocomplete="off">
                        <input type="hidden" id="detailOrderId" />
                        
                        <!-- Thông tin cơ bản -->
                        <div class="userlist-add-form-group" style="display:flex; flex-direction:row; gap:16px; align-items:flex-end;">
                            <div style="flex:1; display:flex; flex-direction:column;">
                                <label>Mã đơn hàng</label>
                                <input type="text" id="detailMaDonHang" class="userlist-input" readonly />
                            </div>
                            <div style="flex:1; display:flex; flex-direction:column;">
                                <label>Ngày tạo</label>
                                <input type="text" id="detailCreateTime" class="userlist-input" readonly />
                            </div>
                        </div>

                        <!-- Thông tin khách hàng -->
                        <div class="userlist-add-form-group" style="display:flex; flex-direction:row; gap:16px; align-items:flex-end;">
                            <div style="flex:1; display:flex; flex-direction:column;">
                                <label>Khách hàng</label>
                                <input type="text" id="detailTenKhachHang" class="userlist-input" readonly />
                            </div>
                            <div style="flex:1; display:flex; flex-direction:column;">
                                <label>Số điện thoại</label>
                                <input type="text" id="detailSdtKhachHang" class="userlist-input" readonly />
                            </div>
                        </div>

                        <!-- Thông tin nhân viên và chi nhánh -->
                        <div class="userlist-add-form-group" style="display:flex; flex-direction:row; gap:16px; align-items:flex-end;">
                            <div style="flex:1; display:flex; flex-direction:column;">
                                <label>Nhân viên</label>
                                <input type="text" id="detailTenNhanVien" class="userlist-input" readonly />
                            </div>
                            <div style="flex:1; display:flex; flex-direction:column;">
                                <label>Chi nhánh</label>
                                <input type="text" id="detailTenChiNhanh" class="userlist-input" readonly />
                            </div>
                        </div>

                        <!-- Chi tiết sản phẩm -->
                        <div class="userlist-add-form-group">
                            <label>Chi tiết sản phẩm</label>
                            <table class="userlist-table userlist-table-modern" style="width:100%;margin-top:8px;">
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Loại</th>
                                        <th>Đơn giá</th>
                                        <th>Số lượng</th>
                                        <th>Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody id="orderDetailProductGrid">
                                    <!-- Dữ liệu sẽ được thêm động -->
                                </tbody>
                            </table>
                        </div>

                        <!-- Thông tin ưu đãi và thanh toán -->
                        <div class="userlist-add-form-group" style="display:flex; flex-direction:row; gap:16px; align-items:flex-end;">
                            <div style="flex:1; display:flex; flex-direction:column;">
                                <label for="detailMaUuDai">Mã ưu đãi</label>
                                <input type="text" id="detailMaUuDai" class="userlist-input" />
                            </div>
                            <div style="flex:1; display:flex; flex-direction:column;">
                                <label for="detailTienUuDai">Tiền ưu đãi</label>
                                <input type="text" id="detailTienUuDai" class="userlist-input" />
                            </div>
                        </div>

                        <div class="userlist-add-form-group" style="display:flex; flex-direction:row; gap:16px; align-items:flex-end;">
                            <div style="flex:1; display:flex; flex-direction:column;">
                                <label for="detailTongTien">Tổng tiền</label>
                                <input type="text" id="detailTongTien" class="userlist-input" />
                            </div>
                            <div style="flex:1; display:flex; flex-direction:column;">
                                <label for="detailTrangThaiThanhToan">Trạng thái thanh toán</label>
                                <select id="detailTrangThaiThanhToan" class="userlist-input">
                                    <option value="false">Chưa thanh toán</option>
                                    <option value="true">Đã thanh toán</option>
                                </select>
                            </div>
                        </div>

                        <div class="userlist-add-modal-actions">
                            <button type="button" onclick="closeOrderDetailModal()" class="userlist-add-cancel-btn">Đóng</button>
                            <button type="submit" class="userlist-add-submit-btn">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div id="deleteOrderModal" class="modal"
                style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
                <div class="modal-content"
                    style="background:#fff;padding:32px 28px 24px 28px;border-radius:12px;box-shadow:0 2px 16px rgba(0,0,0,0.12);min-width:320px;max-width:90vw;text-align:center;">
                    <div style="font-size:20px;font-weight:600;color:#ea4335;margin-bottom:18px;"><i
                            class="fas fa-exclamation-triangle"></i> Xác nhận xóa hóa đơn</div>
                    <div style="font-size:16px;color:#333;margin-bottom:24px;">Bạn có chắc chắn muốn xóa hóa đơn này
                        không?</div>
                    <div style="display:flex;justify-content:center;gap:18px;">
                        <button onclick="confirmDeleteOrder()"
                            style="background:#ea4335;color:#fff;border:none;padding:8px 22px;border-radius:6px;font-size:15px;font-weight:500;cursor:pointer;">Xác
                            nhận</button>
                        <button onclick="closeDeleteOrderModal()"
                            style="background:#f5f7fa;color:#333;border:none;padding:8px 22px;border-radius:6px;font-size:15px;font-weight:500;cursor:pointer;">Hủy</button>
                    </div>
                </div>
            </div>
            <script>
                // PHÂN TRANG + SEARCH + FILTER HÓA ĐƠN
                let orderCurrentPage = 1;
                let orderPageSize = 10;
                let orderCurrentFilter = 'all';
                let orderCurrentDeliveryFilter = 'all';
                let orderCurrentSearch = '';

                function getAllOrderRows() {
                    return Array.from(document.querySelectorAll('#orderListTable tbody tr')).filter(function (row) {
                        return row.querySelectorAll('td').length > 1;
                    });
                }
                function getFilteredOrderRows() {
                    let rows = getAllOrderRows();
                    // Lọc theo trạng thái thanh toán
                    if (orderCurrentFilter !== 'all') {
                        rows = rows.filter(function (row) {
                            var status = row.getAttribute('data-status');
                            return status === orderCurrentFilter;
                        });
                    }
                    // Lọc theo trạng thái giao hàng (chỉ áp dụng cho đơn đã thanh toán)
                    if (orderCurrentDeliveryFilter !== 'all') {
                        rows = rows.filter(function (row) {
                            var deliveryStatus = row.getAttribute('data-delivery');
                            var paymentStatus = row.getAttribute('data-status');
                            // Chỉ lọc nếu đơn hàng đã thanh toán
                            if (paymentStatus === 'paid') {
                                return deliveryStatus === orderCurrentDeliveryFilter;
                            }
                            // Đối với đơn chưa thanh toán, không hiển thị nếu đang lọc theo delivery
                            return false;
                        });
                    }
                    // Lọc theo search
                    if (orderCurrentSearch) {
                        rows = rows.filter(function (row) {
                            var code = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
                            var customer = row.querySelector('td:nth-child(3)')?.textContent.toLowerCase() || '';
                            var tableNumber = row.querySelector('td:nth-child(4)')?.textContent.toLowerCase() || '';
                            return code.includes(orderCurrentSearch) || customer.includes(orderCurrentSearch) || tableNumber.includes(orderCurrentSearch);
                        });
                    }
                    return rows;
                }
                function renderOrderPagination() {
                    let rows = getFilteredOrderRows();
                    let total = rows.length;
                    let totalPages = Math.ceil(total / orderPageSize);
                    let pag = document.getElementById('orderlist-pagination');
                    if (!pag) return;
                    if (totalPages <= 1) {
                        pag.innerHTML = '';
                        return;
                    }
                    let html = '';
                    html += `<button onclick=\"gotoOrderPage(1)\" ${orderCurrentPage == 1 ? 'disabled' : ''}>&laquo;</button>`;
                    for (let i = 1; i <= totalPages; i++) {
                        if (i === 1 || i === totalPages || Math.abs(i - orderCurrentPage) <= 2) {
                            html += `<button onclick=\"gotoOrderPage(${i})\" ${i == orderCurrentPage ? 'class=\"active\"' : ''}>${i}</button>`;
                        } else if (i === orderCurrentPage - 3 || i === orderCurrentPage + 3) {
                            html += '<span>...</span>';
                        }
                    }
                    html += `<button onclick=\"gotoOrderPage(${totalPages})\" ${orderCurrentPage == totalPages ? 'disabled' : ''}>&raquo;</button>`;
                    pag.className = 'userlist-pagination';
                    pag.innerHTML = html;
                }
                function updateOrderPagination() {
                    let allRows = getAllOrderRows();
                    let rows = getFilteredOrderRows();
                    let total = rows.length;
                    let totalPages = Math.ceil(total / orderPageSize);
                    if (orderCurrentPage > totalPages) orderCurrentPage = totalPages || 1;
                    allRows.forEach(function (row) { row.style.display = 'none'; });
                    rows.forEach(function (row, idx) {
                        if (idx >= (orderCurrentPage - 1) * orderPageSize && idx < orderCurrentPage * orderPageSize) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                    let pag = document.getElementById('orderlist-pagination');
                    if (rows.length === 0) {
                        if (pag) pag.innerHTML = '';
                        return;
                    }
                    renderOrderPagination();
                }
                function gotoOrderPage(page) {
                    orderCurrentPage = page;
                    updateOrderPagination();
                }
                function changeOrderPageSize() {
                    orderPageSize = parseInt(document.getElementById('orderPageSize').value);
                    orderCurrentPage = 1;
                    updateOrderPagination();
                }
                function filterOrderList() {
                    orderCurrentSearch = document.querySelector('.userlist-search').value.toLowerCase();
                    orderCurrentPage = 1;
                    updateOrderPagination();
                }
                function filterOrderByStatus() {
                    orderCurrentFilter = document.getElementById('filterOrderStatus').value;
                    orderCurrentPage = 1;
                    updateOrderPagination();
                }
                
                function filterOrderByDeliveryStatus() {
                    orderCurrentDeliveryFilter = document.getElementById('filterDeliveryStatus').value;
                    orderCurrentPage = 1;
                    updateOrderPagination();
                }
                window.addEventListener('DOMContentLoaded', function () {
                    orderPageSize = parseInt(document.getElementById('orderPageSize').value) || 10;
                    setTimeout(updateOrderPagination, 0);
                });

                // Cập nhật trạng thái giao hàng
                function updateDeliveryStatus(orderId, delivered) {
                    fetch('/Order/OrderList?handler=UpdateDeliveryStatus', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('#antiForgeryFormOrder input[name=__RequestVerificationToken]').value
                        },
                        body: JSON.stringify({ 
                            OrderId: orderId, 
                            Delivered: delivered 
                        })
                    })
                    .then(res => res.json())
                    .then(response => {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message || 'Cập nhật trạng thái thất bại!');
                        }
                    })
                    .catch(err => {
                        alert('Có lỗi khi cập nhật trạng thái giao hàng');
                    });
                }

                // Hiển thị popup chi tiết hóa đơn
                function showOrderDetail(orderId) {
                    fetch(`/Order/OrderList?handler=GetOrderDetail&id=${orderId}`)
                        .then(res => res.json())
                        .then(response => {
                            if (response.success && response.data) {
                                const data = response.data;
                                
                                // Điền thông tin cơ bản
                                document.getElementById('detailOrderId').value = data.id;
                                document.getElementById('detailMaDonHang').value = data.maDonHang;
                                document.getElementById('detailCreateTime').value = data.createTime;
                                
                                // Thông tin khách hàng
                                document.getElementById('detailTenKhachHang').value = data.tenKhachHang;
                                document.getElementById('detailSdtKhachHang').value = data.sdtKhachHang;
                                
                                // Thông tin nhân viên và chi nhánh
                                document.getElementById('detailTenNhanVien').value = data.tenNhanVien;
                                document.getElementById('detailTenChiNhanh').value = data.tenChiNhanh;
                                
                                // Thông tin ưu đãi và thanh toán
                                document.getElementById('detailMaUuDai').value = data.maUuDai || '';
                                document.getElementById('detailTienUuDai').value = data.tienUuDai || '0';
                                document.getElementById('detailTongTien').value = data.tongTien || '0';
                                document.getElementById('detailTrangThaiThanhToan').value = data.trangThaiThanhToan.toString();
                                
                                // Hiển thị chi tiết sản phẩm
                                const productGrid = document.getElementById('orderDetailProductGrid');
                                productGrid.innerHTML = '';
                                if (data.chiTiet && Array.isArray(data.chiTiet)) {
                                    data.chiTiet.forEach(item => {
                                        const tr = document.createElement('tr');
                                        tr.innerHTML = `
                                            <td>${item.tenSanPham}</td>
                                            <td>${item.tenLoaiSanPham}</td>
                                            <td>${formatCurrency(item.donGia)}</td>
                                            <td>${item.soLuong}</td>
                                            <td>${formatCurrency(item.thanhTien)}</td>
                                        `;
                                        productGrid.appendChild(tr);
                                    });
                                }
                                
                                document.getElementById('orderDetailModal').style.display = 'flex';
                            } else {
                                alert(response.message || 'Không thể lấy chi tiết hóa đơn');
                            }
                        })
                        .catch(err => {
                            console.error('Error:', err);
                            alert('Có lỗi khi tải chi tiết hóa đơn');
                        });
                }

                function closeOrderDetailModal() {
                    document.getElementById('orderDetailModal').style.display = 'none';
                }

                // Cập nhật hóa đơn
                document.getElementById('orderDetailForm').addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    const orderId = document.getElementById('detailOrderId').value;
                    if (!orderId) {
                        alert('Không tìm thấy ID hóa đơn');
                        return;
                    }

                    const updateData = {
                        ID: orderId,
                        MaUuDai: document.getElementById('detailMaUuDai').value,
                        TienUuDai: document.getElementById('detailTienUuDai').value,
                        TongTien: document.getElementById('detailTongTien').value,
                        TrangThaiThanhToan: document.getElementById('detailTrangThaiThanhToan').value === 'true'
                    };

                    fetch('/Order/OrderList?handler=UpdateOrder', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('#antiForgeryFormOrder input[name=__RequestVerificationToken]').value
                        },
                        body: JSON.stringify(updateData)
                    })
                    .then(res => res.json())
                    .then(response => {
                        if (response.success) {
                            alert('Cập nhật hóa đơn thành công');
                            closeOrderDetailModal();
                            location.reload(); // Reload để cập nhật danh sách
                        } else {
                            alert(response.message || 'Cập nhật hóa đơn thất bại');
                        }
                    })
                    .catch(err => {
                        console.error('Error:', err);
                        alert('Có lỗi khi cập nhật hóa đơn');
                    });
                });
            </script>
        </main>
    </div>
    <footer class="footer">
        <div class="footer-content">
            <span>© 2025 QRB - Hệ thống quán cafe thông minh. All rights reserved.</span>
        </div>
    </footer>
</body>

