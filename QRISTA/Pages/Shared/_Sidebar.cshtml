@* Sidebar dùng chung cho QRB *@
<nav class="sidebar">
    <div class="sidebar-content">
        @{
            string currentPath = Context.Request.Path.Value?.ToLower() ?? "";
        }
        <ul class="nav-menu">
            <li class="nav-item">
                <a href="/Dashboard" class="nav-link@(currentPath == "/dashboard" ? " active" : "")">
                    <i class="fas fa-chart-bar"></i>
                    <span>Thống kê hệ thống</span>
                </a>
            </li>
            @* <li class="nav-item">
                <a href="/User/UserList" class="nav-link@(currentPath.StartsWith("/user") ? " active" : "")">
                    <i class="fas fa-users"></i>
                    <span>Quản lý người dùng</span>
                </a>
            </li> *@
            <li class="nav-item">
                <a href="/Branch/BranchList" class="nav-link@(currentPath.StartsWith("/branch") ? " active" : "")">
                    <i class="fas fa-store"></i>
                    <span>Chi nhánh</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/Order/OrderList" class="nav-link@(currentPath.StartsWith("/order/orderlist") ? " active" : "")">
                    <i class="fas fa-file-invoice"></i>
                    <span>Hóa đơn</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/Customer/CustomerList" class="nav-link@(currentPath.StartsWith("/customer") ? " active" : "")">
                    <i class="fas fa-user-friends"></i>
                    <span>Khách hàng</span>
                </a>
            </li>
            <li class="nav-item sidebar-product-parent">
                <a href="#" class="nav-link sidebar-product-toggle@(currentPath.StartsWith("/product") ? " active" : "")" onclick="toggleSidebarProductMenu(event)">
                    <i class="fas fa-box"></i>
                    <span>Sản phẩm</span>
                    <i class="fas fa-chevron-down sidebar-chevron" style="float:right;margin-top:4px;"></i>
                </a>
                <ul class="sidebar-submenu" id="sidebar-product-submenu" style="display:none;">
                    <li><a href="/ProductGroup/ProductGroupList" class="nav-link@(currentPath.StartsWith("/productgroup") ? " active" : "")">Nhóm sản phẩm</a></li>
                    <li><a href="/Product/ProductList" class="nav-link@(currentPath.StartsWith("/product/") ? " active" : "")">Sản phẩm</a></li>
                    <li><a href="/ProductType/ProductTypeList" class="nav-link@(currentPath.StartsWith("/producttype") ? " active" : "")">Loại sản phẩm</a></li>
                </ul>
            </li>
            <li class="nav-item sidebar-kho-parent">
                <a href="#" class="nav-link sidebar-kho-toggle@(currentPath.StartsWith("/nguyenlieu") || currentPath.StartsWith("/khosanpham") ? " active" : "")" onclick="toggleSidebarKhoMenu(event)">
                    <i class="fas fa-warehouse"></i>
                    <span>Quản lý kho</span>
                    <i class="fas fa-chevron-down sidebar-chevron" style="float:right;margin-top:4px;"></i>
                </a>
                <ul class="sidebar-submenu" id="sidebar-kho-submenu" style="display:none;">
                    <li><a href="/NguyenLieu/NguyenLieuList" class="nav-link@(currentPath.StartsWith("/nguyenlieu") ? " active" : "")">Nguyên liệu</a></li>
                    <li><a href="/KhoSanPham/KhoSanPhamList" class="nav-link@(currentPath.StartsWith("/khosanpham") ? " active" : "")">Kho sản phẩm</a></li>
                </ul>
            </li>
            <li class="nav-item">
                <a href="/UuDai/MaUuDaiList" class="nav-link@(currentPath.StartsWith("/uudai") ? " active" : "")">
                    <i class="fas fa-gift"></i>
                    <span>Ưu đãi</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/DeXuatMuaSam/DeXuatMuaSamList" class="nav-link@(currentPath.StartsWith("/dexuatmuasam") ? " active" : "")">
                    <i class="fas fa-file-invoice"></i>
                    <span>Đề xuất mua sắm</span>
                </a>
            </li>
            @* <li class="nav-item">
                <a href="/Authorization" class="nav-link@(currentPath.StartsWith("/authorization") ? " active" : "")">
                    <i class="fas fa-shield-alt"></i>
                    <span>Phân quyền</span>
                </a>
            </li> *@
            <li class="nav-item sidebar-authorization-parent">
                <a href="#" class="nav-link sidebar-authorization-toggle@(currentPath.StartsWith("/authorization") ? " active" : "")" onclick="toggleSidebarAuthorizationMenu(event)">
                    <i class="fas fa-shield-alt"></i>
                    <span>Phân quyền</span>
                    <i class="fas fa-chevron-down sidebar-chevron" style="float:right;margin-top:4px;"></i>
                </a>
                <ul class="sidebar-submenu" id="sidebar-authorization-submenu" style="display:none;">
                    <li><a href="/Authorization" class="nav-link@(currentPath == "/authorization" ? " active" : "")">Tổng quan</a></li>
                    <li><a href="/Authorization/Users" class="nav-link@(currentPath.StartsWith("/authorization/users") ? " active" : "")">Quản lý người dùng</a></li>
                    <li><a href="/Authorization/Roles" class="nav-link@(currentPath.StartsWith("/authorization/roles") ? " active" : "")">Quản lý vai trò</a></li>
                    <li><a href="/Authorization/Permissions" class="nav-link@(currentPath.StartsWith("/authorization/permissions") ? " active" : "")">Ma trận phân quyền</a></li>
                </ul>
            </li>
        </ul>
    </div>
</nav>
<style>
    .sidebar-submenu {
        padding-left: 24px;
        margin: 0;
        list-style: none;
    }
    .sidebar-submenu li {
        margin: 2px 0;
    }
    .sidebar-submenu .nav-link {
        font-weight: 400 !important;
        font-size: 1rem;
        color: #333;
        background: none;
        padding-left: 0;
        border-radius: 4px;
        transition: background 0.15s, color 0.15s;
    }
    .sidebar-submenu .nav-link.active,
    .sidebar-submenu .nav-link:focus,
    .sidebar-submenu .nav-link:hover {
        color: #1976d2;
        background: #e3f2fd;
        font-weight: 500 !important;
        outline: none;
        text-decoration: none;
    }
    .sidebar-product-toggle {
        font-weight: 600;
    }
    .sidebar-authorization-toggle {
        font-weight: 600;
    }
</style>
<script>
function toggleSidebarProductMenu(e) {
    e.preventDefault();
    var submenu = document.getElementById('sidebar-product-submenu');
    if (submenu.style.display === 'none' || submenu.style.display === '') {
        submenu.style.display = 'block';
    } else {
        submenu.style.display = 'none';
    }
}
function toggleSidebarAuthorizationMenu(e) {
    e.preventDefault();
    var submenu = document.getElementById('sidebar-authorization-submenu');
    if (submenu.style.display === 'none' || submenu.style.display === '') {
        submenu.style.display = 'block';
    } else {
        submenu.style.display = 'none';
    }
}

function toggleSidebarKhoMenu(e) {
    e.preventDefault();
    var submenu = document.getElementById('sidebar-kho-submenu');
    if (submenu.style.display === 'none' || submenu.style.display === '') {
        submenu.style.display = 'block';
    } else {
        submenu.style.display = 'none';
    }
}
</script>
