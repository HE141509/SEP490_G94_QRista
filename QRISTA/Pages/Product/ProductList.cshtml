@page
@model QRB.Pages.Product.ProductListModel
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/userlist.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        /* Validation Error Styles */
        .validation-error {
            border: 2px solid #e74c3c !important;
            box-shadow: 0 0 8px rgba(231, 76, 60, 0.3) !important;
            background-color: #fdf2f2 !important;
        }
        
        .validation-error:focus {
            border-color: #e74c3c !important;
            box-shadow: 0 0 12px rgba(231, 76, 60, 0.4) !important;
            outline: none !important;
        }
        
        .error-message {
            color: #e74c3c;
            font-size: 13px;
            margin-top: 4px;
            display: block;
            font-weight: 500;
        }
        
        .userlist-add-form-group {
            position: relative;
        }
        
        /* Smooth transitions for validation states */
        .userlist-input {
            transition: border-color 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
        }
    </style>
</head>
<body>
    @await Html.PartialAsync("~/Pages/Shared/_Header.cshtml", Model)
    <div class="main-container">
        @await Html.PartialAsync("~/Pages/Shared/_Sidebar.cshtml", Model)
        <main class="main-content">
            <div class="dashboard-header userlist-header-flex">
                <h1 class="page-title">Danh sách sản phẩm</h1>
                <button class="userlist-add-btn" type="button">
                    <i class="fas fa-plus"></i> Thêm mới
                </button>
                <div id="addProductModal" class="modal" style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
                    <div class="modal-content userlist-add-modal-content">
                        <div class="userlist-add-modal-title"><i class="fas fa-box"></i> Thêm sản phẩm mới</div>
                        <form id="addProductForm" autocomplete="off">
                            <div class="userlist-add-form-group">
                                <label for="addMaSanPham">Mã sản phẩm <span style="color: #e74c3c;">*</span></label>
                                <input type="text" id="addMaSanPham" name="MaSanPham" class="userlist-input" required />
                            </div>
                            <div class="userlist-add-form-group">
                                <label for="addTenSanPham">Tên sản phẩm <span style="color: #e74c3c;">*</span></label>
                                <input type="text" id="addTenSanPham" name="TenSanPham" class="userlist-input" required />
                            </div>
                            <div class="userlist-add-form-group">
                                <label for="addHinhAnh">Hình ảnh</label>
                                <input type="file" id="addHinhAnh" name="HinhAnh" class="userlist-input" accept=".jpg,.jpeg,.png,.gif,.bmp,.webp" />
                                <small style="color: #666; font-size: 12px; margin-top: 4px; display: block;">
                                    Chỉ chấp nhận file hình ảnh: JPG, JPEG, PNG, GIF, BMP, WebP
                                </small>
                            </div>
                            <div class="userlist-add-form-group">
                                <label for="addNoiDung">Nội dung mô tả</label>
                                <textarea id="addNoiDung" name="NoiDung" class="userlist-input" rows="4" placeholder="Nhập mô tả chi tiết về sản phẩm..."></textarea>
                            </div>
                            <div class="userlist-add-form-group">
                                <label for="addIdCategory">Nhóm sản phẩm <span style="color: #e74c3c;">*</span></label>
                                <select id="addIdCategory" name="IdCategory" class="userlist-input" required>
                                    <option value="">-- Chọn nhóm sản phẩm --</option>
                                    @foreach (var c in Model.Categories)
                                    {
                                        <option value="@c.ID">@c.CategoryName</option>
                                    }
                                </select>
                            </div>
                            <div class="userlist-add-form-group">
                                <label for="addIDChiNhanh">Chi nhánh <span style="color: #e74c3c;">*</span></label>
                                <select id="addIDChiNhanh" name="IDChiNhanh" class="userlist-input" required>
                                    <option value="">-- Chọn chi nhánh --</option>
                                    @foreach (var cn in Model.ChiNhanhs)
                                    {
                                        <option value="@cn.ID">@cn.TenChiNhanh</option>
                                    }
                                </select>
                            </div>
                            <div class="userlist-add-form-group">
                                <label for="addIsDelete">Trạng thái</label>
                                <select id="addIsDelete" name="IsDelete" class="userlist-input">
                                    <option value="false">Đang kinh doanh</option>
                                    <option value="true">Ngừng kinh doanh</option>
                                </select>
                            </div>
                            <div class="userlist-add-modal-actions">
                                <button type="button" onclick="closeAddProductModal()" class="userlist-add-cancel-btn">Hủy</button>
                                <button type="submit" class="userlist-add-submit-btn">Thêm mới</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="userlist-card userlist-modern">
                <div class="userlist-toolbar">
                    <div class="userlist-toolbar-left">
                        <label for="filterProductStatus">Trạng thái:</label>
                        <select id="filterProductStatus" class="userlist-filter" onchange="filterProductByStatus()">
                            <option value="active">Đang kinh doanh</option>
                            <option value="inactive">Ngừng kinh doanh</option>
                        </select>
                    </div>
                    <div class="userlist-toolbar-right">
                        <label for="productPageSize" style="font-size:15px;margin-right:8px;color:#555;">Hiển thị:</label>
                        <select id="productPageSize" class="userlist-filter" style="width:auto;min-width:60px;" onchange="changeProductPageSize()">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <div style="display:inline-block;position:relative;margin-left:12px;">
                            <input type="text" id="productSearchInput" class="userlist-search" placeholder="Tìm theo tên hoặc mã sản phẩm..." onkeyup="filterProductList()" style="width:250px;padding-right:30px;" />
                            <button type="button" onclick="clearProductSearch()" id="clearSearchBtn" style="position:absolute;right:5px;top:50%;transform:translateY(-50%);border:none;background:none;color:#999;cursor:pointer;display:none;">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="userlist-table-wrapper">
                    <table class="userlist-table userlist-table-modern" id="productListTable">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã sản phẩm</th>
                                <th>Tên sản phẩm</th>
                                <th>Hình ảnh</th>
                                <th>Nhóm sản phẩm</th>
                                <th>Chi nhánh</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th>Ngày cập nhật</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.SanPhams != null && Model.SanPhams.Count > 0)
                        {
                            int stt = 1;
                            foreach (var sp in Model.SanPhams)
                            {
                                var status = sp.IsDelete ? "Ngừng kinh doanh" : "Đang kinh doanh";
                                <tr data-index="@stt" data-status="@(sp.IsDelete ? "inactive" : "active")">
                                    <td>@stt</td>
                                    <td>@sp.MaSanPham</td>
                                    <td>
                                        <span style="cursor:pointer;color:#4285f4;text-decoration:underline;" 
                                              onclick="showEditProductModal(this)"
                                              data-id="@sp.ID"
                                              data-ma-san-pham="@sp.MaSanPham"
                                              data-ten-san-pham="@sp.TenSanPham"
                                              data-category-id="@sp.IdCategory"
                                              data-id-chi-nhanh="@sp.IDChiNhanh"
                                              data-is-delete="@sp.IsDelete"
                                              data-category-name="@sp.CategoryName"
                                              data-ten-chi-nhanh="@sp.TenChiNhanh"
                                              data-hinh-anh="@(sp.HinhAnh != null && sp.HinhAnh.Length > 0 ? ("data:image/jpeg;base64," + Convert.ToBase64String(sp.HinhAnh)) : "")"
                                              data-noi-dung="@(sp.NoiDung ?? "")">@sp.TenSanPham</span>
                                    </td>
                                    <td style="text-align:center;">
                                        @if (sp.HinhAnh != null && sp.HinhAnh.Length > 0)
                                        {
                                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(sp.HinhAnh)" alt="Hình sản phẩm" style="width:50px;height:50px;object-fit:cover;border-radius:4px;" />
                                        }
                                        else
                                        {
                                            <span style="color:#999;font-style:italic;">Không có ảnh</span>
                                        }
                                    </td>
                                    <td>@sp.CategoryName</td>
                                    <td>@sp.TenChiNhanh</td>
                                    <td class="product-status">@status</td>
                                    <td>@sp.CreateTime.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(sp.UpdateTime?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                    <td>
                                        <button class="userlist-delete-btn" title="Xóa" onclick="showDeleteProductConfirm('@sp.ID')"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                                stt++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="10">Không có dữ liệu sản phẩm.</td></tr>
                        }
                        </tbody>
                    </table>
                    <div id="productlist-pagination"></div>
                </div>
            </div>
            <script>
            // PHÂN TRANG + SEARCH + FILTER SẢN PHẨM
            let productCurrentPage = 1;
            let productPageSize = 10;
            let productCurrentFilter = 'active';
            let productCurrentSearch = '';

            function getAllProductRows() {
                return Array.from(document.querySelectorAll('#productListTable tbody tr')).filter(function(row) {
                    return row.querySelectorAll('td').length > 1;
                });
            }
            function getFilteredProductRows() {
                let rows = getAllProductRows();
                // Lọc theo trạng thái
                rows = rows.filter(function(row) {
                    var statusCell = row.querySelector('.product-status');
                    var isActive = true;
                    if (statusCell) {
                        isActive = (statusCell.textContent.trim() === 'Đang kinh doanh');
                    }
                    if (productCurrentFilter === 'active') return isActive;
                    if (productCurrentFilter === 'inactive') return !isActive;
                });
                // Lọc theo search (tìm kiếm cả tên và mã sản phẩm)
                if (productCurrentSearch) {
                    rows = rows.filter(function(row) {
                        var productCode = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
                        var productName = row.querySelector('td:nth-child(3) span')?.textContent.toLowerCase() || '';
                        return productCode.includes(productCurrentSearch) || productName.includes(productCurrentSearch);
                    });
                }
                return rows;
            }
            function renderProductPagination() {
                let rows = getFilteredProductRows();
                let total = rows.length;
                let totalPages = Math.ceil(total / productPageSize);
                let pag = document.getElementById('productlist-pagination');
                if (!pag) return;
                if (totalPages <= 1) {
                    pag.innerHTML = '';
                    return;
                }
                let html = '';
                html += `<button onclick="gotoProductPage(1)" ${productCurrentPage==1?'disabled':''}>&laquo;</button>`;
                for (let i = 1; i <= totalPages; i++) {
                    if (i === 1 || i === totalPages || Math.abs(i-productCurrentPage)<=2) {
                        html += `<button onclick="gotoProductPage(${i})" ${i==productCurrentPage?'class="active"':''}>${i}</button>`;
                    } else if (i === productCurrentPage-3 || i === productCurrentPage+3) {
                        html += '<span>...</span>';
                    }
                }
                html += `<button onclick="gotoProductPage(${totalPages})" ${productCurrentPage==totalPages?'disabled':''}>&raquo;</button>`;
                pag.className = 'userlist-pagination';
                pag.innerHTML = html;
            }
            function updateProductPagination() {
                let allRows = getAllProductRows();
                let rows = getFilteredProductRows();
                let total = rows.length;
                let totalPages = Math.ceil(total / productPageSize);
                if (productCurrentPage > totalPages) productCurrentPage = totalPages || 1;
                allRows.forEach(function(row) { row.style.display = 'none'; });
                rows.forEach(function(row, idx) {
                    if (idx >= (productCurrentPage-1)*productPageSize && idx < productCurrentPage*productPageSize) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
                
                // Hiển thị thông báo số kết quả tìm kiếm
                updateProductSearchInfo(total, allRows.length);
                
                let pag = document.getElementById('productlist-pagination');
                if (rows.length === 0) {
                    if (pag) pag.innerHTML = '';
                    return;
                }
                renderProductPagination();
            }
            
            function updateProductSearchInfo(filteredCount, totalCount) {
                let infoDiv = document.getElementById('productSearchInfo');
                if (!infoDiv) {
                    infoDiv = document.createElement('div');
                    infoDiv.id = 'productSearchInfo';
                    infoDiv.style.cssText = 'margin: 10px 0; color: #666; font-size: 14px;';
                    document.querySelector('.userlist-table-wrapper').insertBefore(infoDiv, document.getElementById('productListTable'));
                }
                
                if (productCurrentSearch || productCurrentFilter !== 'active') {
                    if (filteredCount === 0) {
                        infoDiv.innerHTML = `<i class="fas fa-search"></i> Không tìm thấy sản phẩm nào${productCurrentSearch ? ` cho từ khóa "<strong>${productCurrentSearch}</strong>"` : ''}`;
                        infoDiv.style.color = '#ea4335';
                    } else {
                        infoDiv.innerHTML = `<i class="fas fa-info-circle"></i> Tìm thấy <strong>${filteredCount}</strong> sản phẩm${productCurrentSearch ? ` cho từ khóa "<strong>${productCurrentSearch}</strong>"` : ''} (tổng ${totalCount} sản phẩm)`;
                        infoDiv.style.color = '#1a73e8';
                    }
                } else {
                    infoDiv.innerHTML = `<i class="fas fa-list"></i> Hiển thị <strong>${filteredCount}</strong> sản phẩm`;
                    infoDiv.style.color = '#666';
                }
            }
            function gotoProductPage(page) {
                productCurrentPage = page;
                updateProductPagination();
            }
            function changeProductPageSize() {
                productPageSize = parseInt(document.getElementById('productPageSize').value);
                productCurrentPage = 1;
                updateProductPagination();
            }
            function filterProductList() {
                productCurrentSearch = document.getElementById('productSearchInput').value.toLowerCase();
                productCurrentPage = 1;
                
                // Show/hide clear button
                let clearBtn = document.getElementById('clearSearchBtn');
                if (productCurrentSearch) {
                    clearBtn.style.display = 'block';
                } else {
                    clearBtn.style.display = 'none';
                }
                
                updateProductPagination();
            }
            
            function clearProductSearch() {
                document.getElementById('productSearchInput').value = '';
                document.getElementById('clearSearchBtn').style.display = 'none';
                productCurrentSearch = '';
                productCurrentPage = 1;
                updateProductPagination();
            }
            function filterProductByStatus() {
                productCurrentFilter = document.getElementById('filterProductStatus').value;
                productCurrentPage = 1;
                updateProductPagination();
            }
            window.addEventListener('DOMContentLoaded', function() {
                productPageSize = parseInt(document.getElementById('productPageSize').value) || 10;
                setTimeout(updateProductPagination, 0);
                
                // Add real-time validation for Add form
                const addMaSanPham = document.getElementById('addMaSanPham');
                const addTenSanPham = document.getElementById('addTenSanPham');
                const addIdCategory = document.getElementById('addIdCategory');
                const addIDChiNhanh = document.getElementById('addIDChiNhanh');
                
                if (addMaSanPham) {
                    addMaSanPham.addEventListener('blur', function() {
                        validateField(this, 'Mã sản phẩm không được để trống');
                    });
                    addMaSanPham.addEventListener('input', function() {
                        if (this.value.trim()) {
                            clearValidationErrors(this);
                        }
                    });
                }
                
                if (addTenSanPham) {
                    addTenSanPham.addEventListener('blur', function() {
                        validateField(this, 'Tên sản phẩm không được để trống');
                    });
                    addTenSanPham.addEventListener('input', function() {
                        if (this.value.trim()) {
                            clearValidationErrors(this);
                        }
                    });
                }
                
                if (addIdCategory) {
                    addIdCategory.addEventListener('blur', function() {
                        validateField(this, 'Vui lòng chọn nhóm sản phẩm');
                    });
                    addIdCategory.addEventListener('change', function() {
                        if (this.value.trim()) {
                            clearValidationErrors(this);
                        }
                    });
                }
                
                if (addIDChiNhanh) {
                    addIDChiNhanh.addEventListener('blur', function() {
                        validateField(this, 'Vui lòng chọn chi nhánh');
                    });
                    addIDChiNhanh.addEventListener('change', function() {
                        if (this.value.trim()) {
                            clearValidationErrors(this);
                        }
                    });
                }
                
                // Add real-time validation for Edit form
                const editTenSanPham = document.getElementById('editTenSanPham');
                
                if (editTenSanPham) {
                    editTenSanPham.addEventListener('blur', function() {
                        validateField(this, 'Tên sản phẩm không được để trống');
                    });
                    editTenSanPham.addEventListener('input', function() {
                        if (this.value.trim()) {
                            clearValidationErrors(this);
                        }
                    });
                }
                
                // Add file validation for image inputs
                const addHinhAnh = document.getElementById('addHinhAnh');
                const editHinhAnh = document.getElementById('editHinhAnh');
                
                if (addHinhAnh) {
                    addHinhAnh.addEventListener('change', function() {
                        validateImageFile(this);
                    });
                }
                
                if (editHinhAnh) {
                    editHinhAnh.addEventListener('change', function() {
                        validateImageFile(this);
                    });
                }
            });
            </script>
            <form id="antiForgeryForm" style="display:none;">
                @Html.AntiForgeryToken()
            </form>
            <div id="deleteProductModal" class="modal" style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
                <div class="modal-content" style="background:#fff;padding:32px 28px 24px 28px;border-radius:12px;box-shadow:0 2px 16px rgba(0,0,0,0.12);min-width:320px;max-width:90vw;text-align:center;">
                    <div style="font-size:20px;font-weight:600;color:#ea4335;margin-bottom:18px;"><i class="fas fa-exclamation-triangle"></i> Xác nhận xóa sản phẩm</div>
                    <div style="font-size:16px;color:#333;margin-bottom:24px;">Bạn có chắc chắn muốn xóa sản phẩm này không?</div>
                    <div style="display:flex;justify-content:center;gap:18px;">
                        <button onclick="confirmDeleteProduct()" style="background:#ea4335;color:#fff;border:none;padding:8px 22px;border-radius:6px;font-size:15px;font-weight:500;cursor:pointer;">Xác nhận</button>
                        <button onclick="closeDeleteProductModal()" style="background:#f5f7fa;color:#333;border:none;padding:8px 22px;border-radius:6px;font-size:15px;font-weight:500;cursor:pointer;">Hủy</button>
                    </div>
                </div>
            </div>
            <div id="editProductModal" class="modal" style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
                <div class="modal-content userlist-add-modal-content">
                    <div class="userlist-add-modal-title"><i class="fas fa-box"></i> Sửa sản phẩm</div>
                    <form id="editProductForm" autocomplete="off">
                        <input type="hidden" id="editProductId" name="ID" />
                        <div class="userlist-add-form-group">
                            <label for="editMaSanPham">Mã sản phẩm</label>
                            <input type="text" id="editMaSanPham" name="MaSanPham" class="userlist-input" required readonly style="background:#f5f7fa;cursor:not-allowed;" />
                        </div>
                        <div class="userlist-add-form-group">
                            <label for="editTenSanPham">Tên sản phẩm <span style="color: #e74c3c;">*</span></label>
                            <input type="text" id="editTenSanPham" name="TenSanPham" class="userlist-input" required />
                        </div>
                        <div class="userlist-add-form-group">
                            <label>Hình ảnh hiện tại</label>
                            <div id="editCurrentImage" style="text-align:center;padding:10px;border:1px dashed #ddd;border-radius:4px;">
                                <span style="color:#999;">Không có ảnh</span>
                            </div>
                            <label for="editHinhAnh" style="margin-top:8px;">Chọn ảnh mới (tùy chọn)</label>
                            <input type="file" id="editHinhAnh" name="HinhAnh" class="userlist-input" accept=".jpg,.jpeg,.png,.gif,.bmp,.webp" />
                            <small style="color: #666; font-size: 12px; margin-top: 4px; display: block;">
                                Chỉ chấp nhận file hình ảnh: JPG, JPEG, PNG, GIF, BMP, WebP
                            </small>
                        </div>
                        <div class="userlist-add-form-group">
                            <label for="editNoiDung">Nội dung mô tả</label>
                            <textarea id="editNoiDung" name="NoiDung" class="userlist-input" rows="4" placeholder="Nhập mô tả chi tiết về sản phẩm..."></textarea>
                        </div>
                            <div class="userlist-add-form-group">
                            <label for="editIdCategory">Nhóm sản phẩm</label>
                            <input type="text" id="editIdCategory" name="IdCategory" class="userlist-input" readonly style="background:#f5f7fa;cursor:not-allowed;" />
                        </div>
                        <div class="userlist-add-form-group">
                            <label for="editIDChiNhanh">Chi nhánh</label>
                            <input type="text" id="editIDChiNhanh" name="IDChiNhanh" class="userlist-input" readonly style="background:#f5f7fa;cursor:not-allowed;" />
                        </div>
                        <div class="userlist-add-form-group">
                            <label for="editIsDelete">Trạng thái</label>
                            <select id="editIsDelete" name="IsDelete" class="userlist-input">
                                <option value="false">Đang kinh doanh</option>
                                <option value="true">Ngừng kinh doanh</option>
                            </select>
                        </div>
                        <div class="userlist-add-modal-actions">
                            <button type="button" onclick="closeEditProductModal()" class="userlist-add-cancel-btn">Hủy</button>
                            <button type="submit" class="userlist-add-submit-btn">Lưu</button>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>
    <footer class="footer">
        <div class="footer-content">
            <span>© 2025 QRB - Hệ thống quán cafe thông minh. All rights reserved.</span>
        </div>
    </footer>
    <script>
        // Hiển thị popup Thêm sản phẩm
        document.querySelector('.userlist-add-btn').onclick = function() {
            document.getElementById('addProductModal').style.display = 'flex';
        };
        function closeAddProductModal() {
            document.getElementById('addProductModal').style.display = 'none';
            document.getElementById('addProductForm').reset();
            
            // Clear all validation errors
            const form = document.getElementById('addProductForm');
            const inputs = form.querySelectorAll('.userlist-input');
            inputs.forEach(input => {
                clearValidationErrors(input);
            });
        }

        // Hiển thị popup Sửa sản phẩm
    let currentEditIdCategory = '';
        let currentEditIDChiNhanh = '';
        function showEditProductModal(element) {
            var id = element.getAttribute('data-id');
            var maSanPham = element.getAttribute('data-ma-san-pham');
            var tenSanPham = element.getAttribute('data-ten-san-pham');
            var idNhomSanPham = element.getAttribute('data-category-id');
            var idChiNhanh = element.getAttribute('data-id-chi-nhanh');
            var isDelete = element.getAttribute('data-is-delete');
            var tenNhom = element.getAttribute('data-category-name');
            var tenChiNhanh = element.getAttribute('data-ten-chi-nhanh');
            var hinhAnhBase64 = element.getAttribute('data-hinh-anh');
            var noiDung = element.getAttribute('data-noi-dung');
            
            document.getElementById('editProductId').value = id;
            document.getElementById('editMaSanPham').value = maSanPham;
            document.getElementById('editTenSanPham').value = tenSanPham;
            document.getElementById('editNoiDung').value = noiDung || '';
            
            // Lưu ID thực để gửi khi submit
            currentEditIdCategory = idNhomSanPham;
            currentEditIDChiNhanh = idChiNhanh;
            
            // Hiển thị tên trực tiếp (không cần tra cứu)
            document.getElementById('editIdCategory').value = tenNhom || '';
            document.getElementById('editIDChiNhanh').value = tenChiNhanh || '';
            
            document.getElementById('editIsDelete').value = (isDelete === 'True' || isDelete === 'true' || isDelete === true) ? 'true' : 'false';
            // Hiển thị ảnh hiện tại
            var imgDiv = document.getElementById('editCurrentImage');
            if (hinhAnhBase64 && hinhAnhBase64.startsWith('data:image')) {
                imgDiv.innerHTML = '<img src="' + hinhAnhBase64 + '" style="max-width:120px;max-height:120px;border-radius:6px;object-fit:cover;" />';
            } else {
                imgDiv.innerHTML = '<span style="color:#999;">Không có ảnh</span>';
            }
            document.getElementById('editProductModal').style.display = 'flex';
        }
        function closeEditProductModal() {
            document.getElementById('editProductModal').style.display = 'none';
            document.getElementById('editProductForm').reset();
            
            // Clear all validation errors
            const form = document.getElementById('editProductForm');
            const inputs = form.querySelectorAll('.userlist-input');
            inputs.forEach(input => {
                clearValidationErrors(input);
            });
        }

        // Hiển thị popup Xóa sản phẩm
        let deleteProductId = null;
        function showDeleteProductConfirm(id) {
            deleteProductId = id;
            document.getElementById('deleteProductModal').style.display = 'flex';
        }
        function closeDeleteProductModal() {
            deleteProductId = null;
            document.getElementById('deleteProductModal').style.display = 'none';
        }

        // Thêm sản phẩm (AJAX)
        document.getElementById('addProductForm').onsubmit = function(e) {
            e.preventDefault();
            
            // Validate form before submission
            if (!validateAddForm()) {
                return false;
            }
            
            var form = e.target;
            var formData = new FormData();
            
            formData.append('maSanPham', form.MaSanPham.value);
            formData.append('tenSanPham', form.TenSanPham.value);
            formData.append('noiDung', form.NoiDung.value);
            formData.append('nhomSanPhamID', form.IdCategory.value);
            formData.append('chiNhanhID', form.IDChiNhanh.value);
            formData.append('isDelete', form.IsDelete.value);
            
            // Thêm file ảnh nếu có
            if (form.HinhAnh.files.length > 0) {
                formData.append('hinhAnh', form.HinhAnh.files[0]);
            }
            
            fetch('/Product/AddProduct', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('#antiForgeryForm input[name=__RequestVerificationToken]').value
                },
                body: formData
            })
            .then(res => res.json())
            .then(resp => {
                if (resp.success) {
                    location.reload();
                } else {
                    alert(resp.message || 'Thêm sản phẩm thất bại!');
                }
            });
        };

        // Sửa sản phẩm (AJAX)
        document.getElementById('editProductForm').onsubmit = function(e) {
            e.preventDefault();
            
            // Validate form before submission
            if (!validateEditForm()) {
                return false;
            }
            
            var form = e.target;
            var formData = new FormData();
            
            formData.append('idSanPham', form.ID.value);
            formData.append('maSanPham', form.MaSanPham.value);
            formData.append('tenSanPham', form.TenSanPham.value);
            formData.append('noiDung', form.NoiDung.value);
            formData.append('nhomSanPhamID', currentEditIdCategory);
            formData.append('chiNhanhID', currentEditIDChiNhanh);
            formData.append('isDelete', form.IsDelete.value);
            
            // Thêm file ảnh nếu có
            if (form.HinhAnh.files.length > 0) {
                formData.append('hinhAnh', form.HinhAnh.files[0]);
            }
            
            fetch('/Product/UpdateProduct', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('#antiForgeryForm input[name=__RequestVerificationToken]').value
                },
                body: formData
            })
            .then(res => res.json())
            .then(resp => {
                if (resp.success) {
                    location.reload();
                } else {
                    alert(resp.message || 'Cập nhật sản phẩm thất bại!');
                }
            });
        };

        // Xóa sản phẩm (AJAX)
        function confirmDeleteProduct() {
            if (!deleteProductId) return;
            fetch('/Product/DeleteProduct', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('#antiForgeryForm input[name=__RequestVerificationToken]').value
                },
                body: JSON.stringify({ id: deleteProductId })
            })
            .then(res => res.json())
            .then(resp => {
                if (resp.success) {
                    location.reload();
                } else {
                    alert(resp.message || 'Xóa sản phẩm thất bại!');
                }
            });
        }

        // Validation Functions
        function validateField(field, errorMessage) {
            const value = field.value.trim();
            const isValid = value !== '';
            
            // Remove existing error styling and messages
            clearValidationErrors(field);
            
            if (!isValid) {
                // Add error styling
                field.classList.add('validation-error');
                
                // Add error message
                const errorElement = document.createElement('span');
                errorElement.className = 'error-message';
                errorElement.textContent = errorMessage;
                field.parentNode.appendChild(errorElement);
                
                return false;
            }
            
            return true;
        }

        function clearValidationErrors(field) {
            // Remove error styling
            field.classList.remove('validation-error');
            
            // Remove error message
            const errorMessage = field.parentNode.querySelector('.error-message');
            if (errorMessage) {
                errorMessage.remove();
            }
        }

        // Image File Validation Function
        function validateImageFile(fileInput) {
            const allowedExtensions = ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp'];
            const allowedMimeTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/bmp', 'image/webp'];
            const maxFileSize = 5 * 1024 * 1024; // 5MB
            
            if (fileInput.files.length === 0) {
                return true; // File is optional
            }
            
            const file = fileInput.files[0];
            const fileName = file.name.toLowerCase();
            const fileExtension = fileName.substring(fileName.lastIndexOf('.'));
            
            // Check file extension
            if (!allowedExtensions.includes(fileExtension)) {
                clearValidationErrors(fileInput);
                fileInput.classList.add('validation-error');
                const errorElement = document.createElement('span');
                errorElement.className = 'error-message';
                errorElement.textContent = 'Chỉ chấp nhận file hình ảnh: JPG, JPEG, PNG, GIF, BMP, WebP';
                fileInput.parentNode.appendChild(errorElement);
                fileInput.value = ''; // Clear the invalid file
                return false;
            }
            
            // Check MIME type
            if (!allowedMimeTypes.includes(file.type)) {
                clearValidationErrors(fileInput);
                fileInput.classList.add('validation-error');
                const errorElement = document.createElement('span');
                errorElement.className = 'error-message';
                errorElement.textContent = 'File không đúng định dạng hình ảnh';
                fileInput.parentNode.appendChild(errorElement);
                fileInput.value = ''; // Clear the invalid file
                return false;
            }
            
            // Check file size
            if (file.size > maxFileSize) {
                clearValidationErrors(fileInput);
                fileInput.classList.add('validation-error');
                const errorElement = document.createElement('span');
                errorElement.className = 'error-message';
                errorElement.textContent = 'Kích thước file không được vượt quá 5MB';
                fileInput.parentNode.appendChild(errorElement);
                fileInput.value = ''; // Clear the invalid file
                return false;
            }
            
            // If validation passes, clear any existing errors
            clearValidationErrors(fileInput);
            return true;
        }

        function validateAddForm() {
            let isValid = true;
            
            // Validate required fields
            const maSanPham = document.getElementById('addMaSanPham');
            const tenSanPham = document.getElementById('addTenSanPham');
            const idCategory = document.getElementById('addIdCategory');
            const idChiNhanh = document.getElementById('addIDChiNhanh');
            
            if (!validateField(maSanPham, 'Mã sản phẩm không được để trống')) {
                isValid = false;
            }
            
            if (!validateField(tenSanPham, 'Tên sản phẩm không được để trống')) {
                isValid = false;
            }
            
            if (!validateField(idCategory, 'Vui lòng chọn nhóm sản phẩm')) {
                isValid = false;
            }
            
            if (!validateField(idChiNhanh, 'Vui lòng chọn chi nhánh')) {
                isValid = false;
            }
            
            return isValid;
        }

        function validateEditForm() {
            let isValid = true;
            
            // Validate required fields (MaSanPham is readonly, so skip it)
            const tenSanPham = document.getElementById('editTenSanPham');
            
            if (!validateField(tenSanPham, 'Tên sản phẩm không được để trống')) {
                isValid = false;
            }
            
            return isValid;
        }
    </script>
</body>
</html>
