@page
@model QRB.Pages.Statistics.EmployeeSalesModel
@{
    ViewData["Title"] = "QRB - Thống kê doanh số nhân viên";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/dashboard.css?v=@DateTime.Now.Ticks" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .page-title-box {
            padding: 20px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }
        .stats-overview-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        .employee-sales-table {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .table-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 20px;
        }
    </style>
</head>
<body>
    <!-- Header -->
    @await Html.PartialAsync("~/Pages/Shared/_Header.cshtml", Model)

<div class="main-container">
    <!-- Sidebar -->
    @await Html.PartialAsync("~/Pages/Shared/_Sidebar.cshtml")

    <!-- Main Content -->
    <main class="main-content">
        <div class="dashboard-header">
            <h1 class="page-title">
                <i class="fas fa-chart-bar me-2"></i>
                Thống kê doanh số nhân viên
            </h1>
            <div class="breadcrumb-nav">
                <span><a href="/Dashboard">Thống kê</a></span>
                <i class="fas fa-chevron-right"></i>
                <span class="current">Doanh số nhân viên</span>
            </div>
        </div>

      @*   <!-- Stats Cards Header -->
        <div class="stats-header">
            <div class="stats-card stats-card-primary">
                <div class="stats-icon">
                    <i class="fas fa-chart-bar"></i>
                </div>
                <div class="stats-content">
                    <h3>Thống kê doanh số nhân viên</h3>
                    <p>Từ @Model.FromDate?.ToString("dd/MM/yyyy") đến @Model.ToDate?.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
        </div> *@

    <!-- Thống kê tổng quan -->
    @if (Model.EmployeeSales?.Any() == true)
    {
        <div class="row overview-stats">
            <div class="col-md-3">
                <div class="card overview-card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between w-100">
                            <div>
                                <h6>Tổng nhân viên</h6>
                                <h4>@Model.EmployeeSales.Count</h4>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-users fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card overview-card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between w-100">
                            <div>
                                <h6>Tổng đơn hàng</h6>
                                <h4>@Model.EmployeeSales.Sum(x => x.OrderCount)</h4>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-shopping-cart fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card overview-card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between w-100">
                            <div>
                                <h6>Doanh thu</h6>
                                <h4>@Model.EmployeeSales.Sum(x => x.TotalAmount).ToString("#,##0")</h4>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-dollar-sign fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card overview-card bg-warning">
                    <div class="card-body">
                        <div class="d-flex justify-content-between w-100">
                            <div>
                                <h6>Trung bình/NV</h6>
                                <h4>
                                    @((Model.EmployeeSales.Sum(x => x.TotalAmount) / Math.Max(Model.EmployeeSales.Count, 1)).ToString("#,##0"))
                                </h4>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-calculator fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

        <!-- Date Filter Card -->
        <div class="filter-section">
            <form method="get" class="date-filter">
                <div class="date-input-group">
                    <label>Từ ngày:</label>
                    <input type="date" name="FromDate" id="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="date-input-group">
                    <label>Đến ngày:</label>
                    <input type="date" name="ToDate" id="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="date-input-group">
                    <label>Chi nhánh:</label>
                    <select name="BranchId" id="branchId" class="branch-select">
                        <option value="tatca" selected="@(string.IsNullOrEmpty(Model.BranchId) || Model.BranchId == "tatca" ? "selected" : null)">Tất cả chi nhánh</option>
                    </select>
                </div>
                <button type="submit" class="update-btn">
                    <i class="fas fa-sync-alt"></i>
                    Cập nhật
                </button>
            </form>
        </div>

    <!-- Bảng thống kê -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="table-header">
                    <h5 class="mb-0">
                        <i class="fas fa-table me-2"></i>
                        Doanh số nhân viên từ @Model.FromDate?.ToString("dd/MM/yyyy") đến @Model.ToDate?.ToString("dd/MM/yyyy")
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.EmployeeSales?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th width="60">STT</th>
                                        <th>Tên nhân viên</th>
                                        <th>Chi nhánh</th>
                                        <th width="120" class="text-end">Số đơn</th>
                                        <th width="150" class="text-end">Tổng tiền bán</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.EmployeeSales.Count; i++)
                                    {
                                        var employee = Model.EmployeeSales[i];
                                        <tr>
                                            <td class="text-center">
                                        @if (i == 0)
                                        {
                                            <span class="badge bg-warning text-dark fs-6">
                                                <i class="fas fa-crown"></i> @(i + 1)
                                            </span>
                                        }
                                        else if (i == 1)
                                        {
                                            <span class="badge bg-info fs-6">
                                                <i class="fas fa-medal"></i> @(i + 1)
                                            </span>
                                        }
                                        else if (i == 2)
                                        {
                                            <span class="badge bg-success fs-6">
                                                <i class="fas fa-award"></i> @(i + 1)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary fs-6">@(i + 1)</span>
                                        }
                                            </td>
                                            <td>
                                                <i class="fas fa-user-circle text-primary me-2"></i>
                                                @employee.EmployeeName
                                            </td>
                                            <td>
                                                <i class="fas fa-building text-info me-2"></i>
                                                @employee.DepartmentName
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-info">@employee.OrderCount đơn</span>
                                            </td>
                                            <td class="text-end">
                                                <strong class="text-success">
                                                    @employee.TotalAmount.ToString("#,##0") VNĐ
                                                </strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th colspan="3" class="text-end">Tổng cộng:</th>
                                        <th class="text-end">
                                            <span class="badge bg-primary fs-6">
                                                @Model.EmployeeSales.Sum(x => x.OrderCount) đơn
                                            </span>
                                        </th>
                                        <th class="text-end">
                                            <strong class="text-success fs-5">
                                                @Model.EmployeeSales.Sum(x => x.TotalAmount).ToString("#,##0") VNĐ
                                            </strong>
                                        </th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-chart-line fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Không có dữ liệu doanh số</h5>
                            <p class="text-muted">Không có nhân viên nào có doanh số trong khoảng thời gian đã chọn.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function resetFilters() {
    document.getElementById('fromDate').value = '@DateTime.Today.ToString("yyyy-MM-dd")';
    document.getElementById('toDate').value = '@DateTime.Today.ToString("yyyy-MM-dd")';
    document.getElementById('branchId').selectedIndex = 0;
}

// Auto submit form when date changes
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('.date-filter');
    const fromDate = document.getElementById('fromDate');
    const toDate = document.getElementById('toDate');
    
    if (fromDate && toDate) {
        fromDate.addEventListener('change', function() {
            if (this.value && toDate.value) {
                form.submit();
            }
        });
        
        toDate.addEventListener('change', function() {
            if (this.value && fromDate.value) {
                form.submit();
            }
        });
    }
});
</script>

<style>
.main-content {
    padding: 20px;
}

.dashboard-header {
    margin-bottom: 30px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.page-title {
    color: #2c3e50;
    font-weight: 600;
    margin: 0;
}

.breadcrumb-nav {
    margin-top: 5px;
    color: #6c757d;
    font-size: 14px;
}

.breadcrumb-nav a {
    color: #007bff;
    text-decoration: none;
}

.breadcrumb-nav .current {
    color: #6c757d;
}

/* Stats Header */
.stats-header {
    margin-bottom: 30px;
}

.stats-card {
    display: flex;
    align-items: center;
    gap: 20px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 25px;
    border-radius: 16px;
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.25);
    color: white;
    margin-bottom: 20px;
}

.stats-icon {
    width: 60px;
    height: 60px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    backdrop-filter: blur(10px);
}

.stats-content h3 {
    margin: 0 0 8px 0;
    font-size: 22px;
    font-weight: 600;
}

.stats-content p {
    margin: 0;
    font-size: 14px;
    opacity: 0.9;
}

/* Date Filter Styles */
.date-filter {
    display: flex;
    gap: 25px;
    align-items: flex-end;
    background: white;
    padding: 25px;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    margin-bottom: 30px;
    border: 1px solid rgba(102, 126, 234, 0.1);
}

.date-input-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 180px;
}

.date-input-group label {
    font-weight: 600;
    color: #2c3e50;
    font-size: 14px;
    white-space: nowrap;
    margin-bottom: 2px;
}

.date-input-group input,
.date-input-group select {
    padding: 12px 16px;
    border: 2px solid #e9ecef;
    border-radius: 8px;
    font-size: 14px;
    transition: border-color 0.3s ease;
    height: 48px;
    box-sizing: border-box;
    width: 100%;
}

.date-input-group input:focus,
.date-input-group select:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

/* Branch select sẽ inherit từ .date-input-group select styles */

.update-btn {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    padding: 14px 28px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    height: 48px;
    min-width: 120px;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.update-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
}

.card {
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    border: none;
    border-radius: 12px;
    background: white;
}

.table-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 16px 16px 0 0;
    padding: 20px 25px;
    margin: 0;
}

.table-header h5 {
    color: white !important;
    font-weight: 600;
    font-size: 18px;
}

.table th {
    border-top: none;
    font-weight: 600;
    background: rgba(102, 126, 234, 0.1);
    color: #2c3e50;
    padding: 15px;
    font-size: 14px;
    border-bottom: 2px solid rgba(102, 126, 234, 0.2);
}

.table td {
    padding: 15px;
    vertical-align: middle;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.badge {
    font-size: 0.8em;
}

.table-hover tbody tr:hover {
    background-color: rgba(102, 126, 234, 0.05);
}

.stat-card {
    transition: transform 0.2s ease;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.stat-card:hover {
    transform: translateY(-2px);
}

/* Stats Overview Cards */
.overview-stats {
    margin-top: 30px;
}

.overview-card {
    height: 140px;
    border-radius: 16px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    border: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.overview-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
}

.overview-card.bg-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
}

.overview-card.bg-success {
    background: linear-gradient(135deg, #56ab2f 0%, #a8e6cf 100%) !important;
}

.overview-card.bg-info {
    background: linear-gradient(135deg, #3ca55c 0%, #b5fffc 100%) !important;
}

.overview-card.bg-warning {
    background: linear-gradient(135deg, #f2994a 0%, #f2c94c 100%) !important;
    color: #2c3e50 !important;
}

.overview-card .card-body {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 20px;
}

.overview-card h6 {
    margin-bottom: 8px;
    font-size: 14px;
    opacity: 0.9;
}

.overview-card h4 {
    margin-bottom: 0;
    font-weight: 700;
    font-size: 24px;
}

.table-responsive {
    border-radius: 8px;
}

.text-success {
    color: #27ae60 !important;
}

/* Responsive Design */
@@media (max-width: 768px) {
    .date-filter {
        flex-direction: column;
        gap: 15px;
    }
    
    .dashboard-header {
        flex-direction: column;
        gap: 20px;
    }
    
    .date-input-group input,
    .date-input-group select {
        min-width: auto;
        width: 100%;
    }
    
    .main-content {
        padding: 15px;
    }
}
</style>

</body>
</html>

