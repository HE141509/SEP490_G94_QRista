@page
@model QRB.Pages.DashboardModel
@{
    ViewData["Title"] = "QRB - Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/dashboard.css?v=@DateTime.Now.Ticks" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .stat-card.teal::before {
            background: linear-gradient(90deg, #14b8a6 0%, #0d9488 100%) !important;
            box-shadow: 0 2px 8px rgba(20, 184, 166, 0.3) !important;
        }
        .stat-card.teal:hover .stat-icon {
            transform: scale(1.1) !important;
            box-shadow: 0 6px 16px rgba(20, 184, 166, 0.5) !important;
        }
    </style>
</head>
<body>
    <!-- Header -->
@await Html.PartialAsync("~/Pages/Shared/_Header.cshtml", Model)

<script>
    function toggleUserDropdown(event) {
        event.stopPropagation();
        var dropdown = event.currentTarget.querySelector('.user-dropdown');
        var isVisible = dropdown.style.display === 'block';
        // Ẩn tất cả dropdown khác
        document.querySelectorAll('.user-dropdown').forEach(function(el) { el.style.display = 'none'; });
        dropdown.style.display = isVisible ? 'none' : 'block';
    }
    document.addEventListener('click', function() {
        document.querySelectorAll('.user-dropdown').forEach(function(el) { el.style.display = 'none'; });
    });
</script>
<style>
    .user-avatar.user-avatar-dropdown {
        position: relative;
        cursor: pointer;
    }
    .user-dropdown {
        position: absolute;
        top: 110%;
        right: 0;
        background: #fff;
        border: 1px solid #e0e6ed;
        border-radius: 6px;
        min-width: 140px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        z-index: 2000;
    }
    .user-dropdown .dropdown-item {
        display: block;
        padding: 10px 16px;
        color: #333;
        text-decoration: none;
        font-size: 15px;
        transition: background 0.2s;
    }
    .user-dropdown .dropdown-item:hover {
        background: #f5f7fa;
    }
</style>
            </div>
        </div>
    </header>

    <div class="main-container">
        <!-- Sidebar -->
        @await Html.PartialAsync("~/Pages/Shared/_Sidebar.cshtml")

        <!-- Main Content -->
        <main class="main-content">
            <div class="dashboard-header">
                <h1 class="page-title">Thống kê hệ thống</h1>
                <form method="get" class="date-filter">
                    <div class="date-input-group">
                        <label>Từ:</label>
                        <input type="date" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="date-input-group">
                        <label>Đến:</label>
                        <input type="date" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                    </div>
                   <div class="date-input-group">
                       <label>Chi nhánh:</label>
                       <select name="BranchId" class="branch-select">
                           <option value="tatca" selected="@(Request.Query["BranchId"] == "tatca" ? "selected" : null)">Tất cả</option>
                           @foreach (var branch in Model.Branches)
                           {
                               <option value="@branch.ID" selected="@(Request.Query["BranchId"] == branch.ID.ToString() ? "selected" : null)">@branch.TenChiNhanh</option>
                           }
                       </select>
                   </div>
                    <button type="submit" class="update-btn">
                        <i class="fas fa-sync-alt"></i>
                        Cập nhật
                    </button>
                </form>
            </div>

            <!-- Stats Cards -->
            <div class="stats-grid stats-grid-5">
                <div class="stat-card blue">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3>Số lượt người mua</h3>
                            <div class="stat-number">@Model.SoLuotNguoiMuaTrongNgay</div>
                            <div class="stat-change">@(Model.ThayDoiNguoiMua >= 0 ? "+" : "")@Model.ThayDoiNguoiMua so với kỳ trước</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card green">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3>Tổng giá trị mua</h3>
                            <div class="stat-number">@Model.TongGiaTriMua.ToString("N0")₫</div>
                            <div class="stat-change">@(Model.ThayDoiGiaTri >= 0 ? "+" : "")@Model.ThayDoiGiaTri.ToString("N0")₫ so với kỳ trước</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card orange">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3>Số lượng sản phẩm mua</h3>
                            <div class="stat-number">@Model.SoLuongSanPhamMua</div>
                            <div class="stat-change">@(Model.ThayDoiSanPham >= 0 ? "+" : "")@Model.ThayDoiSanPham sản phẩm so với kỳ trước</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-box"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card purple">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3>Số lượng hóa đơn</h3>
                            <div class="stat-number">@Model.SoLuongHoaDonTrongNgay</div>
                            <div class="stat-change">@(Model.ThayDoiHoaDon >= 0 ? "+" : "")@Model.ThayDoiHoaDon hóa đơn so với kỳ trước</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-receipt"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card teal" style="border-left: 4px solid #14b8a6 !important;">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3 style="color: #0d9488 !important; font-weight: 600 !important;">Khách mới đăng ký</h3>
                            <div class="stat-number" style="color: #14b8a6 !important; text-shadow: 0 2px 4px rgba(20, 184, 166, 0.2) !important;">@Model.SoKhachMoiDangKy</div>
                            <div class="stat-change" style="color: #0f766e !important;">@(Model.ThayDoiKhachMoi >= 0 ? "+" : "")@Model.ThayDoiKhachMoi khách so với kỳ trước</div>
                        </div>
                        <div class="stat-icon" style="background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%) !important; box-shadow: 0 4px 12px rgba(20, 184, 166, 0.4) !important;">
                            <i class="fas fa-user-plus" style="color: white !important; font-size: 24px !important;"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top Products Section -->
            <div class="top-products-section">
                <h2 class="section-title">
                    <i class="fas fa-trophy"></i>
                    Top 5 sản phẩm bán chạy nhất
                </h2>
                <div class="top-products-grid">
                    @foreach (var product in Model.TopProducts)
                    {
                        <div class="product-rank-card rank-@product.Rank">
                            <div class="rank-badge">
                                <i class="@product.RankIcon" style="color: @product.RankColor;"></i>
                                <span class="rank-number">#@product.Rank</span>
                            </div>
                            <div class="product-info">
                                <h4 class="product-name">@product.TenSanPham</h4>
                                <p class="product-code">@product.MaSanPham</p>
                                <div class="product-stats">
                                    <div class="stat-item">
                                        <span class="stat-label">Số lượng:</span>
                                        <span class="stat-value">@product.TongSoLuong</span>
                                    </div>
                                    <div class="stat-item">
                                        <span class="stat-label">Doanh thu:</span>
                                        <span class="stat-value">@product.TongDoanhThu.ToString("N0")₫</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Chart Section -->
            <div class="chart-section">
                <!-- Biểu đồ đường -->
                <div class="chart-card">
                    <h3>Biến động đơn hàng và số lượng sản phẩm</h3>
                    <p class="chart-subtitle">Theo dõi xu hướng đơn hàng và số lượng sản phẩm bán ra theo ngày</p>
                    <div class="chart-wrapper">
                        <canvas id="orderTrendChart" style="height: 400px;"></canvas>
                    </div>
                </div>

                <!-- Biểu đồ cột đôi - Doanh số và Đơn hàng -->
                <div class="chart-card">
                    <h3>So sánh doanh số và số lượng đơn hàng</h3>
                    <p class="chart-subtitle">Phân tích mối quan hệ giữa doanh số và số lượng đơn hàng theo ngày</p>
                    <div class="chart-wrapper">
                        <canvas id="revenueOrderChart" style="height: 400px;"></canvas>
                    </div>
                </div>

                <!-- Biểu đồ tròn - hàng ngang -->
                <div class="pie-charts-row">
                    <div class="pie-chart-card">
                        <h3>Phân tích đơn hàng theo thứ</h3>
                        <p class="chart-subtitle">Xem thứ nào có lượng khách đột biến</p>
                        <div class="pie-chart-wrapper">
                            <canvas id="weekdayChart"></canvas>
                        </div>
                    </div>

                    <div class="pie-chart-card">
                        <h3>Bàn được sử dụng nhiều nhất</h3>
                        <p class="chart-subtitle">Thống kê tần suất sử dụng các bàn</p>
                        <div class="pie-chart-wrapper">
                            <canvas id="tableUsageChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Dữ liệu từ server
        const chartLabels = @Html.Raw(Json.Serialize(Model.ChartLabels));
        const orderData = @Html.Raw(Json.Serialize(Model.ChartOrderData));
        const quantityData = @Html.Raw(Json.Serialize(Model.ChartQuantityData));
        const revenueData = @Html.Raw(Json.Serialize(Model.ChartRevenueData.Any() ? Model.ChartRevenueData : Model.ChartOrderData.Select(x => (decimal)(x * 50000)).ToList())); // Dữ liệu doanh thu
        const weekdayLabels = @Html.Raw(Json.Serialize(Model.WeekdayLabels));
        const weekdayOrderData = @Html.Raw(Json.Serialize(Model.WeekdayOrderData));
        const tableLabels = @Html.Raw(Json.Serialize(Model.TableLabels));
        const tableUsageData = @Html.Raw(Json.Serialize(Model.TableUsageData));

        // 1. Biểu đồ xu hướng đơn hàng (line chart)
        const ctx = document.getElementById('orderTrendChart').getContext('2d');
        
        // Tạo gradient cho đường đơn hàng
        const orderGradient = ctx.createLinearGradient(0, 0, 0, 400);
        orderGradient.addColorStop(0, 'rgba(99, 102, 241, 0.8)');
        orderGradient.addColorStop(0.5, 'rgba(99, 102, 241, 0.4)');
        orderGradient.addColorStop(1, 'rgba(99, 102, 241, 0.1)');
        
        // Tạo gradient cho đường số lượng sản phẩm
        const quantityGradient = ctx.createLinearGradient(0, 0, 0, 400);
        quantityGradient.addColorStop(0, 'rgba(16, 185, 129, 0.8)');
        quantityGradient.addColorStop(0.5, 'rgba(16, 185, 129, 0.4)');
        quantityGradient.addColorStop(1, 'rgba(16, 185, 129, 0.1)');
        
        const orderTrendChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Số đơn hàng',
                    data: orderData,
                    borderColor: '#6366f1',
                    backgroundColor: orderGradient,
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#6366f1',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 6,
                    pointHoverRadius: 8,
                    pointHoverBackgroundColor: '#4f46e5',
                    pointHoverBorderColor: '#ffffff',
                    pointHoverBorderWidth: 3,
                    yAxisID: 'y'
                }, {
                    label: 'Số lượng sản phẩm',
                    data: quantityData,
                    borderColor: '#10b981',
                    backgroundColor: quantityGradient,
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#10b981',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 6,
                    pointHoverRadius: 8,
                    pointHoverBackgroundColor: '#059669',
                    pointHoverBorderColor: '#ffffff',
                    pointHoverBorderWidth: 3,
                    yAxisID: 'y1'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    intersect: false,
                    mode: 'index'
                },
                plugins: {
                    title: {
                        display: false
                    },
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            usePointStyle: true,
                            pointStyle: 'circle',
                            padding: 20,
                            font: {
                                size: 14
                            },
                            color: '#374151'
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(255, 255, 255, 0.95)',
                        titleColor: '#374151',
                        bodyColor: '#6b7280',
                        borderColor: '#e5e7eb',
                        borderWidth: 1,
                        cornerRadius: 8,
                        padding: 12,
                        displayColors: true,
                        titleFont: {
                            size: 14,
                            weight: 'bold'
                        },
                        bodyFont: {
                            size: 13
                        }
                    }
                },
                scales: {
                    x: {
                        display: true,
                        grid: {
                            display: true,
                            color: 'rgba(156, 163, 175, 0.2)',
                            lineWidth: 1
                        },
                        ticks: {
                            color: '#6b7280',
                            font: {
                                size: 12
                            }
                        },
                        title: {
                            display: true,
                            text: 'Ngày',
                            color: '#374151',
                            font: {
                                size: 14,
                                weight: 'bold'
                            }
                        }
                    },
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        grid: {
                            color: 'rgba(156, 163, 175, 0.2)',
                            lineWidth: 1
                        },
                        ticks: {
                            color: '#6366f1',
                            font: {
                                size: 12
                            }
                        },
                        title: {
                            display: true,
                            text: 'Số đơn hàng',
                            color: '#6366f1',
                            font: {
                                size: 14,
                                weight: 'bold'
                            }
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        grid: {
                            drawOnChartArea: false,
                        },
                        ticks: {
                            color: '#10b981',
                            font: {
                                size: 12
                            }
                        },
                        title: {
                            display: true,
                            text: 'Số lượng sản phẩm',
                            color: '#10b981',
                            font: {
                                size: 14,
                                weight: 'bold'
                            }
                        }
                    }
                },
                elements: {
                    line: {
                        tension: 0.4
                    }
                },
                animation: {
                    duration: 2000,
                    easing: 'easeInOutQuart'
                }
            }
        });

        // 2. Biểu đồ cột đôi - Doanh số và Đơn hàng
        const revenueOrderCtx = document.getElementById('revenueOrderChart').getContext('2d');
        
        const revenueOrderChart = new Chart(revenueOrderCtx, {
            type: 'bar',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Doanh số (VNĐ)',
                    data: revenueData,
                    backgroundColor: 'rgba(34, 197, 94, 0.8)',
                    borderColor: 'rgba(34, 197, 94, 1)',
                    borderWidth: 2,
                    borderRadius: 6,
                    borderSkipped: false,
                    yAxisID: 'y'
                }, {
                    label: 'Số đơn hàng',
                    data: orderData,
                    backgroundColor: 'rgba(59, 130, 246, 0.8)',
                    borderColor: 'rgba(59, 130, 246, 1)',
                    borderWidth: 2,
                    borderRadius: 6,
                    borderSkipped: false,
                    yAxisID: 'y1'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    intersect: false,
                    mode: 'index'
                },
                plugins: {
                    title: {
                        display: false
                    },
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            usePointStyle: true,
                            pointStyle: 'rect',
                            padding: 20,
                            font: {
                                size: 14
                            },
                            color: '#374151'
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(255, 255, 255, 0.95)',
                        titleColor: '#374151',
                        bodyColor: '#6b7280',
                        borderColor: '#e5e7eb',
                        borderWidth: 1,
                        cornerRadius: 8,
                        padding: 12,
                        displayColors: true,
                        titleFont: {
                            size: 14,
                            weight: 'bold'
                        },
                        bodyFont: {
                            size: 13
                        },
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                if (context.datasetIndex === 0) {
                                    // Doanh số - format tiền
                                    label += new Intl.NumberFormat('vi-VN', {
                                        style: 'currency',
                                        currency: 'VND'
                                    }).format(context.parsed.y);
                                } else {
                                    // Số đơn hàng
                                    label += context.parsed.y + ' đơn';
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        display: true,
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: '#6b7280',
                            font: {
                                size: 12
                            }
                        },
                        title: {
                            display: true,
                            text: 'Ngày',
                            color: '#374151',
                            font: {
                                size: 14,
                                weight: 'bold'
                            }
                        }
                    },
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        grid: {
                            color: 'rgba(156, 163, 175, 0.2)',
                            lineWidth: 1
                        },
                        ticks: {
                            color: '#22c55e',
                            font: {
                                size: 12
                            },
                            callback: function(value) {
                                return new Intl.NumberFormat('vi-VN', {
                                    style: 'currency',
                                    currency: 'VND',
                                    notation: 'compact'
                                }).format(value);
                            }
                        },
                        title: {
                            display: true,
                            text: 'Doanh số (VNĐ)',
                            color: '#22c55e',
                            font: {
                                size: 14,
                                weight: 'bold'
                            }
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        grid: {
                            drawOnChartArea: false,
                        },
                        ticks: {
                            color: '#3b82f6',
                            font: {
                                size: 12
                            }
                        },
                        title: {
                            display: true,
                            text: 'Số đơn hàng',
                            color: '#3b82f6',
                            font: {
                                size: 14,
                                weight: 'bold'
                            }
                        }
                    }
                },
                animation: {
                    duration: 2000,
                    easing: 'easeInOutQuart'
                }
            }
        });

        // 3. Biểu đồ tròn phân tích thứ trong tuần
        const weekdayCtx = document.getElementById('weekdayChart').getContext('2d');
        const weekdayColors = [
            '#ef4444', // Chủ nhật - đỏ
            '#3b82f6', // Thứ hai - xanh dương
            '#10b981', // Thứ ba - xanh lá
            '#f59e0b', // Thứ tư - vàng
            '#8b5cf6', // Thứ năm - tím
            '#ec4899', // Thứ sáu - hồng
            '#06b6d4'  // Thứ bảy - xanh cyan
        ];

        const weekdayChart = new Chart(weekdayCtx, {
            type: 'doughnut',
            data: {
                labels: weekdayLabels,
                datasets: [{
                    data: weekdayOrderData,
                    backgroundColor: weekdayColors,
                    borderColor: '#ffffff',
                    borderWidth: 3,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            font: {
                                size: 12
                            },
                            color: '#374151',
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(255, 255, 255, 0.95)',
                        titleColor: '#374151',
                        bodyColor: '#6b7280',
                        borderColor: '#e5e7eb',
                        borderWidth: 1,
                        cornerRadius: 8,
                        padding: 12,
                        displayColors: true,
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = total > 0 ? ((context.parsed * 100) / total).toFixed(1) : 0;
                                return context.label + ': ' + context.parsed + ' đơn (' + percentage + '%)';
                            }
                        }
                    }
                },
                animation: {
                    duration: 1500,
                    easing: 'easeInOutQuart'
                }
            }
        });

        // 3. Biểu đồ tròn phân tích bàn
        const tableCtx = document.getElementById('tableUsageChart').getContext('2d');
        const tableColors = [
            '#6366f1', '#8b5cf6', '#ec4899', '#ef4444', '#f59e0b',
            '#10b981', '#06b6d4', '#84cc16', '#f97316', '#64748b'
        ];

        const tableUsageChart = new Chart(tableCtx, {
            type: 'doughnut',
            data: {
                labels: tableLabels,
                datasets: [{
                    data: tableUsageData,
                    backgroundColor: tableColors.slice(0, tableLabels.length),
                    borderColor: '#ffffff',
                    borderWidth: 3,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            font: {
                                size: 12
                            },
                            color: '#374151',
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(255, 255, 255, 0.95)',
                        titleColor: '#374151',
                        bodyColor: '#6b7280',
                        borderColor: '#e5e7eb',
                        borderWidth: 1,
                        cornerRadius: 8,
                        padding: 12,
                        displayColors: true,
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = total > 0 ? ((context.parsed * 100) / total).toFixed(1) : 0;
                                return context.label + ': ' + context.parsed + ' lần (' + percentage + '%)';
                            }
                        }
                    }
                },
                animation: {
                    duration: 1500,
                    easing: 'easeInOutQuart'
                }
            }
        });
    </script>

