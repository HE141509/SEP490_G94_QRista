        // Close modals when clicking outside
        window.addEventListener('click', function(event) {
            const modals = ['addDeXuatMuaSamModal', 'deleteDeXuatMuaSamModal', 'updateDeXuatMuaSamModal', 'viewDeXuatMuaSamModal'];
            modals.forEach(modalId => {
                const modal = document.getElementById(modalId);
                if (event.target === modal) {
                    modal.style.display = 'none';
                }
            });
        });

        // Load danh sách nguyên liệu cho modal xem chi tiết
        function loadViewNguyenLieuList(deXuatId) {
            fetch(`/DeXuatMuaSam/DeXuatMuaSamList?handler=GetNguyenLieuDetail&deXuatId=${deXuatId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    const tableBody = document.getElementById('viewNguyenLieuTableBody');
                    const emptyRow = document.getElementById('viewNguyenLieuEmptyRow');
                    
                    if (data.success && data.data && data.data.length > 0) {
                        emptyRow.style.display = 'none';
                        
                        // Xóa các dòng cũ
                        const rows = tableBody.querySelectorAll('tr:not(#viewNguyenLieuEmptyRow)');
                        rows.forEach(row => row.remove());
                        
                        // Thêm các dòng mới
                        data.data.forEach(item => {
                            const row = document.createElement('tr');
                            row.innerHTML = `
                                <td style="padding: 12px; border-bottom: 1px solid #f0f0f0;">
                                    ${item.tenNguyenLieu}
                                    <small style="color: #666; display: block; font-size: 12px;">Đơn vị: ${item.donViTinh}</small>
                                </td>
                                <td style="padding: 12px; text-align: center; border-bottom: 1px solid #f0f0f0;">
                                    ${item.maNguyenLieu}
                                </td>
                                <td style="padding: 12px; text-align: center; border-bottom: 1px solid #f0f0f0;">
                                    ${formatNumber(item.soLuong)}
                                </td>
                            `;
                            tableBody.appendChild(row);
                        });
                    } else {
                        emptyRow.style.display = '';
                        emptyRow.innerHTML = `
                            <td colspan="3" style="padding: 20px; text-align: center; color: #999; font-style: italic;">
                                Không có nguyên liệu nào trong đề xuất này
                            </td>
                        `;
                        
                        // Xóa các dòng khác
                        const rows = tableBody.querySelectorAll('tr:not(#viewNguyenLieuEmptyRow)');
                        rows.forEach(row => row.remove());
                    }
                })
                .catch(error => {
                    console.error('Error loading nguyên liệu:', error);
                    const tableBody = document.getElementById('viewNguyenLieuTableBody');
                    const emptyRow = document.getElementById('viewNguyenLieuEmptyRow');
                    
                    emptyRow.style.display = '';
                    emptyRow.innerHTML = `
                        <td colspan="3" style="padding: 20px; text-align: center; color: #dc3545; font-style: italic;">
                            Có lỗi khi tải danh sách nguyên liệu
                        </td>
                    `;
                    
                    // Xóa các dòng khác
                    const rows = tableBody.querySelectorAll('tr:not(#viewNguyenLieuEmptyRow)');
                    rows.forEach(row => row.remove());
                });
        }

        // ===== CÁC HÀM CHO MODAL CẬP NHẬT =====
        let updateSelectedNguyenLieuList = [];

        // Thêm nguyên liệu vào danh sách cập nhật
        function updateAddNguyenLieuToList() {
            const nguyenLieuInput = document.getElementById('updateNguyenLieuSearch');
            const soLuongInput = document.getElementById('updateNguyenLieuSoLuong');
            
            const nguyenLieuId = nguyenLieuInput.getAttribute('data-selected-id');
            const soLuong = getNumberValue(soLuongInput);
            
            if (!nguyenLieuId) {
                alert('Vui lòng chọn nguyên liệu!');
                return;
            }
            
            if (!soLuong || soLuong <= 0) {
                alert('Vui lòng nhập số lượng hợp lệ!');
                soLuongInput.focus();
                return;
            }
            
            // Lấy thông tin nguyên liệu từ dropdown option được chọn
            const selectedOption = document.querySelector(`#updateNguyenLieuSearchOptions .searchable-option[data-value="${nguyenLieuId}"]`);
            if (!selectedOption) {
                alert('Không tìm thấy thông tin nguyên liệu!');
                return;
            }
            
            const nguyenLieuName = selectedOption.getAttribute('data-name');
            const donViTinh = selectedOption.getAttribute('data-donvi');
            
            // Kiểm tra xem nguyên liệu đã có trong danh sách chưa
            const existingIndex = updateSelectedNguyenLieuList.findIndex(item => item.id === nguyenLieuId);
            if (existingIndex !== -1) {
                // Cập nhật số lượng nếu đã có
                updateSelectedNguyenLieuList[existingIndex].soLuong = soLuong;
            } else {
                // Thêm mới vào danh sách
                updateSelectedNguyenLieuList.push({
                    id: nguyenLieuId,
                    name: nguyenLieuName,
                    soLuong: soLuong,
                    donViTinh: donViTinh
                });
            }
            
            // Cập nhật bảng hiển thị
            updateUpdateNguyenLieuTable();
            
            // Reset form
            nguyenLieuInput.value = '';
            nguyenLieuInput.setAttribute('data-selected-id', '');
            soLuongInput.value = '';
        }

        // Cập nhật bảng hiển thị nguyên liệu cho modal cập nhật
        function updateUpdateNguyenLieuTable() {
            const tableBody = document.getElementById('updateNguyenLieuTableBody');
            const emptyRow = document.getElementById('updateNguyenLieuEmptyRow');
            
            if (updateSelectedNguyenLieuList.length === 0) {
                emptyRow.style.display = '';
                // Xóa các dòng khác
                const rows = tableBody.querySelectorAll('tr:not(#updateNguyenLieuEmptyRow)');
                rows.forEach(row => row.remove());
            } else {
                emptyRow.style.display = 'none';
                
                // Xóa các dòng cũ
                const rows = tableBody.querySelectorAll('tr:not(#updateNguyenLieuEmptyRow)');
                rows.forEach(row => row.remove());
                
                // Thêm các dòng mới
                updateSelectedNguyenLieuList.forEach((item, index) => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td style="padding: 10px; border-bottom: 1px solid #f0f0f0; width: 40%;">
                            ${item.name}
                            ${item.donViTinh ? `<small style="color: #666; display: block; font-size: 12px;">Đơn vị: ${item.donViTinh}</small>` : ''}
                        </td>
                        <td style="padding: 10px; border-bottom: 1px solid #f0f0f0; text-align: center; width: 40%;">${formatNumber(item.soLuong)}</td>
                        <td style="padding: 10px; border-bottom: 1px solid #f0f0f0; text-align: center; width: 20%;">
                            <button type="button" onclick="updateRemoveNguyenLieuFromList('${item.id}')" 
                                    class="userlist-delete-btn" style="padding: 4px 8px; font-size: 12px;">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    `;
                    tableBody.appendChild(row);
                });
            }
        }

        // Xóa nguyên liệu khỏi danh sách cập nhật
        function updateRemoveNguyenLieuFromList(nguyenLieuId) {
            updateSelectedNguyenLieuList = updateSelectedNguyenLieuList.filter(item => item.id !== nguyenLieuId);
            updateUpdateNguyenLieuTable();
        }

        // Tải danh sách nguyên liệu hiện tại của đề xuất
        function loadCurrentNguyenLieuList(deXuatId) {
            const url = `/DeXuatMuaSam/DeXuatMuaSamList?handler=GetNguyenLieuDetail&deXuatId=${deXuatId}`;
            
            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    updateSelectedNguyenLieuList = [];
                    
                    if (data.success && data.data && data.data.length > 0) {
                        data.data.forEach(item => {
                            updateSelectedNguyenLieuList.push({
                                id: item.idNguyenLieu,
                                name: item.tenNguyenLieu,
                                soLuong: parseInt(item.soLuong),
                                donViTinh: item.donViTinh
                            });
                        });
                    }
                    
                    // Cập nhật bảng hiển thị
                    updateUpdateNguyenLieuTable();
                })
                .catch(error => {
                    console.error('Error loading current nguyên liệu:', error);
                    updateSelectedNguyenLieuList = [];
                    updateUpdateNguyenLieuTable();
                });
        }

        // Tải danh sách nguyên liệu cho modal cập nhật
        function loadUpdateNguyenLieuOptions() {
            return new Promise((resolve, reject) => {
                const optionsContainer = document.getElementById('updateNguyenLieuSearchOptions');
                
                fetch('/NguyenLieu/NguyenLieuList?handler=ActiveNguyenLieu')
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Network response was not ok');
                        }
                        return response.json();
                    })
                    .then(data => {
                        optionsContainer.innerHTML = '';
                        
                        if (data && Array.isArray(data)) {
                            data.forEach(nguyenLieu => {
                                const optionDiv = document.createElement('div');
                                optionDiv.className = 'searchable-option';
                                optionDiv.setAttribute('data-value', nguyenLieu.id);
                                optionDiv.setAttribute('data-name', nguyenLieu.tenNguyenLieu);
                                optionDiv.setAttribute('data-donvi', nguyenLieu.donViTinh || '');
                                optionDiv.textContent = `${nguyenLieu.tenNguyenLieu} (${nguyenLieu.maNguyenLieu})`;
                                optionsContainer.appendChild(optionDiv);
                            });
                        }
                        resolve();
                    })
                    .catch(error => {
                        console.error('Error loading nguyên liệu options:', error);
                        reject(error);
                    });
            });
        }
    </script>
        </main>
    </div>
</body>
</html>
