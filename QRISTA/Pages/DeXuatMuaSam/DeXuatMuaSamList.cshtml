        // Xác nhận từ chối với lý do
        function confirmRejectWithReason() {
            const deXuatId = document.getElementById('viewDeXuatId').value;
            const rejectReason = document.getElementById('rejectReasonInput').value.trim();
            
            if (!deXuatId) return;
            
