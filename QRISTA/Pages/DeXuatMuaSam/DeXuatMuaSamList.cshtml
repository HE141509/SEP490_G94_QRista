        // Xử lý form cập nhật đề xuất mua sắm
        document.getElementById('updateDeXuatMuaSamForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Lấy giá trị chi nhánh nhận và người nhận
            const chiNhanhNhanInput = document.getElementById('updateIDChiNhanhNhan');
            const nguoiNhanInput = document.getElementById('updateIDNguoiNhan');
            
            const formData = {
                id: document.getElementById('updateDeXuatId').value,
                tieuDe: document.getElementById('updateTieuDe').value,
                noiDungDeXuat: document.getElementById('updateNoiDungDeXuat').value,
                idChiNhanhNhan: chiNhanhNhanInput.getAttribute('data-selected-id') || '',
                idNguoiNhan: nguoiNhanInput.getAttribute('data-selected-id') || ''
            };
            
            if (!formData.tieuDe || !formData.noiDungDeXuat || !formData.idChiNhanhNhan || !formData.idNguoiNhan) {
                alert('Vui lòng nhập đầy đủ thông tin!');
                return;
            }

            // Kiểm tra có ít nhất một nguyên liệu
            if (updateSelectedNguyenLieuList.length === 0) {
                alert('Vui lòng thêm ít nhất một nguyên liệu vào đề xuất!');
                return;
            }
            
            // Lấy anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            // Tạo FormData cho thông tin cơ bản
            const form = new FormData();
            form.append('id', formData.id);
            form.append('tieuDe', formData.tieuDe);
            form.append('noiDungDeXuat', formData.noiDungDeXuat);
            form.append('idChiNhanhNhan', formData.idChiNhanhNhan);
            form.append('idNguoiNhan', formData.idNguoiNhan);
            form.append('__RequestVerificationToken', token);
            
            // Cập nhật thông tin cơ bản trước
            fetch('/DeXuatMuaSam/UpdateDeXuatMuaSam', {
                method: 'POST',
                body: form
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    // Sau khi cập nhật thông tin cơ bản thành công, cập nhật nguyên liệu
                    const nguyenLieuData = updateSelectedNguyenLieuList.map(item => ({
                        Id: item.id,
                        Name: item.name,
                        SoLuong: item.soLuong,
                        DonViTinh: item.donViTinh
                    }));

                    const nguyenLieuForm = new FormData();
                    nguyenLieuForm.append('idDeXuat', formData.id);
                    nguyenLieuForm.append('NguyenLieuList', JSON.stringify(nguyenLieuData));
                    nguyenLieuForm.append('__RequestVerificationToken', token);

                    return fetch('/Pages/DeXuatMuaSam/UpdateDeXuatMuaSam?handler=UpdateNguyenLieu', {
                        method: 'POST',
                        body: nguyenLieuForm
                    });
                } else {
                    throw new Error(data.message || 'Lỗi cập nhật thông tin cơ bản');
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Cập nhật đề xuất mua sắm thành công!');
                    window.location.reload();
                } else {
                    alert('Lỗi cập nhật nguyên liệu: ' + (data.message || 'Không xác định'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra: ' + error.message);
            });
        });

        // Searchable dropdown functions
        function getSelectedValue(inputId) {
            const input = document.getElementById(inputId);
            return input.getAttribute('data-selected-id') || '';
        }

        function initSearchableDropdown(inputId) {
            const input = document.getElementById(inputId);
            const optionsContainer = document.getElementById(inputId + 'Options');
            const options = optionsContainer.querySelectorAll('.searchable-option');

            input.addEventListener('focus', function() {
                optionsContainer.style.display = 'block';
            });

            input.addEventListener('input', function() {
                const searchText = this.value.toLowerCase();
                options.forEach(option => {
                    const text = option.textContent.toLowerCase();
                    option.style.display = text.includes(searchText) ? 'block' : 'none';
                });
            });

            options.forEach(option => {
                option.addEventListener('click', function() {
                    const value = this.getAttribute('data-value');
                    const text = this.textContent;
                    input.value = text;
                    input.setAttribute('data-selected-id', value);
                    optionsContainer.style.display = 'none';
                });
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!input.contains(e.target) && !optionsContainer.contains(e.target)) {
                    optionsContainer.style.display = 'none';
                }
            });
        }

