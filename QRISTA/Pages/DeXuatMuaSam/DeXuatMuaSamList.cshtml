    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentDeleteId = null;
        
        // Thông tin chi nhánh của user hiện tại
        const currentUserBranchCode = '@Model.CurrentUserBranchCode';
        const currentUserId = '@Model.CurrentUserId';
        const currentUserBranchId = '@Model.CurrentUserBranchId';
        
        // Hàm chuyển đổi tab
        function switchTab(status, tabElement) {
            // Remove active class from all tabs
            document.querySelectorAll('.status-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Add active class to clicked tab
            tabElement.classList.add('active');
            
            // Filter table rows based on status
            const rows = document.querySelectorAll('#deXuatMuaSamListTable tbody tr');
            let visibleCount = 0;
            
            // Show/hide rejection reason column based on tab
            const rejectionColumns = document.querySelectorAll('.rejection-reason-column');
            rejectionColumns.forEach(column => {
                if (status === 'rejected') {
                    column.style.display = '';
                } else {
                    column.style.display = 'none';
                }
            });
            
            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status');
                const isDeleted = row.getAttribute('data-deleted') === 'true';
                const nguoiGui = row.getAttribute('data-nguoi-gui');
                const nguoiNhan = row.getAttribute('data-nguoi-nhan');
                let shouldShow = false;
                
                switch(status) {
                    case 'pending':
                        // Tab "Chờ duyệt": status = pending và người gửi = người đăng nhập
                        shouldShow = rowStatus === 'pending' && !isDeleted && nguoiGui === currentUserId;
                        break;
                    case 'received':
                        // Tab "Đã nhận": status = pending và người nhận = người đăng nhập
                        shouldShow = rowStatus === 'pending' && !isDeleted && nguoiNhan === currentUserId;
                        break;
                    case 'accepted':
                        // Tab "Đã duyệt": status = accepted và (người nhận = người đăng nhập HOẶC người gửi = người đăng nhập)
                        shouldShow = rowStatus === 'accepted' && !isDeleted && (nguoiNhan === currentUserId || nguoiGui === currentUserId);
                        break;
                    case 'rejected':
                        // Tab "Từ chối": status = rejected và (người nhận = người đăng nhập HOẶC người gửi = người đăng nhập)
                        shouldShow = rowStatus === 'rejected' && !isDeleted && (nguoiNhan === currentUserId || nguoiGui === currentUserId);
                        break;
                    case 'deleted':
                        shouldShow = isDeleted;
                        break;
                }
                
                if (shouldShow) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });
            
            // Update pagination info
            updatePaginationInfo(visibleCount, status);
        }
        
        // Hàm cập nhật thông tin phân trang
        function updatePaginationInfo(visibleCount, status) {
            const paginationInfo = document.querySelector('.userlist-pagination-info');
            let statusText = '';
            
            switch(status) {
                case 'all': statusText = 'tất cả đề xuất'; break;
                case 'pending': statusText = 'đề xuất chờ duyệt'; break;
                case 'accepted': statusText = 'đề xuất đã duyệt'; break;
                case 'rejected': statusText = 'đề xuất từ chối'; break;
                case 'received': statusText = 'đề xuất đã nhận'; break;
                case 'deleted': statusText = 'đề xuất đã xóa'; break;
            }
            
            if (paginationInfo) {
                paginationInfo.textContent = `Hiển thị ${visibleCount} ${statusText}`;
            }
        }
        
        // Hàm tạo mã đề xuất tự động
        function generateDeXuatCode() {
            const now = new Date();
            const day = String(now.getDate()).padStart(2, '0');
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const year = now.getFullYear();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            
            // Format: DXMS_ddmmyyyyhhMMss_+ mã chi nhánh
            const timeString = `${day}${month}${year}${hours}${minutes}${seconds}`;
            return `DXMS_${timeString}_${currentUserBranchCode}`;
        }
        
        // Hàm lấy tên hiển thị theo ID
        function getDisplayTextById(optionsId, selectedId) {
            const options = document.querySelectorAll(`#${optionsId} .searchable-option`);
            for (let option of options) {
                if (option.getAttribute('data-value') === selectedId) {
                    return option.textContent;
                }
            }
            return '';
        }

        // Set initial page size and default tab
        document.addEventListener('DOMContentLoaded', function() {
            const pageSize = @Model.PageSize;
            const pageSizeSelect = document.getElementById('deXuatPageSize');
            if (pageSizeSelect) {
                pageSizeSelect.value = pageSize;
            }
            
            // Initialize with "Chờ duyệt" tab
            const pendingTab = document.querySelector('.status-tab[onclick*="pending"]');
            if (pendingTab) {
                switchTab('pending', pendingTab);
            }
            
            // Load danh sách nguyên liệu cho dropdown
            loadNguyenLieuList();
        });
        
        // Biến lưu danh sách nguyên liệu đã chọn
        let selectedNguyenLieuList = [];
        
        // Hàm format số với dấu phẩy ngắt hàng nghìn (chuẩn Việt Nam)
        function formatNumber(num) {
            if (!num || isNaN(num)) return '';
            return parseInt(num).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }
        
        // Hàm chỉ cho phép nhập số
        function allowNumbersOnly(event) {
            const charCode = event.which ? event.which : event.keyCode;
            // Cho phép số (0-9) và các phím điều khiển (backspace, delete, arrow keys, etc.)
            if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                return false;
            }
            return true;
        }
        
        // Hàm format input khi người dùng nhập
        function formatNumberInput(input) {
            let value = input.value.replace(/[^\d]/g, ''); // Chỉ giữ lại số
            
            if (value) {
                // Format với dấu phẩy ngắt hàng nghìn
                const formatted = value.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                input.value = formatted;
            }
        }
        
        // Hàm lấy giá trị số thực từ input đã format
        function getNumberValue(input) {
            if (!input.value) return 0;
            // Xóa tất cả dấu phẩy để có số nguyên
            return parseInt(input.value.replace(/,/g, '')) || 0;
        }
        
        // Load danh sách nguyên liệu
        function loadNguyenLieuList() {
            fetch('/NguyenLieu/NguyenLieuList?handler=ActiveNguyenLieu')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    const optionsContainer = document.getElementById('addNguyenLieuSearchOptions');
                    optionsContainer.innerHTML = '';
                    
                    if (data && Array.isArray(data)) {
                        data.forEach(nguyenLieu => {
                            const optionDiv = document.createElement('div');
                            optionDiv.className = 'searchable-option';
                            optionDiv.setAttribute('data-value', nguyenLieu.id);
                            optionDiv.setAttribute('data-name', nguyenLieu.tenNguyenLieu);
                            optionDiv.setAttribute('data-donvi', nguyenLieu.donViTinh);
                            optionDiv.textContent = `${nguyenLieu.tenNguyenLieu} (${nguyenLieu.maNguyenLieu})`;
                            optionsContainer.appendChild(optionDiv);
                        });
                    }
                    
                    // Initialize dropdown cho nguyên liệu
                    initSearchableDropdown('addNguyenLieuSearch');
                })
                .catch(error => {
                    console.error('Error loading nguyên liệu:', error);
                    alert('Không thể tải danh sách nguyên liệu. Vui lòng thử lại sau.');
                });
        }
        
        // Thêm nguyên liệu vào danh sách
        function addNguyenLieuToList() {
            const nguyenLieuInput = document.getElementById('addNguyenLieuSearch');
            const soLuongInput = document.getElementById('addNguyenLieuSoLuong');
            
            const nguyenLieuId = nguyenLieuInput.getAttribute('data-selected-id');
            const nguyenLieuName = nguyenLieuInput.value;
            const soLuong = getNumberValue(soLuongInput);
            
            if (!nguyenLieuId || !nguyenLieuName) {
                alert('Vui lòng chọn nguyên liệu!');
                return;
            }
            
            if (!soLuong || soLuong <= 0) {
                alert('Vui lòng nhập số lượng hợp lệ!');
                soLuongInput.focus();
                return;
            }
            
            // Lấy thông tin đơn vị tính từ dropdown option được chọn
            const selectedOption = document.querySelector(`#addNguyenLieuSearchOptions .searchable-option[data-value="${nguyenLieuId}"]`);
            const donViTinh = selectedOption ? selectedOption.getAttribute('data-donvi') : '';
            
            // Kiểm tra xem nguyên liệu đã có trong danh sách chưa
            const existingIndex = selectedNguyenLieuList.findIndex(item => item.id === nguyenLieuId);
            if (existingIndex !== -1) {
                // Cập nhật số lượng nếu đã có
                selectedNguyenLieuList[existingIndex].soLuong = soLuong;
            } else {
                // Thêm mới vào danh sách
                selectedNguyenLieuList.push({
                    id: nguyenLieuId,
                    name: nguyenLieuName,
                    soLuong: soLuong,
                    donViTinh: donViTinh
                });
            }
            
            // Cập nhật bảng hiển thị
            updateNguyenLieuTable();
            
            // Reset form
            nguyenLieuInput.value = '';
            nguyenLieuInput.setAttribute('data-selected-id', '');
            soLuongInput.value = '';
        }
        
        // Cập nhật bảng hiển thị nguyên liệu
        function updateNguyenLieuTable() {
            const tableBody = document.getElementById('addNguyenLieuTableBody');
            const emptyRow = document.getElementById('addNguyenLieuEmptyRow');
            
            if (selectedNguyenLieuList.length === 0) {
                emptyRow.style.display = '';
                // Xóa các dòng khác
                const rows = tableBody.querySelectorAll('tr:not(#addNguyenLieuEmptyRow)');
                rows.forEach(row => row.remove());
            } else {
                emptyRow.style.display = 'none';
                
                // Xóa các dòng cũ
                const rows = tableBody.querySelectorAll('tr:not(#addNguyenLieuEmptyRow)');
                rows.forEach(row => row.remove());
                
                // Thêm các dòng mới
                selectedNguyenLieuList.forEach((item, index) => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td style="padding: 10px; border-bottom: 1px solid #f0f0f0; width: 40%;">
                            ${item.name}
                            ${item.donViTinh ? `<small style="color: #666; display: block; font-size: 12px;">Đơn vị: ${item.donViTinh}</small>` : ''}
                        </td>
                        <td style="padding: 10px; border-bottom: 1px solid #f0f0f0; text-align: center; width: 40%;">${formatNumber(item.soLuong)}</td>
                        <td style="padding: 10px; border-bottom: 1px solid #f0f0f0; text-align: center; width: 20%;">
                            <button type="button" onclick="removeNguyenLieuFromList('${item.id}')" 
                                    class="userlist-delete-btn" style="padding: 4px 8px; font-size: 12px;">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    `;
                    tableBody.appendChild(row);
                });
            }
        }
        
        // Xóa nguyên liệu khỏi danh sách
        function removeNguyenLieuFromList(nguyenLieuId) {
            selectedNguyenLieuList = selectedNguyenLieuList.filter(item => item.id !== nguyenLieuId);
            updateNguyenLieuTable();
        }

        // Change page size
        function changeDeXuatPageSize() {
            const pageSize = document.getElementById('deXuatPageSize').value;
            window.location.href = `?pageNumber=1&pageSize=${pageSize}`;
        }

        // Search function (client-side for current page)
        function filterDeXuatList() {
            const searchText = event.target.value.toLowerCase();
            const rows = document.querySelectorAll('#deXuatMuaSamListTable tbody tr');
            const activeTab = document.querySelector('.status-tab.active');
            const currentStatus = activeTab ? activeTab.onclick.toString().match(/switchTab\('([^']+)'/)?.[1] || 'all' : 'all';
            
            let visibleCount = 0;
            
            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                const rowStatus = row.getAttribute('data-status');
                const isDeleted = row.getAttribute('data-deleted') === 'true';
                const nguoiGui = row.getAttribute('data-nguoi-gui');
                const nguoiNhan = row.getAttribute('data-nguoi-nhan');
                
                // Check if row matches current tab filter
                let matchesTab = false;
                switch(currentStatus) {
                    case 'pending':
                        // Tab "Chờ duyệt": status = pending và người gửi = người đăng nhập
                        matchesTab = rowStatus === 'pending' && !isDeleted && nguoiGui === currentUserId;
                        break;
                    case 'received':
                        // Tab "Đã nhận": status = pending và người nhận = người đăng nhập
                        matchesTab = rowStatus === 'pending' && !isDeleted && nguoiNhan === currentUserId;
                        break;
                    case 'accepted':
                        matchesTab = rowStatus === 'accepted' && !isDeleted && (nguoiNhan === currentUserId || nguoiGui === currentUserId);
                        break;
                    case 'rejected':
                        matchesTab = rowStatus === 'rejected' && !isDeleted && (nguoiNhan === currentUserId || nguoiGui === currentUserId);
                        break;
                    case 'deleted':
                        matchesTab = isDeleted;
                        matchesTab = isDeleted;
                        break;
                }
                
                // Check if row matches search text
                let matchesSearch = searchText === '';
                if (searchText !== '') {
                    // Search in MaDeXuat, TieuDe, TenNguoiGui, TenNguoiNhan
                    for (let i = 0; i < 6; i++) {
                        if (cells[i] && cells[i].textContent.toLowerCase().includes(searchText)) {
                            matchesSearch = true;
                            break;
                        }
                    }
                }
                
                // Show row only if it matches both tab and search filters
                if (matchesTab && matchesSearch) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });
            
            // Update pagination info
            updatePaginationInfo(visibleCount, currentStatus);
        }

        // Show full rejection reason in a modal
        function showFullReason(reason) {
            const modal = document.createElement('div');
            modal.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.5);
                z-index: 9999;
                display: flex;
                justify-content: center;
                align-items: center;
            `;
            
            const content = document.createElement('div');
            content.style.cssText = `
                background: white;
                padding: 24px;
                border-radius: 8px;
                max-width: 500px;
                max-height: 70vh;
                overflow-y: auto;
                box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            `;
            
            content.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 2px solid #dc3545; padding-bottom: 12px;">
                    <h5 style="margin: 0; color: #dc3545; font-weight: 600;">
                        <i class="fas fa-comment-slash"></i> Lý do từ chối
                    </h5>
                    <button onclick="this.closest('div').parentElement.remove()" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6c757d;">
                        &times;
                    </button>
                </div>
                <div style="color: #333; line-height: 1.5; font-size: 14px; background: #fff2f2; padding: 12px; border-radius: 6px; border-left: 4px solid #dc3545;">
                    ${reason.replace(/\n/g, '<br>')}
                </div>
            `;
            
            modal.appendChild(content);
            document.body.appendChild(modal);
            
            // Close modal when clicking outside
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.remove();
                }
            });
            
            // Close modal with Escape key
            document.addEventListener('keydown', function escapeHandler(e) {
                if (e.key === 'Escape') {
                    modal.remove();
                    document.removeEventListener('keydown', escapeHandler);
                }
            });
        }

        // Xử lý form thêm mới đề xuất mua sắm
        document.getElementById('addDeXuatMuaSamForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = {
                MaDeXuat: document.getElementById('addMaDeXuat').value,
                TieuDe: document.getElementById('addTieuDe').value,
                NoiDungDeXuat: document.getElementById('addNoiDungDeXuat').value,
                IDNguoiGui: getSelectedValue('addIDNguoiGui'),
                IDChiNhanhGui: getSelectedValue('addIDChiNhanhGui'),
                IDNguoiNhan: getSelectedValue('addIDNguoiNhan'),
                IDChiNhanhNhan: getSelectedValue('addIDChiNhanhNhan'),
                NguyenLieuList: selectedNguyenLieuList  // Thêm danh sách nguyên liệu
            };
            
            // Chỉ kiểm tra chi nhánh nhận vì người nhận sẽ được chọn sau khi chọn chi nhánh
            if (!formData.IDChiNhanhNhan) {
                alert('Vui lòng chọn chi nhánh nhận!');
                return;
            }
            if (!formData.IDNguoiNhan) {
                alert('Vui lòng chọn người nhận!');
                return;
            }
            
            // Kiểm tra không được gửi cho chi nhánh của mình
            if (formData.IDChiNhanhNhan === currentUserBranchId) {
                alert('Không thể gửi đề xuất cho chi nhánh của mình!');
                return;
            }
            
            // Kiểm tra có ít nhất một nguyên liệu
            if (selectedNguyenLieuList.length === 0) {
                alert('Vui lòng thêm ít nhất một nguyên liệu vào đề xuất!');
                return;
            }
            
            fetch('/DeXuatMuaSam/AddDeXuatMuaSam?handler=Add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra: ' + error.message);
            });
        });

