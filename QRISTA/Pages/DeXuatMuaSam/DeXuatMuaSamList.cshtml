        // Hàm cập nhật trạng thái với lý do từ chối
        function updateDeXuatStatusWithReason(deXuatId, newStatus, reason) {
            // Lấy anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            // Tạo FormData
            const formData = new FormData();
            formData.append('id', deXuatId);
            formData.append('status', newStatus);
            formData.append('reason', reason || '');
            formData.append('__RequestVerificationToken', token);
            
            fetch('/DeXuatMuaSam/DeXuatMuaSamList?handler=UpdateStatusWithReason', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                    return response.json();
                } else {
                    return response.text().then(text => {
                        console.log('Response text:', text);
                        throw new Error('Server không trả về JSON. Response: ' + text.substring(0, 200));
                    });
                }
            })
            .then(data => {
                if (data.success) {
                    alert('Đề xuất đã được từ chối với lý do: ' + reason);
                    closeViewDeXuatMuaSamModal();
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra: ' + error.message);
            });
        }

        // Cập nhật trạng thái đề xuất
        function updateDeXuatStatus(deXuatId, newStatus, successMessage) {
            // Lấy anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            // Tạo FormData
            const formData = new FormData();
            formData.append('id', deXuatId);
            formData.append('status', newStatus);
            formData.append('__RequestVerificationToken', token);
            
            fetch('/DeXuatMuaSam/DeXuatMuaSamList?handler=UpdateStatus', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                console.log('Response status:', response.status);
                console.log('Response headers:', response.headers.get('content-type'));
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                // Kiểm tra content-type trước khi parse JSON
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                    return response.json();
                } else {
                    // Nếu không phải JSON, đọc text để debug
                    return response.text().then(text => {
                        console.log('Response text:', text);
                        throw new Error('Server không trả về JSON. Response: ' + text.substring(0, 200));
                    });
                }
