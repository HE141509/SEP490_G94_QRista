        // Phê duyệt đề xuất
        function approveDeXuat() {
            console.log('approveDeXuat called');
            const approveBtn = document.getElementById('approveBtn');
            console.log('approveBtn.disabled:', approveBtn.disabled);
            
            if (approveBtn.disabled) {
                alert('Bạn không có quyền thực hiện thao tác này!');
                return;
            }
            
            const deXuatId = document.getElementById('viewDeXuatId').value;
            if (!deXuatId) return;
            
