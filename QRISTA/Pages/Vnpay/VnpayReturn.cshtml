@page "/VnpayReturn"
@model QRB.Pages.Vnpay.VnpayReturnModel
@{
    ViewData["Title"] = "Kết quả thanh toán";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-body text-center p-5">
                    @if (Model.IsSuccess)
                    {
                        <div class="mb-4">
                            <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                        </div>
                        <h2 class="text-success mb-3">Thanh toán thành công!</h2>
                        <p class="text-muted mb-4">@Model.Message</p>
                        @if (!string.IsNullOrEmpty(Model.OrderId))
                        {
                            <p class="mb-4">
                                <strong>Mã đơn hàng:</strong> <span class="text-primary">@Model.OrderId</span>
                            </p>
                        }
                    }
                    else
                    {
                        <div class="mb-4">
                            <i class="fas fa-times-circle text-danger" style="font-size: 4rem;"></i>
                        </div>
                        <h2 class="text-danger mb-3">Thanh toán thất bại!</h2>
                        <p class="text-muted mb-4">@Model.Message</p>
                        @if (!string.IsNullOrEmpty(Model.OrderId))
                        {
                            <p class="mb-4">
                                <strong>Mã đơn hàng:</strong> <span class="text-primary">@Model.OrderId</span>
                            </p>
                        }
                    }
                    
                    <div class="mt-4">
                        <a href="/Menu/Menu" class="btn btn-primary btn-lg px-4">
                            <i class="fas fa-arrow-left me-2"></i>
                            Quay lại menu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

