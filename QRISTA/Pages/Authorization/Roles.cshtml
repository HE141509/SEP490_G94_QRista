@page "/Authorization/Roles"
@model QRB.Pages.Authorization.RolesModel
@{
    ViewData["Title"] = "Quản lý vai trò";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/userlist.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    
    @await Html.PartialAsync("~/Pages/Shared/_Header.cshtml", Model)

    <div class="main-container">
        
        @await Html.PartialAsync("~/Pages/Shared/_Sidebar.cshtml")

        <main class="main-content">
            <div class="dashboard-header userlist-header-flex">
                <h1 class="page-title">Quản lý vai trò</h1>
                <button class="userlist-add-btn" type="button" data-bs-toggle="modal" data-bs-target="#addRoleModal">
                    <i class="fas fa-plus"></i> Thêm vai trò
                </button>
            </div>

            <div class="userlist-container">
                <div class="userlist-toolbar">
                    <div class="userlist-toolbar-left">
                        <label for="statusFilter" style="font-size:15px;margin-right:8px;color:#555;">Trạng thái:</label>
                        <select id="statusFilter" class="userlist-filter" onchange="filterRoles()">
                            <option value="">Tất cả</option>
                            <option value="active">Đang hoạt động</option>
                            <option value="inactive">Tạm khóa</option>
                        </select>
                    </div>
                    <div class="userlist-toolbar-right">
                        <label for="pageSize" style="font-size:15px;margin-right:8px;color:#555;">Hiển thị:</label>
                        <select id="pageSize" class="userlist-filter" style="width:auto;min-width:60px;" onchange="changePageSize()">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <input type="text" class="userlist-search" placeholder="Tìm kiếm..." onkeyup="filterRoles()" style="margin-left:12px;" />
                        <button class="userlist-filter-btn"><i class="fas fa-filter"></i></button>
                    </div>
                </div>

                <div class="userlist-table-wrapper">
                    <table class="userlist-table userlist-table-modern" id="roleListTable">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Tên vai trò</th>
                                <th>Mô tả</th>
                                <th>Số người dùng</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                                if (Model.Roles != null && Model.Roles.Count > 0)
                                {
                                    foreach (var role in Model.Roles)
                                    {
                                        <tr data-status="@(role.IsActive ? "active" : "inactive")" data-search="@role.Name @role.Description">
                                            <td>@stt</td>
                                            <td><strong>@role.Name</strong></td>
                                            <td>@(role.Description ?? "Không có mô tả")</td>
                                            <td>
                                                <span class="badge bg-info">@role.UserCount người dùng</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@(role.IsActive ? "success" : "danger")">
                                                    @(role.IsActive ? "Hoạt động" : "Tạm khóa")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-outline-primary" 
                                                            onclick="editRole('@role.Id', '@role.Name', '@role.Description', @role.IsActive.ToString().ToLower())"
                                                            title="Chỉnh sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-@(role.IsActive ? "warning" : "success")"
                                                            onclick="toggleRoleStatus('@role.Id')"
                                                            title="@(role.IsActive ? "Tạm khóa" : "Kích hoạt")">
                                                        <i class="fas fa-@(role.IsActive ? "eye-slash" : "eye")"></i>
                                                    </button>
                                                    @if (role.UserCount == 0)
                                                    {
                                                        <button type="button" class="btn btn-outline-danger"
                                                                onclick="deleteRole('@role.Id', '@role.Name')"
                                                                title="Xóa">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                        stt++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">Không có vai trò nào</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div id="userlist-pagination"></div>
            </div>
        </main>
    </div>

    <!-- Modal Thêm vai trò -->
    <div class="modal fade" id="addRoleModal" tabindex="-1" aria-labelledby="addRoleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addRoleModalLabel">Thêm vai trò mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="addRoleForm">
                        <div class="mb-3">
                            <label for="addRoleName" class="form-label">Tên vai trò</label>
                            <input type="text" class="form-control" id="addRoleName" required>
                            <div class="form-text">Ví dụ: Manager, Supervisor, etc.</div>
                        </div>
                        <div class="mb-3">
                            <label for="addRoleDescription" class="form-label">Mô tả</label>
                            <textarea class="form-control" id="addRoleDescription" rows="3"></textarea>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="addIsActive" checked>
                            <label class="form-check-label" for="addIsActive">Vai trò hoạt động</label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary" onclick="saveRole()">Lưu</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Sửa vai trò -->
    <div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editRoleModalLabel">Chỉnh sửa vai trò</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="editRoleForm">
                        <input type="hidden" id="editRoleId">
                        <div class="mb-3">
                            <label for="editRoleName" class="form-label">Tên vai trò</label>
                            <input type="text" class="form-control" id="editRoleName" required>
                        </div>
                        <div class="mb-3">
                            <label for="editRoleDescription" class="form-label">Mô tả</label>
                            <textarea class="form-control" id="editRoleDescription" rows="3"></textarea>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="editIsActive">
                            <label class="form-check-label" for="editIsActive">Vai trò hoạt động</label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary" onclick="updateRole()">Cập nhật</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentPageNumber = 1;
        let currentPageSize = 10;
        let totalPages = 1;

        // Phân trang
        function changePageSize() {
            currentPageSize = parseInt(document.getElementById('pageSize').value);
            currentPageNumber = 1;
            updatePagination();
        }

        function goToPage(page) {
            currentPageNumber = page;
            updatePagination();
        }

        function updatePagination() {
            const table = document.getElementById('roleListTable');
            const tbody = table.getElementsByTagName('tbody')[0];
            const allRows = Array.from(tbody.getElementsByTagName('tr')).filter(row => {
                const firstCell = row.getElementsByTagName('td')[0];
                return firstCell && firstCell.colSpan !== 6;
            });
            
            const totalRecords = allRows.length;
            totalPages = Math.ceil(totalRecords / currentPageSize);
            
            console.log('Total records:', totalRecords, 'Current page size:', currentPageSize, 'Total pages:', totalPages);
            
            // Ẩn tất cả các hàng
            allRows.forEach(row => row.style.display = 'none');
            
            // Hiển thị các hàng của trang hiện tại
            const startIndex = (currentPageNumber - 1) * currentPageSize;
            const endIndex = Math.min(startIndex + currentPageSize, totalRecords);
            
            for (let i = startIndex; i < endIndex; i++) {
                if (allRows[i]) {
                    allRows[i].style.display = '';
                    // Cập nhật số thứ tự
                    const sttCell = allRows[i].getElementsByTagName('td')[0];
                    sttCell.textContent = i + 1;
                }
            }
            
            renderPagination(totalRecords);
        }

        function renderPagination(totalRecords) {
            const paginationContainer = document.getElementById('userlist-pagination');
            
            // Luôn hiển thị phân trang nếu có nhiều hơn 1 trang
            if (totalPages <= 1) {
                paginationContainer.innerHTML = `<div class="userlist-pagination-container">
                    <div class="userlist-pagination-info">Hiển thị ${totalRecords} bản ghi</div>
                </div>`;
                return;
            }
            
            let paginationHTML = '<div class="userlist-pagination-container">';
            paginationHTML += `<div class="userlist-pagination-info">Hiển thị ${((currentPageNumber - 1) * currentPageSize) + 1}-${Math.min(currentPageNumber * currentPageSize, totalRecords)} trong tổng số ${totalRecords} bản ghi</div>`;
            paginationHTML += '<div class="userlist-pagination-controls">';
            
            // Nút Previous
            if (currentPageNumber > 1) {
                paginationHTML += `<button class="userlist-pagination-btn" onclick="goToPage(${currentPageNumber - 1})">‹ Trước</button>`;
            }
            
            // Hiển thị tất cả các trang nếu ít hơn 8 trang
            if (totalPages <= 7) {
                for (let i = 1; i <= totalPages; i++) {
                    const isActive = i === currentPageNumber ? 'userlist-pagination-btn-active' : '';
                    paginationHTML += `<button class="userlist-pagination-btn ${isActive}" onclick="goToPage(${i})">${i}</button>`;
                }
            } else {
                // Logic phức tạp hơn cho nhiều trang
                const startPage = Math.max(1, currentPageNumber - 2);
                const endPage = Math.min(totalPages, startPage + 4);
                
                if (startPage > 1) {
                    paginationHTML += '<button class="userlist-pagination-btn" onclick="goToPage(1)">1</button>';
                    if (startPage > 2) {
                        paginationHTML += '<span class="userlist-pagination-ellipsis">...</span>';
                    }
                }
                
                for (let i = startPage; i <= endPage; i++) {
                    const isActive = i === currentPageNumber ? 'userlist-pagination-btn-active' : '';
                    paginationHTML += `<button class="userlist-pagination-btn ${isActive}" onclick="goToPage(${i})">${i}</button>`;
                }
                
                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        paginationHTML += '<span class="userlist-pagination-ellipsis">...</span>';
                    }
                    paginationHTML += `<button class="userlist-pagination-btn" onclick="goToPage(${totalPages})">${totalPages}</button>`;
                }
            }
            
            // Nút Next
            if (currentPageNumber < totalPages) {
                paginationHTML += `<button class="userlist-pagination-btn" onclick="goToPage(${currentPageNumber + 1})">Sau ›</button>`;
            }
            
            paginationHTML += '</div></div>';
            paginationContainer.innerHTML = paginationHTML;
        }

        // Lọc và tìm kiếm
        function filterRoles() {
            const statusFilter = document.getElementById('statusFilter').value.toLowerCase();
            const searchTerm = document.querySelector('.userlist-search').value.toLowerCase();
            
            const table = document.getElementById('roleListTable');
            const tbody = table.getElementsByTagName('tbody')[0];
            const rows = Array.from(tbody.getElementsByTagName('tr')).filter(row => 
                row.getElementsByTagName('td')[0].colSpan !== 6
            );
            
            rows.forEach(row => {
                const status = row.getAttribute('data-status').toLowerCase();
                const searchData = row.getAttribute('data-search').toLowerCase();
                
                const statusMatch = !statusFilter || status === statusFilter;
                const searchMatch = !searchTerm || searchData.includes(searchTerm);
                
                if (statusMatch && searchMatch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
            
            // Reset về trang đầu và cập nhật phân trang
            currentPageNumber = 1;
            updatePagination();
        }

        // API Functions
        function saveRole() {
            const roleData = {
                name: document.getElementById('addRoleName').value,
                description: document.getElementById('addRoleDescription').value,
                isActive: document.getElementById('addIsActive').checked
            };

            fetch('/api/authorization/roles', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(roleData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('addRoleModal')).hide();
                    location.reload();
                } else {
                    alert('Lỗi: ' + (data.message || 'Có lỗi xảy ra'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi thêm vai trò');
            });
        }

        function editRole(id, name, description, isActive) {
            document.getElementById('editRoleId').value = id;
            document.getElementById('editRoleName').value = name;
            document.getElementById('editRoleDescription').value = description || '';
            document.getElementById('editIsActive').checked = isActive;
            
            new bootstrap.Modal(document.getElementById('editRoleModal')).show();
        }

        function updateRole() {
            const id = document.getElementById('editRoleId').value;
            const roleData = {
                name: document.getElementById('editRoleName').value,
                description: document.getElementById('editRoleDescription').value,
                isActive: document.getElementById('editIsActive').checked
            };

            fetch(`/api/authorization/roles/${id}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(roleData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('editRoleModal')).hide();
                    location.reload();
                } else {
                    alert('Lỗi: ' + (data.message || 'Có lỗi xảy ra'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi cập nhật vai trò');
            });
        }

        function toggleRoleStatus(id) {
            if (confirm('Bạn có chắc chắn muốn thay đổi trạng thái vai trò này?')) {
                fetch(`/api/authorization/roles/${id}/toggle-status`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Lỗi: ' + (data.message || 'Có lỗi xảy ra'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra khi thay đổi trạng thái');
                });
            }
        }

        function deleteRole(id, name) {
            if (confirm(`Bạn có chắc chắn muốn xóa vai trò "${name}"?`)) {
                fetch(`/api/authorization/roles/${id}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Lỗi: ' + (data.message || 'Có lỗi xảy ra'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra khi xóa vai trò');
                });
            }
        }

        // Khởi tạo phân trang khi trang load xong
        document.addEventListener('DOMContentLoaded', function() {
            updatePagination();
        });
    </script>

</body>
</html>
