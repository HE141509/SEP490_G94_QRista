@page "/Authorization/Users"
@model QRB.Pages.Authorization.UsersModel
@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/userlist.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    
    @await Html.PartialAsync("~/Pages/Shared/_Header.cshtml", Model)

    <div class="main-container">
        
        @await Html.PartialAsync("~/Pages/Shared/_Sidebar.cshtml")

        <main class="main-content">
            <div class="dashboard-header userlist-header-flex">
                <h1 class="page-title">Quản lý người dùng</h1>
                <button class="userlist-add-btn" type="button" data-bs-toggle="modal" data-bs-target="#addUserModal">
                    <i class="fas fa-plus"></i> Thêm người dùng
                </button>
            </div>

            <div class="userlist-container">
                <div class="userlist-toolbar">
                    <div class="userlist-toolbar-left">
                        <label for="roleFilter" style="font-size:15px;margin-right:8px;color:#555;">Vai trò:</label>
                        <select id="roleFilter" class="userlist-filter" onchange="filterUsers()">
                            <option value="">Tất cả</option>
                            <option value="Admin">Quản trị viên</option>
                            <option value="Manager">Quản lý</option>
                            <option value="Staff">Nhân viên</option>
                            <option value="Cashier">Thu ngân</option>
                        </select>
                        <label for="statusFilter" style="font-size:15px;margin-left:16px;margin-right:8px;color:#555;">Trạng thái:</label>
                        <select id="statusFilter" class="userlist-filter" onchange="filterUsers()">
                            <option value="">Tất cả</option>
                            <option value="active">Đang hoạt động</option>
                            <option value="inactive">Đã khóa</option>
                        </select>
                    </div>
                    <div class="userlist-toolbar-right">
                        <label for="pageSize" style="font-size:15px;margin-right:8px;color:#555;">Hiển thị:</label>
                        <select id="pageSize" class="userlist-filter" style="width:auto;min-width:60px;" onchange="changePageSize()">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <input type="text" class="userlist-search" placeholder="Tìm kiếm..." onkeyup="filterUsers()" style="margin-left:12px;" />
                        <button class="userlist-filter-btn"><i class="fas fa-filter"></i></button>
                    </div>
                </div>

                <div class="userlist-table-wrapper">
                    <table class="userlist-table userlist-table-modern" id="userListTable">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Tên đăng nhập</th>
                                <th>Tên hiển thị</th>
                                <th>Email</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                                if (Model.Users != null && Model.Users.Count > 0)
                                {
                                    foreach (var user in Model.Users)
                                    {
                                        <tr data-role="@user.VaiTro" data-status="@(user.TrangThaiHoatDong ? "active" : "inactive")" data-search="@user.TenNguoiDung @user.TenHienThi @user.Email">
                                            <td>@stt</td>
                                            <td>@user.TenNguoiDung</td>
                                            <td>@(user.TenHienThi ?? "N/A")</td>
                                            <td>@(user.Email ?? "N/A")</td>
                                            <td>
                                                <span class="badge bg-@(GetRoleBadgeColor(user.VaiTro))">
                                                    @GetRoleDisplayName(user.VaiTro)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@(user.TrangThaiHoatDong ? "success" : "danger")">
                                                    @(user.TrangThaiHoatDong ? "Hoạt động" : "Tạm khóa")
                                                </span>
                                            </td>
                                            <td>@user.CreateTime.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-outline-primary" 
                                                            onclick="editUser('@user.ID', '@user.TenNguoiDung', '@user.VaiTro', @user.TrangThaiHoatDong.ToString().ToLower(), '@user.Email', '@user.TenHienThi')"
                                                            title="Chỉnh sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-@(user.TrangThaiHoatDong ? "warning" : "success")"
                                                            onclick="toggleUserStatus('@user.ID')"
                                                            title="@(user.TrangThaiHoatDong ? "Khóa tài khoản" : "Kích hoạt tài khoản")">
                                                        <i class="fas fa-@(user.TrangThaiHoatDong ? "lock" : "unlock")"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger"
                                                            onclick="deleteUser('@user.ID', '@user.TenNguoiDung')"
                                                            title="Xóa">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        stt++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">Không có người dùng nào</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div id="userlist-pagination"></div>
            </div>
        </main>
    </div>

    <!-- Modal Thêm người dùng -->
    <div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addUserModalLabel">Thêm người dùng mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="addUserForm">
                        <div class="mb-3">
                            <label for="addUserName" class="form-label">Tên đăng nhập</label>
                            <input type="text" class="form-control" id="addUserName" required>
                        </div>
                        <div class="mb-3">
                            <label for="addDisplayName" class="form-label">Tên hiển thị</label>
                            <input type="text" class="form-control" id="addDisplayName">
                        </div>
                        <div class="mb-3">
                            <label for="addEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="addEmail">
                        </div>
                        <div class="mb-3">
                            <label for="addPassword" class="form-label">Mật khẩu</label>
                            <input type="password" class="form-control" id="addPassword" required>
                        </div>
                        <div class="mb-3">
                            <label for="addRole" class="form-label">Vai trò</label>
                            <select class="form-select" id="addRole" required>
                                <option value="">Chọn vai trò</option>
                                <option value="Admin">Quản trị viên</option>
                                <option value="Manager">Quản lý</option>
                                <option value="Staff">Nhân viên</option>
                                <option value="Cashier">Thu ngân</option>
                            </select>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="addIsActive" checked>
                            <label class="form-check-label" for="addIsActive">Tài khoản hoạt động</label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary" onclick="saveUser()">Lưu</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Sửa người dùng -->
    <div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">Chỉnh sửa người dùng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="editUserForm">
                        <input type="hidden" id="editUserId">
                        <div class="mb-3">
                            <label for="editUserName" class="form-label">Tên đăng nhập</label>
                            <input type="text" class="form-control" id="editUserName" required>
                        </div>
                        <div class="mb-3">
                            <label for="editDisplayName" class="form-label">Tên hiển thị</label>
                            <input type="text" class="form-control" id="editDisplayName">
                        </div>
                        <div class="mb-3">
                            <label for="editEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="editEmail">
                        </div>
                        <div class="mb-3">
                            <label for="editRole" class="form-label">Vai trò</label>
                            <select class="form-select" id="editRole" required>
                                <option value="">Chọn vai trò</option>
                                <option value="Admin">Quản trị viên</option>
                                <option value="Manager">Quản lý</option>
                                <option value="Staff">Nhân viên</option>
                                <option value="Cashier">Thu ngân</option>
                            </select>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="editIsActive">
                            <label class="form-check-label" for="editIsActive">Tài khoản hoạt động</label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary" onclick="updateUser()">Cập nhật</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentPageNumber = 1;
        let currentPageSize = 10;
        let totalPages = 1;

        // Phân trang
        function changePageSize() {
            currentPageSize = parseInt(document.getElementById('pageSize').value);
            currentPageNumber = 1;
            updatePagination();
        }

        function goToPage(page) {
            currentPageNumber = page;
            updatePagination();
        }

        function updatePagination() {
            const table = document.getElementById('userListTable');
            const tbody = table.getElementsByTagName('tbody')[0];
            const allRows = Array.from(tbody.getElementsByTagName('tr')).filter(row => {
                const firstCell = row.getElementsByTagName('td')[0];
                return firstCell && firstCell.colSpan !== 8;
            });
            
            const totalRecords = allRows.length;
            totalPages = Math.ceil(totalRecords / currentPageSize);
            
            console.log('Total records:', totalRecords, 'Current page size:', currentPageSize, 'Total pages:', totalPages);
            
            // Ẩn tất cả các hàng
            allRows.forEach(row => row.style.display = 'none');
            
            // Hiển thị các hàng của trang hiện tại
            const startIndex = (currentPageNumber - 1) * currentPageSize;
            const endIndex = Math.min(startIndex + currentPageSize, totalRecords);
            
            for (let i = startIndex; i < endIndex; i++) {
                if (allRows[i]) {
                    allRows[i].style.display = '';
                    // Cập nhật số thứ tự
                    const sttCell = allRows[i].getElementsByTagName('td')[0];
                    sttCell.textContent = i + 1;
                }
            }
            
            renderPagination(totalRecords);
        }

        function renderPagination(totalRecords) {
            const paginationContainer = document.getElementById('userlist-pagination');
            
            // Luôn hiển thị phân trang nếu có nhiều hơn 1 trang
            if (totalPages <= 1) {
                paginationContainer.innerHTML = `<div class="userlist-pagination-container">
                    <div class="userlist-pagination-info">Hiển thị ${totalRecords} bản ghi</div>
                </div>`;
                return;
            }
            
            let paginationHTML = '<div class="userlist-pagination-container">';
            paginationHTML += `<div class="userlist-pagination-info">Hiển thị ${((currentPageNumber - 1) * currentPageSize) + 1}-${Math.min(currentPageNumber * currentPageSize, totalRecords)} trong tổng số ${totalRecords} bản ghi</div>`;
            paginationHTML += '<div class="userlist-pagination-controls">';
            
            // Nút Previous
            if (currentPageNumber > 1) {
                paginationHTML += `<button class="userlist-pagination-btn" onclick="goToPage(${currentPageNumber - 1})">‹ Trước</button>`;
            }
            
            // Hiển thị tất cả các trang nếu ít hơn 8 trang
            if (totalPages <= 7) {
                for (let i = 1; i <= totalPages; i++) {
                    const isActive = i === currentPageNumber ? 'userlist-pagination-btn-active' : '';
                    paginationHTML += `<button class="userlist-pagination-btn ${isActive}" onclick="goToPage(${i})">${i}</button>`;
                }
            } else {
                // Logic phức tạp hơn cho nhiều trang
                const startPage = Math.max(1, currentPageNumber - 2);
                const endPage = Math.min(totalPages, startPage + 4);
                
                if (startPage > 1) {
                    paginationHTML += '<button class="userlist-pagination-btn" onclick="goToPage(1)">1</button>';
                    if (startPage > 2) {
                        paginationHTML += '<span class="userlist-pagination-ellipsis">...</span>';
                    }
                }
                
                for (let i = startPage; i <= endPage; i++) {
                    const isActive = i === currentPageNumber ? 'userlist-pagination-btn-active' : '';
                    paginationHTML += `<button class="userlist-pagination-btn ${isActive}" onclick="goToPage(${i})">${i}</button>`;
                }
                
                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        paginationHTML += '<span class="userlist-pagination-ellipsis">...</span>';
                    }
                    paginationHTML += `<button class="userlist-pagination-btn" onclick="goToPage(${totalPages})">${totalPages}</button>`;
                }
            }
            
            // Nút Next
            if (currentPageNumber < totalPages) {
                paginationHTML += `<button class="userlist-pagination-btn" onclick="goToPage(${currentPageNumber + 1})">Sau ›</button>`;
            }
            
            paginationHTML += '</div></div>';
            paginationContainer.innerHTML = paginationHTML;
        }

        // Lọc và tìm kiếm
        function filterUsers() {
            const roleFilter = document.getElementById('roleFilter').value.toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value.toLowerCase();
            const searchTerm = document.querySelector('.userlist-search').value.toLowerCase();
            
            const table = document.getElementById('userListTable');
            const tbody = table.getElementsByTagName('tbody')[0];
            const rows = Array.from(tbody.getElementsByTagName('tr')).filter(row => 
                row.getElementsByTagName('td')[0].colSpan !== 8
            );
            
            rows.forEach(row => {
                const role = row.getAttribute('data-role').toLowerCase();
                const status = row.getAttribute('data-status').toLowerCase();
                const searchData = row.getAttribute('data-search').toLowerCase();
                
                const roleMatch = !roleFilter || role.includes(roleFilter);
                const statusMatch = !statusFilter || status === statusFilter;
                const searchMatch = !searchTerm || searchData.includes(searchTerm);
                
                if (roleMatch && statusMatch && searchMatch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
            
            // Reset về trang đầu và cập nhật phân trang
            currentPageNumber = 1;
            updatePagination();
        }

        // API Functions
        function saveUser() {
            const userData = {
                Username: document.getElementById('addUserName').value,
                FullName: document.getElementById('addDisplayName').value,
                Email: document.getElementById('addEmail').value,
                Password: document.getElementById('addPassword').value,
                Role: document.getElementById('addRole').value
            };

            fetch('/api/Authorization/Users', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(userData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('addUserModal')).hide();
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi thêm người dùng');
            });
        }

        function editUser(id, username, role, isActive, email, displayName) {
            document.getElementById('editUserId').value = id;
            document.getElementById('editUserName').value = username;
            document.getElementById('editDisplayName').value = displayName || '';
            document.getElementById('editEmail').value = email || '';
            document.getElementById('editRole').value = role;
            document.getElementById('editIsActive').checked = isActive;
            
            new bootstrap.Modal(document.getElementById('editUserModal')).show();
        }

        function updateUser() {
            const id = document.getElementById('editUserId').value;
            const userData = {
                Role: document.getElementById('editRole').value,
                IsActive: document.getElementById('editIsActive').checked,
                Email: document.getElementById('editEmail').value,
                FullName: document.getElementById('editDisplayName').value
            };

            fetch(`/api/Authorization/Users/${id}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(userData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('editUserModal')).hide();
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi cập nhật người dùng');
            });
        }

        function toggleUserStatus(id) {
            fetch(`/api/Authorization/Users/${id}/toggle-status`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi thay đổi trạng thái');
            });
        }

        function deleteUser(id, username) {
            fetch(`/api/Authorization/Users/${id}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi xóa người dùng');
            });
        }

        // Khởi tạo phân trang khi trang load xong
        document.addEventListener('DOMContentLoaded', function() {
            updatePagination();
        });
    </script>

</body>
</html>

@functions {
    private string GetRoleBadgeColor(string role)
    {
        return role switch
        {
            "Admin" => "danger",
            "Manager" => "warning",
            "Staff" => "info",
            "Cashier" => "success",
            _ => "secondary"
        };
    }

    private string GetRoleDisplayName(string role)
    {
        return role switch
        {
            "Admin" => "Quản trị viên",
            "Manager" => "Quản lý",
            "Staff" => "Nhân viên", 
            "Cashier" => "Thu ngân",
            _ => role
        };
    }
}
