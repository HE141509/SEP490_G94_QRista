@functions {
    private string GetRoleBadgeColor(string role)
    {
        return role switch
        {
            "Admin" => "danger",
            "Manager" => "warning",
            "Staff" => "info",
            "Cashier" => "success",
            _ => "secondary"
        };
    }

    private string GetRoleDisplayName(string role)
    {
        return role switch
        {
            "Admin" => "Quản trị viên",
            "Manager" => "Quản lý",
            "Staff" => "Nhân viên", 
            "Cashier" => "Thu ngân",
            _ => role
        };
    }
}
