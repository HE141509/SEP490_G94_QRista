        // Functions for branch assignment
        function assignBranches(userId, userName) {
            document.getElementById('assignUserId').value = userId;
            document.getElementById('assignUserName').textContent = userName;
            
            // Show modal
            new bootstrap.Modal(document.getElementById('assignBranchModal')).show();
            
            // Load branches and user's current branch assignments
            loadBranchesForUser(userId);
        }

        function loadBranchesForUser(userId) {
            const branchListContainer = document.getElementById('branchList');
            branchListContainer.innerHTML = `
                <div class="loading-spinner">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <div class="mt-2 text-muted">Đang tải danh sách chi nhánh...</div>
                </div>
            `;

            // Load all branches
            Promise.all([
                fetch('/api/branches').then(response => response.json()),
                fetch(`/api/user-branches/${userId}`).then(response => response.json())
            ])
            .then(([branchesResult, userBranchesResult]) => {
                const branches = branchesResult.success ? branchesResult.data : [];
                const userBranches = userBranchesResult.success ? userBranchesResult.data : [];
                
                displayBranches(branches, userBranches);
            })
            .catch(error => {
                console.error('Error loading branches:', error);
                branchListContainer.innerHTML = `
                    <div class="alert alert-danger alert-custom">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Lỗi!</strong> Có lỗi xảy ra khi tải danh sách chi nhánh
                    </div>
                `;
            });
        }

        function displayBranches(branches, userBranches) {
            const branchListContainer = document.getElementById('branchList');
            
            if (!branches || branches.length === 0) {
                branchListContainer.innerHTML = `
                    <div class="alert alert-info alert-custom">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Thông báo:</strong> Không có chi nhánh nào trong hệ thống
                    </div>
                `;
                return;
            }

            let html = '';
            branches.forEach((branch, index) => {
                const isAssigned = userBranches.some(ub => ub.branchId === branch.id && ub.isActive);
                html += `
                    <div class="branch-item ${isAssigned ? 'checked' : ''}" style="animation-delay: ${index * 0.1}s;">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="${branch.id}" 
                                   id="branch_${branch.id}" ${isAssigned ? 'checked' : ''}
                                   onchange="toggleBranchSelection(this)">
                            <label class="form-check-label w-100" for="branch_${branch.id}">
                                <div class="branch-name">${branch.tenChiNhanh}</div>
                                <div class="branch-code">
                                    <i class="fas fa-code me-1"></i>Mã: ${branch.maChiNhanh || 'N/A'}
                                </div>
                            </label>
                        </div>
                    </div>
                `;
            });

            branchListContainer.innerHTML = html;
            
            // Add fade-in animation
            setTimeout(() => {
                const items = branchListContainer.querySelectorAll('.branch-item');
                items.forEach(item => {
                    item.style.opacity = '0';
                    item.style.transform = 'translateY(20px)';
                    item.style.animation = 'fadeInUp 0.5s ease forwards';
                });
            }, 50);
        }

        function toggleBranchSelection(checkbox) {
            const branchItem = checkbox.closest('.branch-item');
            if (checkbox.checked) {
                branchItem.classList.add('checked');
            } else {
                branchItem.classList.remove('checked');
            }
        }

        function selectAllBranches() {
            const checkboxes = document.querySelectorAll('#branchList input[type="checkbox"]');
            const branchItems = document.querySelectorAll('#branchList .branch-item');
            
            checkboxes.forEach((checkbox, index) => {
                checkbox.checked = true;
                setTimeout(() => {
                    branchItems[index].classList.add('checked');
                }, index * 50);
            });
        }

        function deselectAllBranches() {
            const checkboxes = document.querySelectorAll('#branchList input[type="checkbox"]');
            const branchItems = document.querySelectorAll('#branchList .branch-item');
            
            checkboxes.forEach((checkbox, index) => {
                checkbox.checked = false;
                setTimeout(() => {
                    branchItems[index].classList.remove('checked');
                }, index * 50);
            });
        }

        function saveBranchAssignments() {
            const userId = document.getElementById('assignUserId').value;
            const checkboxes = document.querySelectorAll('#branchList input[type="checkbox"]');
            const selectedBranches = [];

            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    selectedBranches.push(checkbox.value);
                }
            });

            const assignmentData = {
                userId: userId,
                branchIds: selectedBranches
            };

            fetch('/api/user-branches/assign', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(assignmentData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('assignBranchModal')).hide();
                    alert('Phân quyền chi nhánh thành công!');
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi lưu phân quyền chi nhánh');
            });
        }

        // VALIDATION FUNCTIONS
        function validateField(field) {
            if (!field) return false;
            
            let value = field.value ? field.value.trim() : '';
            let isValid = true;
            let errorMessage = '';
            
            // Clear existing validation errors
            clearValidationError(field);
            
            // Check if field is required and empty
            if (field.hasAttribute('required') && !value) {
                if (field.tagName === 'SELECT') {
                    errorMessage = 'Vui lòng chọn một tùy chọn';
                } else if (field.type === 'password') {
                    errorMessage = 'Vui lòng nhập mật khẩu';
                } else if (field.type === 'email') {
                    errorMessage = 'Vui lòng nhập email';
                } else {
                    errorMessage = 'Trường này là bắt buộc';
                }
                isValid = false;
            }
            
            // Additional validation rules
            if (value && field.type === 'text') {
                if (field.id.includes('UserName') && value.length < 3) {
                    errorMessage = 'Tên đăng nhập phải có ít nhất 3 ký tự';
                    isValid = false;
                }
                if (field.id.includes('DisplayName') && value.length < 2) {
                    errorMessage = 'Tên hiển thị phải có ít nhất 2 ký tự';
                    isValid = false;
                }
            }
            
            if (value && field.type === 'password' && value.length < 6) {
                errorMessage = 'Mật khẩu phải có ít nhất 6 ký tự';
                isValid = false;
            }

            if (value && field.type === 'email') {
                const emailRegex = /^[^\\s@@]+@@[^\\s@@]+\\.[^\\s@@]+$/;
                if (!emailRegex.test(value)) {
                    errorMessage = 'Email không hợp lệ';
                    isValid = false;
                }
            }
            
            if (!isValid) {
                showValidationError(field, errorMessage);
            }
            
            return isValid;
        }
        
        function showValidationError(field, message) {
            field.classList.add('validation-error');
            
            // Remove existing error message
            let existingError = field.parentNode.querySelector('.validation-error-message');
            if (existingError) {
                existingError.remove();
            }
            
            // Add error message
            if (message) {
                let errorSpan = document.createElement('span');
                errorSpan.className = 'validation-error-message';
                errorSpan.textContent = message;
                field.parentNode.appendChild(errorSpan);
            }
        }
        
        function clearValidationError(field) {
            if (!field) return;
            
            field.classList.remove('validation-error');
            
            // Remove error message
            let errorMsg = field.parentNode.querySelector('.validation-error-message');
            if (errorMsg) {
                errorMsg.remove();
            }
        }
        
        function clearAllValidationErrors() {
            document.querySelectorAll('.validation-error').forEach(field => {
                clearValidationError(field);
            });
        }
        
        function validateForm(formId) {
            let form = document.getElementById(formId);
            if (!form) return false;
            
            let isValid = true;
            let requiredFields = form.querySelectorAll('[required]');
            
            requiredFields.forEach(field => {
                if (!validateField(field)) {
                    isValid = false;
                }
            });
            
            // Focus on first error field
            if (!isValid) {
                let firstErrorField = form.querySelector('.validation-error');
                if (firstErrorField) {
                    firstErrorField.focus();
                }
            }
            
            return isValid;
        }

