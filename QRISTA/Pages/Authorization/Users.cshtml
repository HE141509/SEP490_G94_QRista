        function populateRoleDropdowns(roles) {
            const addRoleSelect = document.getElementById('addRole');
            const editRoleSelect = document.getElementById('editRole');
            const roleFilterSelect = document.getElementById('roleFilter');

            addRoleSelect.innerHTML = '<option value="">Chọn vai trò</option>';
            editRoleSelect.innerHTML = '<option value="">Chọn vai trò</option>';
            
            roleFilterSelect.innerHTML = '<option value="">Tất cả</option>';

            if (roles && roles.length > 0) {
                roles.forEach(role => {
                    const addOption = new Option(role.display, role.value);
                    const editOption = new Option(role.display, role.value);
                    const filterOption = new Option(role.display, role.value);

                    addRoleSelect.appendChild(addOption);
                    editRoleSelect.appendChild(editOption);
                    roleFilterSelect.appendChild(filterOption);
                });
            } else {
                const noRoleOption = new Option('Không có vai trò nào', '');
                noRoleOption.disabled = true;
                addRoleSelect.appendChild(noRoleOption);
                editRoleSelect.appendChild(noRoleOption.cloneNode(true));
            }
        }

        function populateBranchDropdown(branches) {
            const addBranchSelect = document.getElementById('addBranch');
            
            addBranchSelect.innerHTML = '<option value="">Chọn chi nhánh</option>';

            if (branches && branches.length > 0) {
                branches.forEach(branch => {
                    const option = new Option(branch.tenChiNhanh, branch.id);
                    addBranchSelect.appendChild(option);
                });
            } else {
                const noBranchOption = new Option('Không có chi nhánh nào', '');
                noBranchOption.disabled = true;
                addBranchSelect.appendChild(noBranchOption);
            }
