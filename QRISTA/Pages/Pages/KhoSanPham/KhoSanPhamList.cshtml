@page
@model QRB.Pages.KhoSanPham.KhoSanPhamListModel
@{
    ViewData["Title"] = "Danh sách kho sản phẩm";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/userlist.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    @await Html.PartialAsync("~/Pages/Shared/_Header.cshtml", Model)
    <div class="main-container">
        @await Html.PartialAsync("~/Pages/Shared/_Sidebar.cshtml", Model)
        <main class="main-content">
            <div class="dashboard-header userlist-header-flex">
                <h1 class="page-title">Danh sách kho sản phẩm</h1>
                <button class="userlist-add-btn" type="button" id="showAddKhoSanPhamBtn">
                    <i class="fas fa-plus"></i> Thêm mới
                </button>
            </div>
            <div class="userlist-card userlist-modern">
                <div class="userlist-toolbar">
                    <div class="userlist-toolbar-left">
                        <label for="filterKhoSanPhamStatus">Trạng thái:</label>
                        <select id="filterKhoSanPhamStatus" class="userlist-filter">
                            @if (Model.Status == "inactive") {
                                <option value="active">Đang hoạt động</option>
                                <option value="inactive" selected>Đã xóa</option>
                            } else {
                                <option value="active" selected>Đang hoạt động</option>
                                <option value="inactive">Đã xóa</option>
                            }
                        </select>
                    </div>
                    <div class="userlist-toolbar-right">
                        <label for="khoSanPhamPageSize" style="font-size:15px;margin-right:8px;color:#555;">Hiển thị:</label>
                        <select id="khoSanPhamPageSize" class="userlist-filter" style="width:auto;min-width:60px;" onchange="changeKhoSanPhamPageSize()">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <input type="text" class="userlist-search" placeholder="Tìm kiếm..." onkeyup="filterKhoSanPhamList()" style="margin-left:12px;" />
                    </div>
                </div>
                <table class="userlist-table userlist-table-modern" id="khoSanPhamListTable">
                    <thead>
                        <tr>
                            <th>Nguyên liệu</th>
                            <th>Số lượng còn lại</th>
                            <th>Chi nhánh</th>
                            <th>Ngày tạo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.KhoSanPhamList != null && Model.KhoSanPhamList.Any())
                        {
                            foreach (var item in Model.KhoSanPhamList)
                            {
                                <tr>
                                    <td>
                                        <span style="cursor:pointer;color:#4285f4;text-decoration:underline;" onclick="showEditKhoSanPhamModal('@item.ID', '@item.IDNguyenLieu', '@item.TenNguyenLieu', '@item.SoLuongConLai', '@item.IDChiNhanh', '@item.TenChiNhanh')">@item.TenNguyenLieu</span>
                                    </td>
                                    <td>@(int.TryParse(item.SoLuongConLai, out var soLuong) ? soLuong.ToString("N0") : item.SoLuongConLai)</td>
                                    <td>@item.TenChiNhanh</td>
                                    <td>@item.CreateTime.ToString("dd/MM/yyyy")</td>
                                    <td>
@if (!item.IsDelete)
{
    <button class="userlist-action-btn" title="Xóa" onclick="showDeleteKhoSanPhamConfirm('@item.ID')" style="color:#ea4335;background:none;border:none;padding:0;">
        <i class="fas fa-trash"></i>
    </button>
}
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="text-align:center;">Không có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="userlist-pagination" id="khosanpham-pagination"></div>
        <script>
            window.khoSanPhamListData = [
            @foreach (var item in Model.KhoSanPhamList)
            {
                <text>{
                    ID: '@item.ID',
                    TenNguyenLieu: '@item.TenNguyenLieu',
                    SoLuongConLai: '@item.SoLuongConLai',
                    TenChiNhanh: '@item.TenChiNhanh',
                    CreateTime: '@item.CreateTime.ToString("dd/MM/yyyy")',
                    IsDelete: @item.IsDelete.ToString().ToLower(),
                    IDNguyenLieu: '@item.IDNguyenLieu',
                    IDChiNhanh: '@item.IDChiNhanh'
                },</text>
            }
            ];
        </script>
        <script>
// Phân trang cho KhoSanPhamList

let khoSanPhamData = [];
let khoSanPhamPageSize = 10;
let khoSanPhamPageIndex = 1;
let khoSanPhamFilteredData = [];

function renderKhoSanPhamTable() {
    const tbody = document.querySelector('#khoSanPhamListTable tbody');
    tbody.innerHTML = '';
    const start = (khoSanPhamPageIndex - 1) * khoSanPhamPageSize;
    const end = start + khoSanPhamPageSize;
    const pageData = khoSanPhamFilteredData.slice(start, end);
    const paginationContainer = document.getElementById('khosanpham-pagination');
    if (pageData.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;">Không có dữ liệu</td></tr>`;
        if (paginationContainer) paginationContainer.innerHTML = '';
        return;
    }
    for (const item of pageData) {
        tbody.innerHTML += `<tr>
            <td><span style="cursor:pointer;color:#4285f4;text-decoration:underline;" onclick="showEditKhoSanPhamModal('${item.ID}', '${item.IDNguyenLieu}', '${item.TenNguyenLieu}', '${item.SoLuongConLai}', '${item.IDChiNhanh}', '${item.TenChiNhanh}')">${item.TenNguyenLieu}</span></td>
            <td>${parseInt(item.SoLuongConLai).toLocaleString()}</td>
            <td>${item.TenChiNhanh}</td>
            <td>${item.CreateTime}</td>
            <td>
                ${!item.IsDelete ? `<button class='userlist-action-btn' title='Xóa' onclick="showDeleteKhoSanPhamConfirm('${item.ID}')" style='color:#ea4335;background:none;border:none;padding:0;'><i class='fas fa-trash'></i></button>` : ''}
            </td>
        </tr>`;
    }
    renderKhoSanPhamPagination();
}
function renderKhoSanPhamPagination() {
    const total = khoSanPhamFilteredData.length;
    const pageCount = Math.ceil(total / khoSanPhamPageSize);
    const container = document.getElementById('khosanpham-pagination');
    container.innerHTML = '';
    if (pageCount <= 1 || total === 0) return;
    for (let i = 1; i <= pageCount; i++) {
        const btn = document.createElement('button');
        btn.textContent = i;
        btn.className = 'pagination-btn' + (i === khoSanPhamPageIndex ? ' active' : '');
        btn.onclick = () => {
            khoSanPhamPageIndex = i;
            renderKhoSanPhamTable();
        };
        container.appendChild(btn);
    }
}

function changeKhoSanPhamPageSize() {
    const select = document.getElementById('khoSanPhamPageSize');
    khoSanPhamPageSize = parseInt(select.value);
    khoSanPhamPageIndex = 1;
    renderKhoSanPhamTable();
}


function filterKhoSanPhamList() {
    const searchInput = document.querySelector('.userlist-search');
    const searchText = searchInput ? searchInput.value.trim().toLowerCase() : '';
    khoSanPhamFilteredData = khoSanPhamData.filter(item => {
        if (searchText) {
            return (
                (item.TenNguyenLieu && item.TenNguyenLieu.toLowerCase().includes(searchText)) ||
                (item.TenChiNhanh && item.TenChiNhanh.toLowerCase().includes(searchText))
            );
        }
        return true;
    });
    khoSanPhamPageIndex = 1;
    renderKhoSanPhamTable();
}

document.addEventListener('DOMContentLoaded', function () {
    // Lấy dữ liệu từ biến ẩn hoặc ajax, ở đây demo lấy từ biến toàn cục
    if (window.khoSanPhamListData) {
        khoSanPhamData = window.khoSanPhamListData;
    }
    filterKhoSanPhamList();
    document.getElementById('khoSanPhamPageSize').addEventListener('change', changeKhoSanPhamPageSize);
    document.getElementById('filterKhoSanPhamStatus').addEventListener('change', function() {
        const status = this.value;
        const url = new URL(window.location.href);
        url.searchParams.set('status', status);
        window.location.href = url.toString();
    });
    const searchInput = document.querySelector('.userlist-search');
    if (searchInput) {
        searchInput.addEventListener('keyup', filterKhoSanPhamList);
    }
});
        </script>
            </div>
        </main>
    </div>
    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
    <!-- Modal sửa Kho Sản Phẩm -->
    <div id="editKhoSanPhamModal" class="modal" style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
        <div class="modal-content userlist-add-modal-content">
            <div class="userlist-add-modal-title"><i class="fas fa-edit"></i> Sửa kho sản phẩm</div>
            <form id="editKhoSanPhamForm" autocomplete="off">
                <input type="hidden" id="editKhoSanPhamId" name="Id" />
                <input type="hidden" id="editKhoSanPhamIDNguyenLieu" name="IDNguyenLieu" />
                <input type="hidden" id="editKhoSanPhamIDChiNhanh" name="IDChiNhanh" />
                <div class="userlist-add-form-group">
                    <label for="editKhoSanPhamTenNguyenLieu">Tên nguyên liệu</label>
                    <input type="text" id="editKhoSanPhamTenNguyenLieu" name="TenNguyenLieu" class="userlist-input" readonly style="background-color:#f5f5f5;color:#666;" />
                </div>
                <div class="userlist-add-form-group">
                    <label for="editKhoSanPhamTenChiNhanh">Chi nhánh</label>
                    <input type="text" id="editKhoSanPhamTenChiNhanh" name="TenChiNhanh" class="userlist-input" readonly style="background-color:#f5f5f5;color:#666;" />
                </div>
                <div class="userlist-add-form-group">
                    <label for="editKhoSanPhamSoLuongConLai">Số lượng còn lại</label>
                    <input type="text" id="editKhoSanPhamSoLuongConLai" name="SoLuongConLai" class="userlist-input" required />
                </div>
                <div class="userlist-add-modal-actions">
                    <button type="button" onclick="closeEditKhoSanPhamModal()" class="userlist-add-cancel-btn">Hủy</button>
                    <button type="submit" class="userlist-add-submit-btn">Lưu</button>
                </div>
            </form>
        </div>
    </div>
    <!-- Modal thêm mới Kho Sản Phẩm -->
    <div id="addKhoSanPhamModal" class="modal" style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
        <div class="modal-content userlist-add-modal-content">
            <div class="userlist-add-modal-title"><i class="fas fa-plus"></i> Thêm kho sản phẩm mới</div>
            <form id="addKhoSanPhamForm" autocomplete="off">
                <div class="userlist-add-form-group">
                    <label for="addKhoSanPhamIDNguyenLieu">Nguyên liệu</label>
                    <div class="searchable-select" id="searchableNguyenLieu">
                        <input type="text" 
                               id="addKhoSanPhamIDNguyenLieu" 
                               name="IDNguyenLieu" 
                               class="userlist-input" 
                               placeholder="Tìm kiếm nguyên liệu..." 
                               autocomplete="off"
                               required />
                        <div class="searchable-options" id="nguyenLieuOptions">
                            @foreach (var nguyenLieu in Model.NguyenLieuList)
                            {
                                <div class="searchable-option" data-value="@nguyenLieu.ID" data-text="@nguyenLieu.TenNguyenLieu">
                                    @nguyenLieu.TenNguyenLieu
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="userlist-add-form-group">
                    <label for="addKhoSanPhamIDChiNhanh">Chi nhánh</label>
                    <div class="searchable-select" id="searchableChiNhanh">
                        <input type="text" 
                               id="addKhoSanPhamIDChiNhanh" 
                               name="IDChiNhanh" 
                               class="userlist-input" 
                               placeholder="Tìm kiếm chi nhánh..." 
                               autocomplete="off"
                               required />
                        <div class="searchable-options" id="chiNhanhOptions">
                            @foreach (var chiNhanh in Model.ChiNhanhList)
                            {
                                <div class="searchable-option" data-value="@chiNhanh.ID" data-text="@chiNhanh.TenChiNhanh">
                                    @chiNhanh.TenChiNhanh
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="userlist-add-form-group">
                    <label for="addKhoSanPhamSoLuongConLai">Số lượng còn lại</label>
                    <input type="text" id="addKhoSanPhamSoLuongConLai" name="SoLuongConLai" class="userlist-input" required placeholder="Nhập số lượng..." />
                </div>
                <div class="userlist-add-modal-actions">
                    <button type="button" onclick="closeAddKhoSanPhamModal()" class="userlist-add-cancel-btn">Hủy</button>
                    <button type="submit" class="userlist-add-submit-btn">Thêm mới</button>
                </div>
            </form>
        </div>
    </div>
    <!-- Modal thêm mới và sửa sẽ bổ sung sau -->
</main>
    <!-- Modal xác nhận xóa Kho Sản Phẩm -->
    <div id="deleteKhoSanPhamModal" class="modal" style="display:none;position:fixed;z-index:3000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.18);justify-content:center;align-items:center;">
        <div class="modal-content" style="background:#fff;padding:32px 28px 24px 28px;border-radius:12px;box-shadow:0 2px 16px rgba(0,0,0,0.12);min-width:320px;max-width:90vw;text-align:center;">
            <div style="font-size:20px;font-weight:600;color:#ea4335;margin-bottom:18px;"><i class="fas fa-exclamation-triangle"></i> Xác nhận xóa kho sản phẩm</div>
            <div style="font-size:16px;color:#333;margin-bottom:24px;">Bạn có chắc chắn muốn xóa kho sản phẩm này không?</div>
            <div style="display:flex;justify-content:center;gap:18px;">
                <button onclick="confirmDeleteKhoSanPham()" style="background:#ea4335;color:#fff;border:none;padding:8px 22px;border-radius:6px;font-size:15px;font-weight:500;cursor:pointer;">Xác nhận</button>
                <button onclick="closeDeleteKhoSanPhamModal()" style="background:#f5f7fa;color:#333;border:none;padding:8px 22px;border-radius:6px;font-size:15px;font-weight:500;cursor:pointer;">Hủy</button>
            </div>
        </div>
    </div>
    <script>
        let khoSanPhamDeleteId = null;
        
        // === SEARCHABLE DROPDOWN ===
        
        function initSearchableDropdown(inputId, optionsId) {
            const input = document.getElementById(inputId);
            const optionsContainer = document.getElementById(optionsId);
            const options = optionsContainer.querySelectorAll('.searchable-option');
            let selectedValue = '';
            let selectedText = '';
            
            // Hiển thị dropdown khi focus
            input.addEventListener('focus', function() {
                optionsContainer.style.display = 'block';
                filterOptions('');
            });
            
            // Ẩn dropdown khi click ra ngoài
            document.addEventListener('click', function(e) {
                if (!input.contains(e.target) && !optionsContainer.contains(e.target)) {
                    optionsContainer.style.display = 'none';
                }
            });
            
            // Tìm kiếm khi gõ
            input.addEventListener('input', function() {
                const searchText = this.value.toLowerCase();
                filterOptions(searchText);
                selectedValue = '';
                selectedText = '';
            });
            
            // Chọn option
            options.forEach(option => {
                option.addEventListener('click', function() {
                    selectedValue = this.getAttribute('data-value');
                    selectedText = this.getAttribute('data-text');
                    input.value = selectedText;
                    input.setAttribute('data-value', selectedValue);
                    optionsContainer.style.display = 'none';
                    
                    // Highlight selected option
                    options.forEach(opt => opt.classList.remove('selected'));
                    this.classList.add('selected');
                });
            });
            
            // Filter options based on search
            function filterOptions(searchText) {
                options.forEach(option => {
                    const optionText = option.getAttribute('data-text').toLowerCase();
                    if (optionText.includes(searchText)) {
                        option.style.display = 'block';
                    } else {
                        option.style.display = 'none';
                    }
                });
            }
            
            // Get selected value
            input.getSelectedValue = function() {
                return selectedValue || this.getAttribute('data-value') || '';
            };
        }
        
        // === MODAL THÊM MỚI ===
        
        // Hiển thị modal thêm mới
        document.getElementById('showAddKhoSanPhamBtn').onclick = function() {
            document.getElementById('addKhoSanPhamModal').style.display = 'flex';
            
            // Khởi tạo searchable dropdown
            setTimeout(() => {
                initSearchableDropdown('addKhoSanPhamIDNguyenLieu', 'nguyenLieuOptions');
                initSearchableDropdown('addKhoSanPhamIDChiNhanh', 'chiNhanhOptions');
            }, 100);
        };

        // Đóng modal thêm mới
        function closeAddKhoSanPhamModal() {
            document.getElementById('addKhoSanPhamModal').style.display = 'none';
            document.getElementById('addKhoSanPhamForm').reset();
            
            // Reset searchable dropdowns
            document.getElementById('addKhoSanPhamIDNguyenLieu').removeAttribute('data-value');
            document.getElementById('addKhoSanPhamIDChiNhanh').removeAttribute('data-value');
            
            // Remove selected class from options
            document.querySelectorAll('.searchable-option.selected').forEach(opt => {
                opt.classList.remove('selected');
            });
        }

        // Xử lý form thêm mới kho sản phẩm
        document.getElementById('addKhoSanPhamForm').onsubmit = function(e) {
            e.preventDefault();
            var form = e.target;
            
            // Lấy giá trị từ searchable dropdown
            var nguyenLieuInput = document.getElementById('addKhoSanPhamIDNguyenLieu');
            var chiNhanhInput = document.getElementById('addKhoSanPhamIDChiNhanh');
            
            var data = {
                IDNguyenLieu: nguyenLieuInput.getSelectedValue(),
                IDChiNhanh: chiNhanhInput.getSelectedValue(),
                SoLuongConLai: parseInt(form.SoLuongConLai.value.replace(/[^\d]/g, '')) || 0
            };
            
            // Validation
            if (!data.IDNguyenLieu) {
                alert('Vui lòng chọn nguyên liệu!');
                return;
            }
            if (!data.IDChiNhanh) {
                alert('Vui lòng chọn chi nhánh!');
                return;
            }
            if (data.SoLuongConLai <= 0) {
                alert('Vui lòng nhập số lượng hợp lệ!');
                return;
            }
            
            console.log('Adding data:', data); // Debug log
            
            fetch('/KhoSanPham/AddKhoSanPham?handler=Add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(res => {
                console.log('Add response status:', res.status); // Debug log
                return res.json();
            })
            .then(resp => {
                console.log('Add response data:', resp); // Debug log
                if (resp.success) {
                    alert('Thêm mới thành công!');
                    location.reload();
                } else {
                    alert(resp.message || 'Thêm mới thất bại!');
                }
            })
            .catch(err => {
                console.error('Add Error:', err);
                alert('Có lỗi xảy ra: ' + err.message);
            });
        };

        // Định dạng số khi nhập vào trường số lượng thêm mới
        document.getElementById('addKhoSanPhamSoLuongConLai').addEventListener('input', function(e) {
            let val = e.target.value.replace(/[^\d]/g, '');
            e.target.value = formatNumberInput(val);
        });
        
        // === MODAL XÓA ===
        
        function showDeleteKhoSanPhamConfirm(id) {
            khoSanPhamDeleteId = id;
            document.getElementById('deleteKhoSanPhamModal').style.display = 'flex';
        }
        function closeDeleteKhoSanPhamModal() {
            khoSanPhamDeleteId = null;
            document.getElementById('deleteKhoSanPhamModal').style.display = 'none';
        }
        function confirmDeleteKhoSanPham() {
            if (!khoSanPhamDeleteId) return;
            fetch('/KhoSanPham/DeleteKhoSanPham?handler=Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ id: khoSanPhamDeleteId })
            })
            .then(res => res.json())
            .then(resp => {
                if (resp.success) {
                    location.reload();
                } else {
                    alert(resp.message || 'Xóa thất bại!');
                }
            })
            .catch(() => alert('Có lỗi xảy ra!'));
        }

        // Hàm định dạng số với dấu phẩy
        function formatNumberInput(val) {
            if (!val) return '';
            val = val.toString().replace(/[^\d]/g, '');
            return val.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        // Hiển thị modal sửa kho sản phẩm
        function showEditKhoSanPhamModal(id, idNguyenLieu, tenNguyenLieu, soLuongConLai, idChiNhanh, tenChiNhanh) {
            document.getElementById('editKhoSanPhamId').value = id;
            document.getElementById('editKhoSanPhamIDNguyenLieu').value = idNguyenLieu;
            document.getElementById('editKhoSanPhamIDChiNhanh').value = idChiNhanh;
            document.getElementById('editKhoSanPhamTenNguyenLieu').value = tenNguyenLieu;
            document.getElementById('editKhoSanPhamTenChiNhanh').value = tenChiNhanh;
            document.getElementById('editKhoSanPhamSoLuongConLai').value = formatNumberInput(soLuongConLai);
            document.getElementById('editKhoSanPhamModal').style.display = 'flex';
        }

        // Đóng modal sửa kho sản phẩm
        function closeEditKhoSanPhamModal() {
            document.getElementById('editKhoSanPhamModal').style.display = 'none';
            document.getElementById('editKhoSanPhamForm').reset();
        }

        // Xử lý form sửa kho sản phẩm
        document.getElementById('editKhoSanPhamForm').onsubmit = function(e) {
            e.preventDefault();
            var form = e.target;
            var data = {
                Id: form.Id.value,
                IDNguyenLieu: form.IDNguyenLieu.value,
                IDChiNhanh: form.IDChiNhanh.value,
                SoLuongConLai: parseInt(form.SoLuongConLai.value.replace(/[^\d]/g, '')) || 0
            };
            
            console.log('Sending data:', data); // Debug log
            
            fetch('/KhoSanPham/UpdateKhoSanPham?handler=Update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(res => {
                console.log('Response status:', res.status); // Debug log
                return res.json();
            })
            .then(resp => {
                console.log('Response data:', resp); // Debug log
                if (resp.success) {
                    alert('Cập nhật thành công!');
                    location.reload();
                } else {
                    alert(resp.message || 'Cập nhật thất bại!');
                }
            })
            .catch(err => {
                console.error('Error:', err);
                alert('Có lỗi xảy ra: ' + err.message);
            });
        };

        // Định dạng số khi nhập vào trường số lượng
        document.getElementById('editKhoSanPhamSoLuongConLai').addEventListener('input', function(e) {
            let val = e.target.value.replace(/[^\d]/g, '');
            e.target.value = formatNumberInput(val);
        });
    </script>
</body>
</html>
